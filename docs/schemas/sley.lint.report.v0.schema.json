{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sley.lint.report.v0",
  "title": "Sley Lint Report v0",
  "type": "object",
  "required": ["schema", "status", "entry_module", "filters", "findings"],
  "properties": {
    "schema": { "const": "sley.lint.report.v0" },
    "status": { "enum": ["ok", "findings"] },
    "entry_module": { "type": "string" },
    "filters": {
      "type": "object",
      "required": ["module", "rules"],
      "properties": {
        "module": { "type": ["string", "null"] },
        "rules": {
          "type": "array",
          "items": {
            "enum": ["unused_private_task", "unreachable_private_task"]
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "rule",
          "severity",
          "message",
          "node",
          "module",
          "hint"
        ],
        "properties": {
          "id": {
            "enum": ["UNUSED_PRIVATE_TASK", "UNREACHABLE_PRIVATE_TASK"]
          },
          "rule": {
            "enum": ["unused_private_task", "unreachable_private_task"]
          },
          "severity": { "enum": ["warning"] },
          "message": { "type": "string" },
          "node": { "type": "string" },
          "module": { "type": "string" },
          "hint": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

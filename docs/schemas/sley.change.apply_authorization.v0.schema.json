{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sley.change.apply_authorization.v0",
  "title": "Sley Change Apply Authorization v0",
  "type": "object",
  "required": [
    "schema", "status", "authorization_id", "authorization_digest",
    "transaction", "grant_ref", "principal", "audience", "repository",
    "base", "candidate", "source_scope", "internal_scopes", "atomicity",
    "verification", "metadata_policy", "mutation_authority", "mutations",
    "next_actions", "issues"
  ],
  "properties": {
    "schema": {"const": "sley.change.apply_authorization.v0"},
    "status": {"const": "ready"},
    "authorization_id": {"type": "string", "pattern": "^apply-authorization:[a-f0-9]{64}$"},
    "authorization_digest": {"$ref": "#/$defs/digest"},
    "transaction": {"$ref": "sley.change.grant.v0#/$defs/transaction"},
    "grant_ref": {"$ref": "#/$defs/grantRef"},
    "principal": {"$ref": "sley.change.grant.v0#/$defs/namedPrincipal"},
    "audience": {"$ref": "sley.change.grant.v0#/$defs/namedPrincipal"},
    "repository": {"$ref": "sley.change.plan.v0#/$defs/transaction/properties/repository"},
    "base": {"$ref": "sley.change.plan.v0#/$defs/transaction/properties/base"},
    "candidate": {"$ref": "sley.change.grant.v0#/$defs/candidate"},
    "source_scope": {"$ref": "sley.change.approval_request.v0#/$defs/resourceScope"},
    "internal_scopes": {
      "type": "array",
      "prefixItems": [
        {"$ref": "#/$defs/transactionStateScope"},
        {"$ref": "#/$defs/transactionLockScope"},
        {"$ref": "#/$defs/replayLedgerScope"},
        {"$ref": "#/$defs/recoveryJournalScope"},
        {"$ref": "#/$defs/revocationLedgerScope"}
      ],
      "items": false,
      "minItems": 5,
      "maxItems": 5
    },
    "atomicity": {"$ref": "#/$defs/atomicity"},
    "verification": {"$ref": "#/$defs/verification"},
    "metadata_policy": {"$ref": "#/$defs/metadataPolicy"},
    "mutation_authority": {"$ref": "#/$defs/mutationAuthority"},
    "mutations": {"$ref": "sley.change.plan.v0#/$defs/mutations"},
    "next_actions": {
      "type": "array",
      "prefixItems": [{"$ref": "#/$defs/action"}],
      "items": false,
      "minItems": 1,
      "maxItems": 1
    },
    "issues": {"type": "array", "maxItems": 0}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "safePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "grantRef": {
      "type": "object",
      "required": ["schema", "grant_id", "grant_digest", "request_id", "preview_digest", "transaction_id", "replay_key"],
      "properties": {
        "schema": {"const": "sley.change.grant.v0"},
        "grant_id": {"type": "string", "pattern": "^grant:[a-f0-9]{64}$"},
        "grant_digest": {"$ref": "#/$defs/digest"},
        "request_id": {"type": "string", "pattern": "^approval-request:[a-f0-9]{64}$"},
        "preview_digest": {"$ref": "#/$defs/digest"},
        "transaction_id": {"$ref": "#/$defs/digest"},
        "replay_key": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "internalScopeBase": {
      "type": "object",
      "required": ["kind", "path"],
      "properties": {"kind": {"type": "string"}, "path": {"$ref": "#/$defs/safePath"}},
      "additionalProperties": false
    },
    "transactionStateScope": {
      "allOf": [
        {"$ref": "#/$defs/internalScopeBase"},
        {"properties": {"kind": {"const": "transaction_state"}, "path": {"type": "string", "pattern": "^\\.sley/transactions/[a-f0-9]{64}$"}}}
      ]
    },
    "transactionLockScope": {
      "allOf": [
        {"$ref": "#/$defs/internalScopeBase"},
        {"properties": {"kind": {"const": "transaction_lock"}, "path": {"const": ".sley/locks/change-apply"}}}
      ]
    },
    "replayLedgerScope": {
      "allOf": [
        {"$ref": "#/$defs/internalScopeBase"},
        {"properties": {"kind": {"const": "replay_ledger"}, "path": {"type": "string", "pattern": "^\\.sley/replay/[a-f0-9]{64}$"}}}
      ]
    },
    "recoveryJournalScope": {
      "allOf": [
        {"$ref": "#/$defs/internalScopeBase"},
        {"properties": {"kind": {"const": "recovery_journal"}, "path": {"type": "string", "pattern": "^\\.sley/transactions/[a-f0-9]{64}/recovery$"}}}
      ]
    },
    "revocationLedgerScope": {
      "allOf": [
        {"$ref": "#/$defs/internalScopeBase"},
        {"properties": {"kind": {"const": "revocation_ledger"}, "path": {"type": "string", "pattern": "^\\.sley/revocations/[a-f0-9]{64}\\.json$"}}}
      ]
    },
    "atomicity": {
      "type": "object",
      "required": ["platform", "strategy", "topology", "rollback_strategy", "cancellation_point", "limitations"],
      "properties": {
        "platform": {"const": "linux"},
        "strategy": {"const": "renameat2_exchange"},
        "topology": {"const": "same_filesystem_common_root"},
        "rollback_strategy": {"const": "verified_exchange"},
        "cancellation_point": {"const": "before_commit_point"},
        "limitations": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["non_repo_root", "single_common_root", "no_symlinks", "no_special_files", "no_submodules", "same_filesystem"]}
        }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": ["profile", "required_checks", "rollback_on_failure"],
      "properties": {
        "profile": {"const": "compiler_apply_v0"},
        "required_checks": {
          "type": "array",
          "prefixItems": [
            {"const": "candidate_source_digest"},
            {"const": "candidate_graph_digest"},
            {"const": "compiler_check"},
            {"const": "compiler_lint"}
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "rollback_on_failure": {"const": true}
      },
      "additionalProperties": false
    },
    "metadataPolicy": {
      "type": "object",
      "required": ["mode", "ownership", "timestamps", "xattrs", "special_files", "submodules"],
      "properties": {
        "mode": {"const": "preserve"},
        "ownership": {"const": "preserve_current_owner"},
        "timestamps": {"const": "preserve_unchanged"},
        "xattrs": {"const": "reject_if_present"},
        "special_files": {"const": "reject"},
        "submodules": {"const": "reject"}
      },
      "additionalProperties": false
    },
    "mutationAuthority": {
      "type": "object",
      "required": ["repository_source", "internal_transaction_state", "git_index", "trace_sidecars", "external_systems", "provider_state"],
      "properties": {
        "repository_source": {"const": true},
        "internal_transaction_state": {"const": true},
        "git_index": {"const": false},
        "trace_sidecars": {"const": false},
        "external_systems": {"const": false},
        "provider_state": {"const": false}
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": ["kind", "reason", "command"],
      "properties": {
        "kind": {"const": "initialize_revocation_record"},
        "reason": {"type": "string", "minLength": 1},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sley.verify.report.v0",
  "title": "Sley Verify Report v0",
  "type": "object",
  "required": [
    "schema",
    "status",
    "target",
    "entry_module",
    "summary",
    "diagnostics",
    "runtime",
    "next_actions"
  ],
  "properties": {
    "schema": { "const": "sley.verify.report.v0" },
    "status": { "enum": ["passed", "warnings", "blocked"] },
    "target": { "type": "string", "minLength": 1 },
    "entry_module": { "type": ["string", "null"], "minLength": 1 },
    "summary": { "$ref": "#/$defs/summary" },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "sley.diagnostics.report.v0#/$defs/diagnostic" }
    },
    "query": { "$ref": "#/$defs/querySummary" },
    "lint": { "$ref": "#/$defs/lintSummary" },
    "runtime": { "$ref": "#/$defs/runtimeSummary" },
    "next_actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "summary": {
      "type": "object",
      "required": [
        "error_count",
        "warning_count",
        "module_count",
        "task_count",
        "call_count",
        "lint_finding_count",
        "runtime_status"
      ],
      "properties": {
        "error_count": { "type": "integer", "minimum": 0 },
        "warning_count": { "type": "integer", "minimum": 0 },
        "module_count": { "type": "integer", "minimum": 0 },
        "task_count": { "type": "integer", "minimum": 0 },
        "call_count": { "type": "integer", "minimum": 0 },
        "lint_finding_count": { "type": "integer", "minimum": 0 },
        "runtime_status": { "enum": ["passed", "failed", "skipped"] }
      },
      "additionalProperties": false
    },
    "querySummary": {
      "type": "object",
      "required": [
        "source_schema",
        "kind",
        "module_count",
        "task_count",
        "call_count"
      ],
      "properties": {
        "source_schema": { "const": "sley.query.report.v0" },
        "kind": { "enum": ["all"] },
        "module_count": { "type": "integer", "minimum": 0 },
        "task_count": { "type": "integer", "minimum": 0 },
        "call_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "lintSummary": {
      "type": "object",
      "required": [
        "source_schema",
        "status",
        "rules",
        "finding_count",
        "findings"
      ],
      "properties": {
        "source_schema": { "const": "sley.lint.report.v0" },
        "status": { "enum": ["ok", "findings"] },
        "rules": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "finding_count": { "type": "integer", "minimum": 0 },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/lintFinding" }
        }
      },
      "additionalProperties": false
    },
    "lintFinding": {
      "type": "object",
      "required": [
        "id",
        "rule",
        "severity",
        "message",
        "node",
        "module",
        "hint"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "rule": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "node": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "minLength": 1 },
        "hint": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "runtimeSummary": {
      "type": "object",
      "required": ["status", "diagnostics"],
      "properties": {
        "status": { "enum": ["passed", "failed", "skipped"] },
        "value": { "$ref": "sley.run.report.v0#/$defs/value" },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "sley.diagnostics.report.v0#/$defs/diagnostic" }
        }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": ["kind", "reason", "command"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "write_command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sley.symbol_graph.v0",
  "title": "Sley Symbol Graph v0",
  "type": "object",
  "required": ["schema", "entry_module", "modules"],
  "properties": {
    "schema": { "const": "sley.symbol_graph.v0" },
    "entry_module": { "type": "string" },
    "modules": { "type": "array", "items": { "$ref": "#/$defs/moduleSummary" } }
  },
  "$defs": {
    "moduleSummary": {
      "type": "object",
      "required": ["module", "imports", "types", "effects", "tasks"],
      "properties": {
        "module": { "type": "string" },
        "imports": { "type": "array", "items": { "$ref": "#/$defs/importSummary" } },
        "types": { "type": "array", "items": { "$ref": "#/$defs/declarationSummary" } },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/declarationSummary" } },
        "tasks": { "type": "array", "items": { "$ref": "#/$defs/declarationSummary" } }
      },
      "additionalProperties": false
    },
    "importSummary": {
      "type": "object",
      "required": ["id", "module"],
      "properties": {
        "id": { "type": "string" },
        "module": { "type": "string" },
        "alias": { "type": "string" }
      },
      "additionalProperties": false
    },
    "declarationSummary": {
      "type": "object",
      "required": ["name", "id", "exported"],
      "properties": {
        "name": { "type": "string" },
        "id": { "type": "string" },
        "exported": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

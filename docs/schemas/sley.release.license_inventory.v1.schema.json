{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sley.release.license_inventory.v1",
  "title": "Sley Release License Inventory v1",
  "type": "object",
  "required": ["schema", "status", "release", "artifact_id", "source_commit", "project_license", "bundled_components", "runtime_dependencies", "authority"],
  "properties": {
    "schema": {"const": "sley.release.license_inventory.v1"},
    "status": {"const": "complete"},
    "release": {"const": "1.2.0"},
    "artifact_id": {"const": "sley-1.2.0-linux-x86_64"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "project_license": {
      "type": "object",
      "required": ["expression", "path", "digest"],
      "properties": {
        "expression": {"const": "Apache-2.0"},
        "path": {"const": "LICENSE"},
        "digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "bundled_components": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["name", "version", "path", "license_expression", "bundled"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"const": "1.2.0"},
          "path": {"type": "string", "minLength": 1},
          "license_expression": {"const": "Apache-2.0"},
          "bundled": {"const": true}
        },
        "additionalProperties": false
      }
    },
    "runtime_dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "minimum_version", "bundled", "license_review_scope"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "minimum_version": {"type": "string", "minLength": 1},
          "bundled": {"const": false},
          "license_review_scope": {"const": "host_tool_not_redistributed"}
        },
        "additionalProperties": false
      }
    },
    "authority": {
      "type": "object",
      "required": ["publication_authorized", "third_party_binaries_bundled"],
      "properties": {
        "publication_authorized": {"const": false},
        "third_party_binaries_bundled": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}

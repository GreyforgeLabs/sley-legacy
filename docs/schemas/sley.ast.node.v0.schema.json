{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sley.ast.node.v0",
  "title": "Sley AST Node Report v0",
  "type": "object",
  "required": ["schema", "target", "id", "node_kind", "module", "value"],
  "properties": {
    "schema": { "const": "sley.ast.node.v0" },
    "target": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "minLength": 1 },
    "node_kind": {
      "enum": [
        "program",
        "import",
        "type",
        "effect",
        "task",
        "take",
        "block",
        "statement",
        "expression"
      ]
    },
    "module": { "type": "string", "minLength": 1 },
    "parent": { "type": "string", "minLength": 1 },
    "value": true
  },
  "additionalProperties": false
}

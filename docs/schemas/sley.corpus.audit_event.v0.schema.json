{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sley.corpus.audit_event.v0",
  "title": "Sley Corpus Audit Event v0",
  "type": "object",
  "required": [
    "schema", "log_id", "sequence", "previous_event_digest", "event_digest",
    "event_id", "kind", "occurred_at", "actor", "approval_ref", "subject",
    "transition", "reason_code", "evidence_digests"
  ],
  "properties": {
    "schema": { "const": "sley.corpus.audit_event.v0" },
    "log_id": { "$ref": "#/$defs/id" },
    "sequence": { "type": "integer", "minimum": 1 },
    "previous_event_digest": {
      "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
    },
    "event_digest": { "$ref": "#/$defs/digest" },
    "event_id": { "$ref": "#/$defs/id" },
    "kind": { "$ref": "#/$defs/eventKind" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "actor": { "$ref": "#/$defs/id" },
    "approval_ref": { "$ref": "#/$defs/id" },
    "subject": { "$ref": "#/$defs/subject" },
    "transition": { "$ref": "#/$defs/transition" },
    "reason_code": { "$ref": "#/$defs/id" },
    "evidence_digests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/digest" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "eventKind": {
      "enum": ["admission", "reclassification", "export", "release", "quarantine", "deletion"]
    },
    "state": {
      "enum": [
        "absent", "candidate", "quarantine", "admitted", "train",
        "development", "evaluation_public", "evaluation_private",
        "export_eligible", "exported", "released", "revoked", "deleted",
        "tombstoned", "rejected"
      ]
    },
    "subject": {
      "type": "object",
      "required": ["kind", "id", "digests"],
      "properties": {
        "kind": { "enum": ["record", "lineage", "release", "export"] },
        "id": { "$ref": "#/$defs/id" },
        "digests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/digest" }
        }
      },
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "anyOf": [{ "$ref": "#/$defs/state" }, { "type": "null" }] },
        "to": { "$ref": "#/$defs/state" }
      },
      "additionalProperties": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sley.agent_bench.run_manifest.v0",
  "title": "Sley Agent Bench Run Manifest v0",
  "type": "object",
  "required": [
    "schema", "run_id", "suite_id", "case_manifest_path",
    "case_manifest_digest", "mode", "adapter", "bootstrap",
    "tool_allowlist", "retain_workspaces"
  ],
  "properties": {
    "schema": { "const": "sley.agent_bench.run_manifest.v0" },
    "run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "suite_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "case_manifest_path": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
    "case_manifest_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "mode": { "enum": ["K0", "K1", "K2", "K3", "K4"] },
    "adapter": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "id", "trusted_fixtures_only"],
          "properties": {
            "kind": { "const": "deterministic_fixture" },
            "id": { "const": "deterministic-fixture-v0" },
            "trusted_fixtures_only": { "const": true }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind", "id", "provider", "model", "transport", "thinking",
            "model_measurement_applicable", "incremental_spend_ceiling_usd",
            "pricing", "data_policy"
          ],
          "properties": {
            "kind": { "const": "openclaw_one_shot" },
            "id": { "enum": ["openclaw-one-shot-v0", "openclaw-one-shot-v1", "openclaw-one-shot-v2"] },
            "provider": { "const": "openai" },
            "model": { "type": "string", "pattern": "^gpt-[A-Za-z0-9._-]+$" },
            "transport": { "const": "local" },
            "thinking": { "enum": ["low", "medium", "high"] },
            "model_measurement_applicable": { "const": true },
            "incremental_spend_ceiling_usd": { "type": "number", "exclusiveMinimum": 0, "maximum": 20 },
            "pricing": {
              "type": "object",
              "required": ["input_per_million_usd", "output_per_million_usd", "basis"],
              "properties": {
                "input_per_million_usd": { "type": "number", "minimum": 0 },
                "output_per_million_usd": { "type": "number", "minimum": 0 },
                "basis": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            },
            "data_policy": {
              "type": "object",
              "required": [
                "provider_training_authorized", "persistent_provider_thread",
                "local_session_persistence", "minimum_retention"
              ],
              "properties": {
                "provider_training_authorized": { "const": false },
                "persistent_provider_thread": { "const": false },
                "local_session_persistence": { "const": false },
                "minimum_retention": { "const": true }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "bootstrap": {
      "type": "object",
      "required": ["path", "digest"],
      "properties": {
        "path": { "const": "SLEY_AI.md" },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "tool_allowlist": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["ast", "check", "graph", "lint", "plan", "query", "run", "verify"]
      }
    },
    "system_prompt": {
      "type": "object",
      "required": ["digest"],
      "properties": {
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "retrieval": {
      "type": "object",
      "required": ["paths", "digest"],
      "properties": {
        "paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" }
        },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "retain_workspaces": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "adapter": { "properties": { "kind": { "const": "openclaw_one_shot" } }, "required": ["kind"] } },
        "required": ["adapter"]
      },
      "then": { "required": ["system_prompt", "retrieval"] }
    }
  ],
  "additionalProperties": false
}

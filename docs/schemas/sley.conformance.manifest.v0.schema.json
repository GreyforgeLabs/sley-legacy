{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sley.conformance.manifest.v0",
  "title": "Sley Conformance Manifest v0",
  "type": "object",
  "required": ["schema", "accepted", "rejected"],
  "properties": {
    "schema": { "const": "sley.conformance.manifest.v0" },
    "accepted": {
      "type": "array",
      "items": { "$ref": "#/$defs/case" }
    },
    "rejected": {
      "type": "array",
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["path", "covers"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "covers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

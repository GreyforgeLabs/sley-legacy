{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sley.change.review.v0",
  "title": "Sley Change Review Packet v0",
  "type": "object",
  "required": [
    "schema", "status", "review_id", "review_digest", "transaction",
    "terminal_outcome", "repository", "base", "final", "artifact_refs",
    "identity_chain", "validation_summary", "test_summary", "trace_summary",
    "authority_summary", "adapter_summary", "mutation_summary",
    "no_mutation_boundary", "outputs", "next_actions", "issues"
  ],
  "properties": {
    "schema": {"const": "sley.change.review.v0"},
    "status": {"const": "ready"},
    "review_id": {"type": "string", "pattern": "^review:[a-f0-9]{64}$"},
    "review_digest": {"$ref": "#/$defs/digest"},
    "transaction": {"$ref": "sley.change.recovery.v0#/$defs/transaction"},
    "terminal_outcome": {"enum": ["verified_apply", "verified_rollback"]},
    "repository": {"$ref": "sley.change.plan.v0#/$defs/transaction/properties/repository"},
    "base": {"$ref": "sley.change.plan.v0#/$defs/transaction/properties/base"},
    "final": {"$ref": "#/$defs/final"},
    "artifact_refs": {
      "type": "array", "minItems": 7, "maxItems": 8,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/artifactRef"},
      "allOf": [
        {"contains": {"properties": {"kind": {"const": "preview"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"kind": {"const": "approval_request"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"kind": {"const": "grant"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"kind": {"const": "apply_authorization"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"kind": {"const": "apply"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"kind": {"const": "recovery"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"kind": {"const": "zjx_evidence"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"kind": {"const": "rollback"}}, "required": ["kind"]}, "minContains": 0, "maxContains": 1}
      ]
    },
    "identity_chain": {
      "type": "array", "minItems": 6, "maxItems": 7, "uniqueItems": true,
      "items": {"$ref": "#/$defs/identityRef"},
      "allOf": [
        {"contains": {"properties": {"kind": {"const": "transaction"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"kind": {"const": "candidate"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"kind": {"const": "approval_request"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"kind": {"const": "grant"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"kind": {"const": "apply_authorization"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"kind": {"const": "recovery"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"kind": {"const": "rollback"}}, "required": ["kind"]}, "minContains": 0, "maxContains": 1}
      ]
    },
    "validation_summary": {"$ref": "#/$defs/validationSummary"},
    "test_summary": {"$ref": "#/$defs/testSummary"},
    "trace_summary": {"$ref": "#/$defs/traceSummary"},
    "authority_summary": {"$ref": "#/$defs/authoritySummary"},
    "adapter_summary": {
      "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
      "items": {"$ref": "#/$defs/adapter"},
      "allOf": [
        {"contains": {"properties": {"kind": {"const": "compiler"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"kind": {"const": "evidence_envelope"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1}
      ]
    },
    "mutation_summary": {"$ref": "#/$defs/mutationSummary"},
    "no_mutation_boundary": {"$ref": "#/$defs/noMutationBoundary"},
    "outputs": {"$ref": "#/$defs/outputs"},
    "next_actions": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {"$ref": "#/$defs/action"}
    },
    "issues": {"type": "array", "maxItems": 8, "items": {"$ref": "sley.change.recovery.v0#/$defs/issue"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "safePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "final": {
      "type": "object",
      "required": ["state", "source_digest", "graph_digest"],
      "properties": {
        "state": {"enum": ["candidate", "restored_base"]},
        "source_digest": {"$ref": "#/$defs/digest"},
        "graph_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "artifactRef": {
      "type": "object",
      "required": ["kind", "schema", "locator", "digest"],
      "properties": {
        "kind": {"enum": ["preview", "approval_request", "grant", "apply_authorization", "apply", "rollback", "recovery", "zjx_evidence"]},
        "schema": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "pattern": "^(input:[a-z_]+|\\.sley/transactions/[a-f0-9]{64}/.+)$"},
        "digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "identityRef": {
      "type": "object",
      "required": ["kind", "id", "digest"],
      "properties": {
        "kind": {"enum": ["transaction", "candidate", "approval_request", "grant", "apply_authorization", "recovery", "rollback"]},
        "id": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "validationSummary": {
      "type": "object",
      "required": ["profile", "status", "checks", "rollback"],
      "properties": {
        "profile": {"const": "compiler_apply_v0"},
        "status": {"enum": ["passed", "failed"]},
        "checks": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "sley.change.recovery.v0#/$defs/check"}},
        "rollback": {"$ref": "sley.change.recovery.v0#/$defs/rollback"}
      },
      "additionalProperties": false
    },
    "testSummary": {
      "type": "object",
      "required": ["profile", "status", "tests"],
      "properties": {
        "profile": {"const": "compiler_preview_v0"},
        "status": {"const": "passed"},
        "tests": {"type": "array", "minItems": 1, "items": {"$ref": "sley.change.preview.v0#/$defs/testResult"}}
      },
      "additionalProperties": false
    },
    "traceSummary": {
      "type": "object",
      "required": ["schema", "seal_digest", "trace_digest", "receipt_count"],
      "properties": {
        "schema": {"const": "sley.trace.seal.v0"},
        "seal_digest": {"$ref": "#/$defs/digest"},
        "trace_digest": {"$ref": "#/$defs/digest"},
        "receipt_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "authoritySummary": {
      "type": "object",
      "required": ["issuer", "principal", "audience", "purpose", "grant_state_at_apply", "revocation_state_at_apply", "replay_state"],
      "properties": {
        "issuer": {"type": "string", "minLength": 1, "maxLength": 256},
        "principal": {"type": "string", "minLength": 1, "maxLength": 256},
        "audience": {"type": "string", "minLength": 1, "maxLength": 256},
        "purpose": {"type": "string", "maxLength": 4096},
        "grant_state_at_apply": {"const": "approved"},
        "revocation_state_at_apply": {"const": "not_revoked"},
        "replay_state": {"const": "consumed"}
      },
      "additionalProperties": false
    },
    "adapter": {
      "type": "object",
      "required": ["kind", "name", "version", "network_used"],
      "properties": {
        "kind": {"enum": ["compiler", "evidence_envelope"]},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "network_used": {"const": false}
      },
      "additionalProperties": false
    },
    "mutationSummary": {
      "type": "object",
      "required": ["attempted_change", "repository_source_changed", "rollback_performed", "review_artifacts_written"],
      "properties": {
        "attempted_change": {"const": true},
        "repository_source_changed": {"const": true},
        "rollback_performed": {"type": "boolean"},
        "review_artifacts_written": {"const": true}
      },
      "additionalProperties": false
    },
    "noMutationBoundary": {
      "type": "object",
      "required": ["repository_source", "git_index", "trace_sidecars", "external_systems", "provider_state"],
      "properties": {
        "repository_source": {"const": false},
        "git_index": {"const": false},
        "trace_sidecars": {"const": false},
        "external_systems": {"const": false},
        "provider_state": {"const": false}
      },
      "additionalProperties": false
    },
    "outputs": {
      "type": "object",
      "required": ["packet", "bundle", "zjx_evidence", "seal"],
      "properties": {
        "packet": {"type": "string", "pattern": "^\\.sley/transactions/[a-f0-9]{64}/review/packet\\.md$"},
        "bundle": {"type": "string", "pattern": "^\\.sley/transactions/[a-f0-9]{64}/review/bundle\\.json$"},
        "zjx_evidence": {"type": "string", "pattern": "^\\.sley/transactions/[a-f0-9]{64}/review/evidence\\.zjx\\.json$"},
        "seal": {"type": "string", "pattern": "^\\.sley/transactions/[a-f0-9]{64}/review/seal\\.json$"}
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": ["kind", "reason"],
      "properties": {
        "kind": {"const": "inspect_transaction_seal"},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"terminal_outcome": {"const": "verified_apply"}}},
      "then": {
        "properties": {
          "final": {"properties": {"state": {"const": "candidate"}}},
          "validation_summary": {"properties": {"status": {"const": "passed"}, "rollback": {"properties": {"status": {"const": "not_required"}}}}},
          "mutation_summary": {"properties": {"rollback_performed": {"const": false}}},
          "issues": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"terminal_outcome": {"const": "verified_rollback"}}},
      "then": {
        "properties": {
          "final": {"properties": {"state": {"const": "restored_base"}}},
          "validation_summary": {"properties": {"rollback": {"properties": {"status": {"const": "passed"}}}}},
          "mutation_summary": {"properties": {"rollback_performed": {"const": true}}}
        }
      }
    }
  ],
  "additionalProperties": false
}

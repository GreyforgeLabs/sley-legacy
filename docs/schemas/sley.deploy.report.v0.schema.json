{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sley.deploy.report.v0",
  "title": "Sley Deploy Dry-Run Report v0",
  "type": "object",
  "required": [
    "schema",
    "status",
    "mode",
    "target",
    "environment",
    "policy",
    "summary",
    "verify",
    "next_actions"
  ],
  "properties": {
    "schema": { "const": "sley.deploy.report.v0" },
    "status": { "enum": ["ready", "blocked"] },
    "mode": { "const": "dry_run" },
    "target": { "type": "string", "minLength": 1 },
    "environment": { "type": "string", "minLength": 1 },
    "policy": { "$ref": "#/$defs/policy" },
    "summary": { "$ref": "#/$defs/summary" },
    "verify": { "$ref": "sley.verify.report.v0" },
    "seal": { "$ref": "sley.trace.seal.v0" },
    "package": { "$ref": "#/$defs/package" },
    "artifacts": { "$ref": "#/$defs/artifacts" },
    "next_actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "policy": {
      "type": "object",
      "required": [
        "live_deploy_allowed",
        "external_mutations",
        "provider_calls",
        "requires_operator_approval"
      ],
      "properties": {
        "live_deploy_allowed": { "const": false },
        "external_mutations": { "const": false },
        "provider_calls": { "const": false },
        "requires_operator_approval": { "const": true }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "verify_status",
        "seal_status",
        "package_status",
        "module_count",
        "task_count",
        "receipt_count"
      ],
      "properties": {
        "verify_status": { "enum": ["passed", "warnings", "blocked"] },
        "seal_status": { "enum": ["passed", "skipped"] },
        "package_status": { "enum": ["passed", "skipped"] },
        "module_count": { "type": "integer", "minimum": 0 },
        "task_count": { "type": "integer", "minimum": 0 },
        "receipt_count": { "type": "integer", "minimum": 0 },
        "seal_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "graph_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "package": {
      "type": "object",
      "required": [
        "source_schema",
        "format",
        "compression",
        "target",
        "graph_digest",
        "module_count",
        "trace_receipt_count"
      ],
      "properties": {
        "source_schema": { "const": "sley.zjx.envelope.v0" },
        "format": { "const": "zjx-preview-json" },
        "compression": { "const": "none" },
        "target": { "type": "string", "minLength": 1 },
        "graph_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "module_count": { "type": "integer", "minimum": 0 },
        "trace_receipt_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "required": ["directory", "report", "seal", "package", "manifest"],
      "properties": {
        "directory": { "type": "string", "minLength": 1 },
        "report": { "type": "string", "minLength": 1 },
        "seal": { "type": "string", "minLength": 1 },
        "package": { "type": "string", "minLength": 1 },
        "manifest": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": ["kind", "reason", "command"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    }
  }
}

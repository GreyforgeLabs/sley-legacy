{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sley.contract.fixture_check.v0",
  "title": "Sley Contract Fixture Check Report v0",
  "type": "object",
  "required": [
    "schema",
    "status",
    "validation_level",
    "schema_dir",
    "fixtures_dir",
    "fixture_count",
    "passed_count",
    "failed_count",
    "fixtures"
  ],
  "properties": {
    "schema": { "const": "sley.contract.fixture_check.v0" },
    "status": { "enum": ["passed", "failed"] },
    "validation_level": { "enum": ["json_schema_draft_2020_12"] },
    "schema_dir": { "type": "string", "minLength": 1 },
    "fixtures_dir": { "type": "string", "minLength": 1 },
    "fixture_count": { "type": "integer", "minimum": 0 },
    "passed_count": { "type": "integer", "minimum": 0 },
    "failed_count": { "type": "integer", "minimum": 0 },
    "fixtures": {
      "type": "array",
      "items": { "$ref": "#/$defs/fixtureCheck" }
    }
  },
  "$defs": {
    "fixtureCheck": {
      "type": "object",
      "required": ["path", "status", "issues"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed"] },
        "schema_id": { "type": "string", "minLength": 1 },
        "issues": {
          "type": "array",
          "items": { "$ref": "#/$defs/contractIssue" }
        }
      },
      "additionalProperties": false
    },
    "contractIssue": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sley.query.report.v0",
  "title": "Sley Query Report v0",
  "type": "object",
  "required": [
    "schema",
    "kind",
    "entry_module",
    "filters",
    "modules",
    "tasks",
    "calls"
  ],
  "properties": {
    "schema": { "const": "sley.query.report.v0" },
    "kind": { "enum": ["all", "modules", "tasks", "calls"] },
    "entry_module": { "type": "string" },
    "filters": {
      "type": "object",
      "required": ["module", "exported_only"],
      "properties": {
        "module": { "type": ["string", "null"] },
        "exported_only": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "modules": { "type": "array", "items": { "$ref": "#/$defs/moduleSummary" } },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "module",
          "qualified_name",
          "exported",
          "takes",
          "return_type",
          "effects",
          "outbound_call_count",
          "inbound_call_count"
        ],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "module": { "type": "string" },
          "qualified_name": { "type": "string" },
          "exported": { "type": "boolean" },
          "takes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "binding_kind", "type"],
              "properties": {
                "name": { "type": "string" },
                "binding_kind": { "type": "string" },
                "type": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "return_type": { "type": "string" },
          "effects": { "type": "array", "items": { "type": "string" } },
          "outbound_call_count": { "type": "integer", "minimum": 0 },
          "inbound_call_count": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "calls": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "moduleSummary": {
      "type": "object",
      "required": ["module", "imports", "types", "effects", "tasks"],
      "properties": {
        "module": { "type": "string" },
        "imports": { "type": "array", "items": { "$ref": "#/$defs/importSummary" } },
        "types": { "type": "array", "items": { "$ref": "#/$defs/declarationSummary" } },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/declarationSummary" } },
        "tasks": { "type": "array", "items": { "$ref": "#/$defs/declarationSummary" } }
      },
      "additionalProperties": false
    },
    "importSummary": {
      "type": "object",
      "required": ["id", "module"],
      "properties": {
        "id": { "type": "string" },
        "module": { "type": "string" },
        "alias": { "type": "string" }
      },
      "additionalProperties": false
    },
    "declarationSummary": {
      "type": "object",
      "required": ["name", "id", "exported"],
      "properties": {
        "name": { "type": "string" },
        "id": { "type": "string" },
        "exported": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

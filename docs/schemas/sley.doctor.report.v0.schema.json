{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sley.doctor.report.v0",
  "title": "Sley Doctor Report v0",
  "type": "object",
  "required": [
    "schema",
    "status",
    "target",
    "entry_module",
    "summary",
    "diagnostics",
    "next_actions"
  ],
  "properties": {
    "schema": { "const": "sley.doctor.report.v0" },
    "status": { "enum": ["ready", "warnings", "blocked"] },
    "target": { "type": "string", "minLength": 1 },
    "entry_module": { "type": ["string", "null"] },
    "summary": { "$ref": "#/$defs/summary" },
    "diagnostics": {
      "type": "array",
      "items": { "type": "object" }
    },
    "query": { "$ref": "#/$defs/querySummary" },
    "lint": { "$ref": "#/$defs/lintSummary" },
    "next_actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "summary": {
      "type": "object",
      "required": [
        "error_count",
        "warning_count",
        "module_count",
        "task_count",
        "call_count",
        "lint_finding_count"
      ],
      "properties": {
        "error_count": { "type": "integer", "minimum": 0 },
        "warning_count": { "type": "integer", "minimum": 0 },
        "module_count": { "type": "integer", "minimum": 0 },
        "task_count": { "type": "integer", "minimum": 0 },
        "call_count": { "type": "integer", "minimum": 0 },
        "lint_finding_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "querySummary": {
      "type": "object",
      "required": [
        "source_schema",
        "kind",
        "module_count",
        "task_count",
        "call_count",
        "entrypoints",
        "effectful_tasks"
      ],
      "properties": {
        "source_schema": { "const": "sley.query.report.v0" },
        "kind": { "enum": ["all"] },
        "module_count": { "type": "integer", "minimum": 0 },
        "task_count": { "type": "integer", "minimum": 0 },
        "call_count": { "type": "integer", "minimum": 0 },
        "entrypoints": {
          "type": "array",
          "items": { "type": "string" }
        },
        "effectful_tasks": {
          "type": "array",
          "items": { "$ref": "#/$defs/taskRef" }
        }
      },
      "additionalProperties": false
    },
    "taskRef": {
      "type": "object",
      "required": ["id", "qualified_name", "effects"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "qualified_name": { "type": "string", "minLength": 1 },
        "effects": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "lintSummary": {
      "type": "object",
      "required": ["source_schema", "status", "rules", "finding_count"],
      "properties": {
        "source_schema": { "const": "sley.lint.report.v0" },
        "status": { "enum": ["ok", "findings"] },
        "rules": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "finding_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": ["kind", "reason", "command"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  }
}

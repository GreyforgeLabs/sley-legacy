{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sley.conformance.report.v0",
  "title": "Sley Conformance Report v0",
  "type": "object",
  "required": [
    "schema",
    "status",
    "summary",
    "validation",
    "schemas",
    "corpus",
    "smoke",
    "onboarding",
    "examples",
    "tests",
    "editor_shims",
    "v1_gate",
    "readiness",
    "release",
    "issues"
  ],
  "properties": {
    "schema": { "const": "sley.conformance.report.v0" },
    "status": { "enum": ["passed", "failed"] },
    "summary": { "$ref": "#/$defs/summary" },
    "validation": { "$ref": "#/$defs/validation" },
    "schemas": { "$ref": "#/$defs/schemaSection" },
    "corpus": { "$ref": "#/$defs/corpus" },
    "smoke": { "$ref": "#/$defs/smoke" },
    "onboarding": { "$ref": "#/$defs/onboarding" },
    "examples": { "$ref": "#/$defs/examples" },
    "tests": { "$ref": "#/$defs/tests" },
    "editor_shims": { "$ref": "#/$defs/editorShims" },
    "v1_gate": { "$ref": "#/$defs/v1Gate" },
    "readiness": { "$ref": "#/$defs/readiness" },
    "release": { "$ref": "#/$defs/release" },
    "issues": {
      "type": "array",
      "items": { "$ref": "#/$defs/issue" }
    }
  },
  "$defs": {
    "summary": {
      "type": "object",
      "required": [
        "schema_count",
        "schema_instance_count",
        "schema_without_instance_count",
        "contract_fixture_count",
        "contract_fixture_failed_count",
        "corpus_accepted_count",
        "corpus_rejected_count",
        "smoke_case_count",
        "onboarding_path_count",
        "missing_onboarding_path_count",
        "example_project_count",
        "example_source_count",
        "integration_test_count",
        "declared_integration_test_count",
        "test_count_matches_declared",
        "editor_shim_count",
        "v1_gate_target_count",
        "missing_v1_gate_target_count",
        "public_release_blocker_count",
        "issue_count"
      ],
      "properties": {
        "schema_count": { "type": "integer", "minimum": 0 },
        "schema_instance_count": { "type": "integer", "minimum": 0 },
        "schema_without_instance_count": { "type": "integer", "minimum": 0 },
        "contract_fixture_count": { "type": "integer", "minimum": 0 },
        "contract_fixture_failed_count": { "type": "integer", "minimum": 0 },
        "corpus_accepted_count": { "type": "integer", "minimum": 0 },
        "corpus_rejected_count": { "type": "integer", "minimum": 0 },
        "smoke_case_count": { "type": "integer", "minimum": 0 },
        "onboarding_path_count": { "type": "integer", "minimum": 0 },
        "missing_onboarding_path_count": { "type": "integer", "minimum": 0 },
        "example_project_count": { "type": "integer", "minimum": 0 },
        "example_source_count": { "type": "integer", "minimum": 0 },
        "integration_test_count": { "type": "integer", "minimum": 0 },
        "declared_integration_test_count": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "test_count_matches_declared": { "type": "boolean" },
        "editor_shim_count": { "type": "integer", "minimum": 0 },
        "v1_gate_target_count": { "type": "integer", "minimum": 0 },
        "missing_v1_gate_target_count": { "type": "integer", "minimum": 0 },
        "public_release_blocker_count": { "type": "integer", "minimum": 0 },
        "issue_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": ["contract_fixtures", "manifests"],
      "properties": {
        "contract_fixtures": { "$ref": "#/$defs/validationRun" },
        "manifests": {
          "type": "array",
          "items": { "$ref": "#/$defs/validationRun" }
        }
      },
      "additionalProperties": false
    },
    "validationRun": {
      "type": "object",
      "required": ["name", "status", "command", "issue_count", "issues"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed"] },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "report_schema": { "type": "string", "minLength": 1 },
        "fixture_count": { "type": "integer", "minimum": 0 },
        "passed_count": { "type": "integer", "minimum": 0 },
        "failed_count": { "type": "integer", "minimum": 0 },
        "issue_count": { "type": "integer", "minimum": 0 },
        "issues": {
          "type": "array",
          "items": { "$ref": "#/$defs/issue" }
        }
      },
      "additionalProperties": false
    },
    "schemaSection": {
      "type": "object",
      "required": [
        "schema_dir",
        "fixture_dir",
        "schemas",
        "instances",
        "schemas_without_instances",
        "unknown_instance_schemas"
      ],
      "properties": {
        "schema_dir": { "type": "string", "minLength": 1 },
        "fixture_dir": { "type": "string", "minLength": 1 },
        "schemas": {
          "type": "array",
          "items": { "$ref": "#/$defs/schemaInfo" }
        },
        "instances": {
          "type": "array",
          "items": { "$ref": "#/$defs/schemaInstance" }
        },
        "schemas_without_instances": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "unknown_instance_schemas": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "schemaInfo": {
      "type": "object",
      "required": ["id", "path"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "schemaInstance": {
      "type": "object",
      "required": ["schema_id", "count"],
      "properties": {
        "schema_id": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "corpus": {
      "type": "object",
      "required": [
        "manifest",
        "accepted_count",
        "rejected_count",
        "tag_inventory",
        "feature_counts",
        "required_tags",
        "missing_required_tags"
      ],
      "properties": {
        "manifest": { "type": "string", "minLength": 1 },
        "accepted_count": { "type": "integer", "minimum": 0 },
        "rejected_count": { "type": "integer", "minimum": 0 },
        "tag_inventory": {
          "type": "array",
          "items": { "$ref": "#/$defs/tagCount" }
        },
        "feature_counts": {
          "type": "array",
          "items": { "$ref": "#/$defs/tagCount" }
        },
        "required_tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "missing_required_tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "smoke": {
      "type": "object",
      "required": [
        "manifests",
        "case_count",
        "tag_inventory",
        "required_tags",
        "missing_required_tags"
      ],
      "properties": {
        "manifests": {
          "type": "array",
          "items": { "$ref": "#/$defs/smokeManifest" }
        },
        "case_count": { "type": "integer", "minimum": 0 },
        "tag_inventory": {
          "type": "array",
          "items": { "$ref": "#/$defs/tagCount" }
        },
        "required_tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "missing_required_tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "smokeManifest": {
      "type": "object",
      "required": ["path", "case_count"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "case_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "onboarding": {
      "type": "object",
      "required": [
        "required_paths",
        "missing_required_paths",
        "issue_count",
        "issues"
      ],
      "properties": {
        "required_paths": {
          "type": "array",
          "items": { "$ref": "#/$defs/onboardingPath" }
        },
        "missing_required_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "issue_count": { "type": "integer", "minimum": 0 },
        "issues": {
          "type": "array",
          "items": { "$ref": "#/$defs/issue" }
        }
      },
      "additionalProperties": false
    },
    "onboardingPath": {
      "type": "object",
      "required": [
        "path",
        "kind",
        "present",
        "byte_count",
        "line_count",
        "entry_count"
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["file", "directory", "missing"] },
        "present": { "type": "boolean" },
        "byte_count": { "type": "integer", "minimum": 0 },
        "line_count": { "type": "integer", "minimum": 0 },
        "entry_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "examples": {
      "type": "object",
      "required": ["root", "project_count", "source_count"],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "project_count": { "type": "integer", "minimum": 0 },
        "source_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "tests": {
      "type": "object",
      "required": [
        "integration_test_file",
        "integration_test_count",
        "goal_doc",
        "declared_integration_test_count",
        "declared_matches_actual"
      ],
      "properties": {
        "integration_test_file": { "type": "string", "minLength": 1 },
        "integration_test_count": { "type": "integer", "minimum": 0 },
        "goal_doc": { "type": "string", "minLength": 1 },
        "declared_integration_test_count": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "declared_matches_actual": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "editorShims": {
      "type": "object",
      "required": [
        "root",
        "package_count",
        "packages",
        "validation",
        "issue_count",
        "issues"
      ],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "package_count": { "type": "integer", "minimum": 0 },
        "packages": {
          "type": "array",
          "items": { "$ref": "#/$defs/editorShimPackage" }
        },
        "validation": { "$ref": "#/$defs/validationRun" },
        "issue_count": { "type": "integer", "minimum": 0 },
        "issues": {
          "type": "array",
          "items": { "$ref": "#/$defs/issue" }
        }
      },
      "additionalProperties": false
    },
    "editorShimPackage": {
      "type": "object",
      "required": [
        "path",
        "name",
        "display_name",
        "version",
        "private",
        "language_ids",
        "grammar_count",
        "command_count",
        "dependency_count"
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "name": { "type": ["string", "null"], "minLength": 1 },
        "display_name": { "type": ["string", "null"], "minLength": 1 },
        "version": { "type": ["string", "null"], "minLength": 1 },
        "private": { "type": ["boolean", "null"] },
        "language_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "grammar_count": { "type": "integer", "minimum": 0 },
        "command_count": { "type": "integer", "minimum": 0 },
        "dependency_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "v1Gate": {
      "type": "object",
      "required": [
        "makefile",
        "target",
        "required_targets",
        "actual_targets",
        "missing_required_targets",
        "undefined_targets",
        "issue_count",
        "issues"
      ],
      "properties": {
        "makefile": { "type": "string", "minLength": 1 },
        "target": { "const": "v1" },
        "required_targets": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "actual_targets": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "missing_required_targets": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "undefined_targets": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "issue_count": { "type": "integer", "minimum": 0 },
        "issues": {
          "type": "array",
          "items": { "$ref": "#/$defs/issue" }
        }
      },
      "additionalProperties": false
    },
    "readiness": {
      "type": "object",
      "required": ["local_v1", "public_v1"],
      "properties": {
        "local_v1": { "$ref": "#/$defs/readinessTrack" },
        "public_v1": { "$ref": "#/$defs/readinessTrack" }
      },
      "additionalProperties": false
    },
    "readinessTrack": {
      "type": "object",
      "required": [
        "status",
        "ready",
        "command",
        "gate_completion_percent",
        "passed_check_count",
        "total_check_count",
        "blocker_count",
        "blockers"
      ],
      "properties": {
        "status": { "enum": ["ready", "blocked"] },
        "ready": { "type": "boolean" },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "gate_completion_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "passed_check_count": { "type": "integer", "minimum": 0 },
        "total_check_count": { "type": "integer", "minimum": 0 },
        "blocker_count": { "type": "integer", "minimum": 0 },
        "blockers": {
          "type": "array",
          "items": { "$ref": "#/$defs/issue" }
        }
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "required": [
        "public_release_ready",
        "blocker_count",
        "blockers",
        "next_actions",
        "cargo_package",
        "tree_sitter_package",
        "license"
      ],
      "properties": {
        "public_release_ready": { "type": "boolean" },
        "blocker_count": { "type": "integer", "minimum": 0 },
        "blockers": {
          "type": "array",
          "items": { "$ref": "#/$defs/issue" }
        },
        "next_actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/releaseAction" }
        },
        "cargo_package": { "$ref": "#/$defs/cargoPackage" },
        "tree_sitter_package": { "$ref": "#/$defs/treeSitterPackage" },
        "license": { "$ref": "#/$defs/license" }
      },
      "additionalProperties": false
    },
    "releaseAction": {
      "type": "object",
      "required": [
        "blocker_code",
        "owner",
        "approval_required",
        "action",
        "paths"
      ],
      "properties": {
        "blocker_code": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "approval_required": { "type": "boolean" },
        "action": { "type": "string", "minLength": 1 },
        "paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "cargoPackage": {
      "type": "object",
      "required": [
        "manifest",
        "name",
        "version",
        "edition",
        "rust_version",
        "description_present",
        "readme_present",
        "repository_present",
        "license",
        "license_file",
        "publish",
        "publish_restricted"
      ],
      "properties": {
        "manifest": { "type": "string", "minLength": 1 },
        "name": { "type": ["string", "null"], "minLength": 1 },
        "version": { "type": ["string", "null"], "minLength": 1 },
        "edition": { "type": ["string", "null"], "minLength": 1 },
        "rust_version": { "type": ["string", "null"], "minLength": 1 },
        "description_present": { "type": "boolean" },
        "readme_present": { "type": "boolean" },
        "repository_present": { "type": "boolean" },
        "license": { "type": ["string", "null"], "minLength": 1 },
        "license_file": { "type": ["string", "null"], "minLength": 1 },
        "publish": { "type": ["string", "null"], "minLength": 1 },
        "publish_restricted": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "treeSitterPackage": {
      "type": "object",
      "required": [
        "package_json",
        "config",
        "name",
        "version",
        "private",
        "package_license",
        "package_description_present",
        "config_license",
        "config_description_present"
      ],
      "properties": {
        "package_json": { "type": "string", "minLength": 1 },
        "config": { "type": "string", "minLength": 1 },
        "name": { "type": ["string", "null"], "minLength": 1 },
        "version": { "type": ["string", "null"], "minLength": 1 },
        "private": { "type": ["boolean", "null"] },
        "package_license": { "type": ["string", "null"], "minLength": 1 },
        "package_description_present": { "type": "boolean" },
        "config_license": { "type": ["string", "null"], "minLength": 1 },
        "config_description_present": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "license": {
      "type": "object",
      "required": ["file", "present", "operator_decision_required"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "present": { "type": "boolean" },
        "operator_decision_required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "tagCount": {
      "type": "object",
      "required": ["tag", "count"],
      "properties": {
        "tag": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "issue": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

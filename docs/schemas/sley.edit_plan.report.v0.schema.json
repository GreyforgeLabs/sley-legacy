{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sley.edit_plan.report.v0",
  "title": "Sley Edit Plan Report v0",
  "type": "object",
  "required": [
    "schema",
    "status",
    "target",
    "entry_module",
    "summary",
    "diagnostics",
    "task_surfaces",
    "next_actions"
  ],
  "properties": {
    "schema": { "const": "sley.edit_plan.report.v0" },
    "status": { "enum": ["ready", "warnings", "blocked"] },
    "target": { "type": "string", "minLength": 1 },
    "entry_module": { "type": ["string", "null"] },
    "summary": { "$ref": "#/$defs/summary" },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "sley.diagnostics.report.v0#/$defs/diagnostic" }
    },
    "query": { "$ref": "#/$defs/querySummary" },
    "lint": { "$ref": "#/$defs/lintSummary" },
    "task_surfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/taskSurface" }
    },
    "graft_templates": {
      "type": "array",
      "items": { "$ref": "#/$defs/graftTemplate" }
    },
    "transaction_templates": {
      "type": "array",
      "items": { "$ref": "#/$defs/transactionTemplate" }
    },
    "next_actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "summary": {
      "type": "object",
      "required": [
        "error_count",
        "warning_count",
        "module_count",
        "task_count",
        "call_count",
        "lint_finding_count",
        "task_surface_count"
      ],
      "properties": {
        "error_count": { "type": "integer", "minimum": 0 },
        "warning_count": { "type": "integer", "minimum": 0 },
        "module_count": { "type": "integer", "minimum": 0 },
        "task_count": { "type": "integer", "minimum": 0 },
        "call_count": { "type": "integer", "minimum": 0 },
        "lint_finding_count": { "type": "integer", "minimum": 0 },
        "task_surface_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "querySummary": {
      "type": "object",
      "required": [
        "source_schema",
        "kind",
        "module_count",
        "task_count",
        "call_count",
        "entrypoints"
      ],
      "properties": {
        "source_schema": { "const": "sley.query.report.v0" },
        "kind": { "enum": ["all"] },
        "module_count": { "type": "integer", "minimum": 0 },
        "task_count": { "type": "integer", "minimum": 0 },
        "call_count": { "type": "integer", "minimum": 0 },
        "entrypoints": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "lintSummary": {
      "type": "object",
      "required": [
        "source_schema",
        "status",
        "rules",
        "finding_count",
        "findings"
      ],
      "properties": {
        "source_schema": { "const": "sley.lint.report.v0" },
        "status": { "enum": ["ok", "findings"] },
        "rules": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "finding_count": { "type": "integer", "minimum": 0 },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/lintFinding" }
        }
      },
      "additionalProperties": false
    },
    "lintFinding": {
      "type": "object",
      "required": [
        "id",
        "rule",
        "severity",
        "message",
        "node",
        "module",
        "hint"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "rule": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "node": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "minLength": 1 },
        "hint": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "taskSurface": {
      "type": "object",
      "required": [
        "id",
        "module",
        "qualified_name",
        "exported",
        "takes",
        "return_type",
        "effects",
        "inbound_call_count",
        "outbound_call_count",
        "graft_targets",
        "planning_notes"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "minLength": 1 },
        "qualified_name": { "type": "string", "minLength": 1 },
        "exported": { "type": "boolean" },
        "takes": {
          "type": "array",
          "items": { "$ref": "#/$defs/take" }
        },
        "return_type": { "type": "string", "minLength": 1 },
        "effects": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "inbound_call_count": { "type": "integer", "minimum": 0 },
        "outbound_call_count": { "type": "integer", "minimum": 0 },
        "graft_targets": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "planning_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "graftTemplate": {
      "type": "object",
      "required": [
        "kind",
        "reason",
        "surface",
        "operation",
        "editable_json_pointers"
      ],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "surface": { "type": "string", "minLength": 1 },
        "operation": { "$ref": "#/$defs/graftOperation" },
        "editable_json_pointers": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "transactionTemplate": {
      "type": "object",
      "required": [
        "kind",
        "reason",
        "surface",
        "transaction",
        "editable_json_pointers"
      ],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "surface": { "type": "string", "minLength": 1 },
        "transaction": { "$ref": "#/$defs/graftTransaction" },
        "editable_json_pointers": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "graftOperation": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": {
          "enum": [
            "AddModuleDeclaration",
            "AddTask",
            "ReplaceTaskBody",
            "AddTake",
            "RemoveTake",
            "RenameDeclaration",
            "AddTypeDeclaration",
            "AddEffectDeclaration",
            "RemoveTaskEffect",
            "AddImport",
            "UpdateCallSites",
            "UpdateCallArgs",
            "ReplaceCallArg",
            "RemoveCallArg",
            "InsertStatement",
            "ReplaceStatement",
            "ReplaceExpression",
            "MoveNode",
            "DeleteNode"
          ]
        },
        "target": { "type": "string", "minLength": 1 },
        "precondition": { "type": "object" },
        "payload": { "type": "object" }
      },
      "additionalProperties": false
    },
    "graftTransaction": {
      "type": "object",
      "required": ["transaction", "mode", "ops"],
      "properties": {
        "transaction": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["all_or_nothing"] },
        "ops": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/graftOperation" }
        }
      },
      "additionalProperties": false
    },
    "take": {
      "type": "object",
      "required": ["name", "binding_kind", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "binding_kind": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": ["kind", "reason", "command"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  }
}

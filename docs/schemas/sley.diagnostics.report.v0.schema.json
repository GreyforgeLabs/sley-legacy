{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sley.diagnostics.report.v0",
  "title": "Sley Diagnostic Report v0",
  "type": "object",
  "required": ["schema", "status", "diagnostics"],
  "properties": {
    "schema": { "const": "sley.diagnostics.report.v0" },
    "status": { "enum": ["ok", "error"] },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "message"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "enum": ["error", "warning", "info"] },
          "message": { "type": "string" },
          "node": { "type": "string" },
          "span": { "$ref": "#/$defs/span" },
          "repair_hints": {
            "type": "array",
            "items": { "$ref": "#/$defs/repair_hint" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "span": {
      "type": "object",
      "required": ["line", "column"],
      "properties": {
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "repair_hint": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string" },
        "target": { "type": "string" },
        "effect": { "type": "string" },
        "replacement": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}

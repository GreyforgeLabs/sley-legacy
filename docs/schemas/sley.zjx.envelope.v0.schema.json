{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sley.zjx.envelope.v0",
  "title": "Sley ZJX Envelope v0",
  "type": "object",
  "required": ["schema", "format", "compression", "target", "graph_digest", "graph"],
  "properties": {
    "schema": { "const": "sley.zjx.envelope.v0" },
    "format": { "const": "zjx-preview-json" },
    "compression": { "const": "none" },
    "target": { "type": "string", "minLength": 1 },
    "graph_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "graph": { "$ref": "sley.symbol_graph.v0" },
    "slice": { "$ref": "sley.symbol_graph.slice.v0" },
    "trace_receipts": {
      "type": "array",
      "items": { "$ref": "sley.trace.receipt.v0" }
    }
  },
  "additionalProperties": false
}

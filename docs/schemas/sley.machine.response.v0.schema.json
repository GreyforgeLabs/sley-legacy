{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sley.machine.response.v0",
  "title": "Sley machine response v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "protocolVersion", "requestId", "status", "package", "source", "runtime", "counters"],
  "properties": {
    "schema": { "const": "sley.machine.response.v0" },
    "protocolVersion": { "type": "string", "minLength": 1 },
    "requestId": { "type": ["string", "null"] },
    "status": { "enum": ["ok", "error"] },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "fileCount"],
      "properties": {
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "fileCount": { "type": "integer", "minimum": 1 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "task": { "type": "string", "minLength": 1 },
    "input": { "type": "object" },
    "result": {},
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "result", "payload"],
      "properties": {
        "input": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "result": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "payload": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "code", "message", "phase", "path"],
      "properties": {
        "class": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "phase": { "type": "string", "minLength": 1 },
        "path": { "type": "string" },
        "limit": { "type": "string", "minLength": 1 }
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps", "calls", "maxCallDepth", "inputBytes", "outputBytes", "batchIndex"],
      "properties": {
        "steps": { "type": "integer", "minimum": 0 },
        "calls": { "type": "integer", "minimum": 0 },
        "maxCallDepth": { "type": "integer", "minimum": 0 },
        "inputBytes": { "type": "integer", "minimum": 0 },
        "outputBytes": { "type": "integer", "minimum": 0 },
        "batchIndex": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "ok" } } },
      "then": { "required": ["task", "input", "result", "digests"] },
      "else": { "required": ["error"] }
    }
  ]
}

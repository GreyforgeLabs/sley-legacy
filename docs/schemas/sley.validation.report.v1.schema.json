{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sley.validation.report.v1",
  "title": "Sley Validation Report v1",
  "type": "object",
  "required": [
    "schema", "status", "profile", "target", "authority",
    "detected_changes", "detected_subsystems", "selected_subsystems",
    "selected_checks", "skipped_checks", "selection_reasons",
    "release_gate", "cache", "wall_time_ms", "outcome", "steps", "issues"
  ],
  "properties": {
    "schema": {"const": "sley.validation.report.v1"},
    "status": {"enum": ["passed", "failed"]},
    "profile": {"enum": ["quick", "changed", "core", "release"]},
    "target": {"const": "."},
    "authority": {
      "type": "object",
      "required": ["mode", "repository_mutation", "provider_calls", "network_calls", "deploy", "spend"],
      "properties": {
        "mode": {"const": "repository_local_validation"},
        "repository_mutation": {"const": false},
        "provider_calls": {"const": false},
        "network_calls": {"const": false},
        "deploy": {"const": false},
        "spend": {"const": false}
      },
      "additionalProperties": false
    },
    "detected_changes": {"$ref": "#/$defs/strings"},
    "detected_subsystems": {"$ref": "#/$defs/strings"},
    "selected_subsystems": {"$ref": "#/$defs/strings"},
    "selected_checks": {"$ref": "#/$defs/strings"},
    "skipped_checks": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["id", "reason"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "reason": {"enum": ["profile_scope", "unchanged_subsystem", "no_detected_changes", "not_part_of_release_gate"]}
        },
        "additionalProperties": false
      }
    },
    "selection_reasons": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["id", "reason"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "reason": {"enum": ["selected_by_quick_profile", "selected_by_changed_path_classifier", "selected_by_core_profile", "selected_by_release_profile"]}
        },
        "additionalProperties": false
      }
    },
    "release_gate": {
      "type": "object",
      "required": ["required", "executed", "authoritative_command", "reason"],
      "properties": {
        "required": {"type": "boolean"},
        "executed": {"type": "boolean"},
        "authoritative_command": {"const": ["make", "v1"]},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "cache": {
      "type": "object",
      "required": ["validation_result_used", "validation_result_policy", "source_task_cache_enabled", "source_task_cache_scope"],
      "properties": {
        "validation_result_used": {"const": false},
        "validation_result_policy": {"const": "disabled"},
        "source_task_cache_enabled": {"type": "boolean"},
        "source_task_cache_scope": {"const": "contract_loading_only"}
      },
      "additionalProperties": false
    },
    "wall_time_ms": {"type": "integer", "minimum": 0},
    "outcome": {"enum": ["passed", "failed"]},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/step"}
    },
    "issues": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/issue"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "strings": {"type": "array", "maxItems": 1024, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "step": {
      "type": "object",
      "required": ["id", "command", "status", "exit_code", "wall_time_ms", "evidence_digest", "evidence_bytes", "evidence_total_bytes", "evidence_truncated", "evidence_embedded"],
      "properties": {
        "id": {"enum": ["quick", "changed", "core", "release"]},
        "command": {"type": "array", "minItems": 1, "maxItems": 1028, "items": {"type": "string", "minLength": 1}},
        "status": {"enum": ["passed", "failed"]},
        "exit_code": {"type": "integer", "minimum": 0, "maximum": 255},
        "wall_time_ms": {"type": "integer", "minimum": 0},
        "evidence_digest": {"$ref": "#/$defs/digest"},
        "evidence_bytes": {"type": "integer", "minimum": 0},
        "evidence_total_bytes": {"type": "integer", "minimum": 0},
        "evidence_truncated": {"type": "boolean"},
        "evidence_embedded": {"const": false}
      },
      "additionalProperties": false
    },
    "issue": {
      "type": "object",
      "required": ["code", "message", "evidence_digest"],
      "properties": {
        "code": {"const": "SLEY_VALIDATION_CHECK_FAILED"},
        "message": {"type": "string", "minLength": 1},
        "evidence_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "passed"}}},
      "then": {"properties": {"outcome": {"const": "passed"}, "issues": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"status": {"const": "failed"}}},
      "then": {"properties": {"outcome": {"const": "failed"}, "issues": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"profile": {"const": "release"}}},
      "then": {"properties": {"release_gate": {"properties": {"required": {"const": true}, "executed": {"const": true}}}}}
    }
  ],
  "additionalProperties": false
}

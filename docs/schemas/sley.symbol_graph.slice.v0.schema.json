{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sley.symbol_graph.slice.v0",
  "title": "Sley Symbol Graph Slice v0",
  "type": "object",
  "required": [
    "schema",
    "target",
    "entry_module",
    "focus",
    "imports",
    "types",
    "effects",
    "tasks",
    "move_affordances",
    "outbound_calls",
    "inbound_calls"
  ],
  "properties": {
    "schema": { "const": "sley.symbol_graph.slice.v0" },
    "target": { "type": "string" },
    "entry_module": { "type": "string" },
    "focus": { "type": "object" },
    "imports": { "type": "array", "items": { "$ref": "#/$defs/importSummary" } },
    "types": { "type": "array", "items": { "$ref": "#/$defs/declarationSummary" } },
    "effects": { "type": "array", "items": { "$ref": "#/$defs/declarationSummary" } },
    "tasks": { "type": "array", "items": { "$ref": "#/$defs/declarationSummary" } },
    "task": { "type": "object" },
    "move_affordances": { "type": "array", "items": { "$ref": "#/$defs/moveAffordance" } },
    "outbound_calls": { "type": "array", "items": { "type": "object" } },
    "inbound_calls": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "importSummary": {
      "type": "object",
      "required": ["id", "module"],
      "properties": {
        "id": { "type": "string" },
        "module": { "type": "string" },
        "alias": { "type": "string" }
      },
      "additionalProperties": false
    },
    "declarationSummary": {
      "type": "object",
      "required": ["name", "id", "exported"],
      "properties": {
        "name": { "type": "string" },
        "id": { "type": "string" },
        "exported": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "moveAffordance": {
      "type": "object",
      "required": [
        "target",
        "target_kind",
        "parent",
        "position",
        "max_position",
        "operation",
        "editable_json_pointers",
        "destinations"
      ],
      "properties": {
        "target": { "type": "string" },
        "target_kind": { "enum": ["statement", "take"] },
        "parent": { "type": "string" },
        "position": { "type": "integer", "minimum": 0 },
        "max_position": { "type": "integer", "minimum": 0 },
        "operation": { "type": "object" },
        "editable_json_pointers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "destinations": {
          "type": "array",
          "items": { "$ref": "#/$defs/moveDestination" }
        }
      },
      "additionalProperties": false
    },
    "moveDestination": {
      "type": "object",
      "required": [
        "parent",
        "max_position",
        "operation",
        "editable_json_pointers"
      ],
      "properties": {
        "parent": { "type": "string" },
        "max_position": { "type": "integer", "minimum": 0 },
        "operation": { "type": "object" },
        "editable_json_pointers": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sley.symbol_graph.slice.v0",
  "title": "Sley Symbol Graph Slice v0",
  "type": "object",
  "required": [
    "schema",
    "target",
    "entry_module",
    "focus",
    "imports",
    "types",
    "effects",
    "tasks",
    "add_affordances",
    "insert_affordances",
    "move_affordances",
    "delete_affordances",
    "replace_affordances",
    "call_site_affordances",
    "outbound_calls",
    "inbound_calls"
  ],
  "properties": {
    "schema": { "const": "sley.symbol_graph.slice.v0" },
    "target": { "type": "string", "minLength": 1 },
    "entry_module": { "type": "string", "minLength": 1 },
    "focus": { "$ref": "#/$defs/sliceFocus" },
    "imports": { "type": "array", "items": { "$ref": "#/$defs/importSummary" } },
    "types": { "type": "array", "items": { "$ref": "#/$defs/declarationSummary" } },
    "effects": { "type": "array", "items": { "$ref": "#/$defs/declarationSummary" } },
    "tasks": { "type": "array", "items": { "$ref": "#/$defs/declarationSummary" } },
    "task": { "$ref": "sley.ast.program.v0#/$defs/taskDecl" },
    "add_affordances": { "type": "array", "items": { "$ref": "#/$defs/addAffordance" } },
    "insert_affordances": { "type": "array", "items": { "$ref": "#/$defs/insertAffordance" } },
    "move_affordances": { "type": "array", "items": { "$ref": "#/$defs/moveAffordance" } },
    "delete_affordances": { "type": "array", "items": { "$ref": "#/$defs/deleteAffordance" } },
    "replace_affordances": { "type": "array", "items": { "$ref": "#/$defs/replaceAffordance" } },
    "call_site_affordances": { "type": "array", "items": { "$ref": "#/$defs/callSiteAffordance" } },
    "outbound_calls": {
      "type": "array",
      "items": { "$ref": "sley.query.report.v0#/$defs/callSummary" }
    },
    "inbound_calls": {
      "type": "array",
      "items": { "$ref": "sley.query.report.v0#/$defs/callSummary" }
    }
  },
  "$defs": {
    "sliceFocus": {
      "type": "object",
      "required": ["kind", "id", "module", "name"],
      "properties": {
        "kind": { "enum": ["module", "task", "type", "effect", "import"] },
        "id": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "importSummary": {
      "type": "object",
      "required": ["id", "module"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "minLength": 1 },
        "alias": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "declarationSummary": {
      "type": "object",
      "required": ["name", "id", "exported"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "exported": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "addAffordance": {
      "type": "object",
      "required": [
        "target",
        "target_kind",
        "operation",
        "editable_json_pointers"
      ],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "target_kind": { "enum": ["import", "type", "effect", "task"] },
        "operation": { "$ref": "sley.edit_plan.report.v0#/$defs/graftOperation" },
        "editable_json_pointers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "insertAffordance": {
      "type": "object",
      "required": [
        "target",
        "target_kind",
        "max_position",
        "operation",
        "editable_json_pointers"
      ],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "target_kind": { "enum": ["block"] },
        "max_position": { "type": "integer", "minimum": 0 },
        "operation": { "$ref": "sley.edit_plan.report.v0#/$defs/graftOperation" },
        "editable_json_pointers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "moveAffordance": {
      "type": "object",
      "required": [
        "target",
        "target_kind",
        "parent",
        "position",
        "max_position",
        "operation",
        "editable_json_pointers",
        "destinations"
      ],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "target_kind": { "enum": ["import", "type", "effect", "task", "statement", "take"] },
        "parent": { "type": "string", "minLength": 1 },
        "position": { "type": "integer", "minimum": 0 },
        "max_position": { "type": "integer", "minimum": 0 },
        "operation": { "$ref": "sley.edit_plan.report.v0#/$defs/graftOperation" },
        "editable_json_pointers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "destinations": {
          "type": "array",
          "items": { "$ref": "#/$defs/moveDestination" }
        }
      },
      "additionalProperties": false
    },
    "moveDestination": {
      "type": "object",
      "required": [
        "parent",
        "max_position",
        "operation",
        "editable_json_pointers"
      ],
      "properties": {
        "parent": { "type": "string", "minLength": 1 },
        "max_position": { "type": "integer", "minimum": 0 },
        "operation": { "$ref": "sley.edit_plan.report.v0#/$defs/graftOperation" },
        "editable_json_pointers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "deleteAffordance": {
      "type": "object",
      "required": [
        "target",
        "target_kind",
        "parent",
        "position",
        "operation",
        "editable_json_pointers"
      ],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "target_kind": { "enum": ["import", "type", "effect", "task", "statement", "take"] },
        "parent": { "type": "string", "minLength": 1 },
        "position": { "type": "integer", "minimum": 0 },
        "operation": { "$ref": "sley.edit_plan.report.v0#/$defs/graftOperation" },
        "editable_json_pointers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "replaceAffordance": {
      "type": "object",
      "required": [
        "target",
        "target_kind",
        "parent",
        "operation",
        "editable_json_pointers"
      ],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "target_kind": {
          "enum": [
            "statement",
            "Raw",
            "StringLiteral",
            "IntLiteral",
            "FloatLiteral",
            "BoolLiteral",
            "Identifier",
            "Unary",
            "Binary",
            "If",
            "Call",
            "ListLiteral",
            "MapLiteral",
            "Index",
            "FieldAccess",
            "RecordLiteral",
            "Try"
          ]
        },
        "parent": { "type": "string", "minLength": 1 },
        "operation": { "$ref": "sley.edit_plan.report.v0#/$defs/graftOperation" },
        "editable_json_pointers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "callSiteAffordance": {
      "type": "object",
      "required": [
        "target",
        "target_kind",
        "task_target",
        "from",
        "callee",
        "operation",
        "editable_json_pointers"
      ],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "target_kind": { "enum": ["call_site"] },
        "task_target": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "callee": { "type": "string", "minLength": 1 },
        "operation": { "$ref": "sley.edit_plan.report.v0#/$defs/graftOperation" },
        "editable_json_pointers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sley.corpus.exclusion_ledger.v0",
  "title": "Sley Corpus Exclusion Ledger v0",
  "type": "object",
  "required": ["schema", "ledger_id", "version", "benchmark_split_status", "entries"],
  "properties": {
    "schema": { "const": "sley.corpus.exclusion_ledger.v0" },
    "ledger_id": { "$ref": "#/$defs/id" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "benchmark_split_status": { "enum": ["incomplete", "pinned"] },
    "entries": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["exclusion_id", "case_id", "visibility", "exact", "canonical", "structural", "semantic_lineage"],
        "properties": {
          "exclusion_id": { "$ref": "#/$defs/digest" },
          "case_id": { "$ref": "#/$defs/id" },
          "visibility": { "enum": ["public", "private_held_out"] },
          "exact": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/digest" } },
          "canonical": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/digest" } },
          "structural": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/digest" } },
          "semantic_lineage": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/digest" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}

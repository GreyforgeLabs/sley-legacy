{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sley.change.apply.v0",
  "title": "Sley Change Apply Report v0",
  "type": "object",
  "required": [
    "schema", "status", "transaction", "authorization_ref", "grant_ref",
    "candidate", "atomicity", "recovery_ref", "replay", "revocation",
    "verification", "rollback", "mutations", "internal_mutations",
    "next_actions", "issues"
  ],
  "properties": {
    "schema": {"const": "sley.change.apply.v0"},
    "status": {"enum": ["verified", "rolled_back"]},
    "transaction": {"$ref": "sley.change.recovery.v0#/$defs/transaction"},
    "authorization_ref": {"$ref": "sley.change.revocation_record.v0#/$defs/authorizationRef"},
    "grant_ref": {"$ref": "sley.change.apply_authorization.v0#/$defs/grantRef"},
    "candidate": {"$ref": "sley.change.grant.v0#/$defs/candidate"},
    "atomicity": {"$ref": "sley.change.apply_authorization.v0#/$defs/atomicity"},
    "recovery_ref": {"$ref": "#/$defs/recoveryRef"},
    "replay": {"$ref": "sley.change.recovery.v0#/$defs/replay"},
    "revocation": {"$ref": "sley.change.recovery.v0#/$defs/revocationRef"},
    "verification": {"$ref": "sley.change.recovery.v0#/$defs/verification"},
    "rollback": {"$ref": "sley.change.recovery.v0#/$defs/rollback"},
    "mutations": {"$ref": "sley.change.recovery.v0#/$defs/mutations"},
    "internal_mutations": {"$ref": "sley.change.recovery.v0#/$defs/internalMutations"},
    "next_actions": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/action"}},
    "issues": {"type": "array", "items": {"$ref": "sley.change.recovery.v0#/$defs/issue"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "recoveryRef": {
      "type": "object",
      "required": ["schema", "record_id", "record_digest", "phase", "path"],
      "properties": {
        "schema": {"const": "sley.change.recovery.v0"},
        "record_id": {"type": "string", "pattern": "^recovery:[a-f0-9]{64}$"},
        "record_digest": {"$ref": "#/$defs/digest"},
        "phase": {"enum": ["verified", "rolled_back"]},
        "path": {"type": "string", "pattern": "^\\.sley/transactions/[a-f0-9]{64}/recovery/record\\.json$"}
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": ["kind", "reason"],
      "properties": {
        "kind": {"enum": ["seal_verified_transaction", "review_failed_transaction"]},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sley.graft.outcome.v0",
  "title": "Sley Graft Outcome v0",
  "type": "object",
  "required": ["schema", "status", "diagnostics", "provenance"],
  "properties": {
    "schema": { "const": "sley.graft.outcome.v0" },
    "status": { "enum": ["accepted", "rejected"] },
    "source": { "type": "string" },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "sley.diagnostics.report.v0#/$defs/diagnostic" }
    },
    "provenance": { "type": "array", "items": { "$ref": "#/$defs/provenanceRecord" } }
  },
  "additionalProperties": false,
  "$defs": {
    "provenanceRecord": {
      "type": "object",
      "required": ["graft_id", "actor", "timestamp", "operation", "targets", "result"],
      "properties": {
        "graft_id": { "type": "string", "minLength": 1 },
        "actor": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "minLength": 1 },
        "operation": {
          "enum": [
            "AddModuleDeclaration",
            "AddTask",
            "ReplaceTaskBody",
            "AddTake",
            "RemoveTake",
            "RenameDeclaration",
            "AddTypeDeclaration",
            "AddEffectDeclaration",
            "RemoveTaskEffect",
            "AddImport",
            "UpdateCallSites",
            "UpdateCallArgs",
            "ReplaceCallArg",
            "RemoveCallArg",
            "InsertStatement",
            "ReplaceStatement",
            "ReplaceExpression",
            "MoveNode",
            "DeleteNode"
          ]
        },
        "targets": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "result": { "enum": ["accepted"] }
      },
      "additionalProperties": false
    }
  }
}

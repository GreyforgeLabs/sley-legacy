{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sley.change.preview.v0",
  "title": "Sley Change Preview v0",
  "type": "object",
  "required": [
    "schema", "status", "transaction", "plan", "candidate", "diffs",
    "diagnostics", "focused_tests", "validation", "review_requirements",
    "mutations", "next_actions", "issues"
  ],
  "properties": {
    "schema": {"const": "sley.change.preview.v0"},
    "status": {"const": "previewed"},
    "transaction": {"$ref": "#/$defs/transaction"},
    "plan": {"$ref": "sley.change.plan.v0#/$defs/plan"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "diffs": {"$ref": "#/$defs/diffs"},
    "diagnostics": {
      "type": "array",
      "items": {"$ref": "sley.diagnostics.report.v0#/$defs/diagnostic"}
    },
    "focused_tests": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/testResult"}
    },
    "validation": {"$ref": "#/$defs/validation"},
    "review_requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/reviewRequirement"}
    },
    "mutations": {"$ref": "sley.change.plan.v0#/$defs/mutations"},
    "next_actions": {
      "type": "array",
      "items": {"$ref": "#/$defs/action"}
    },
    "issues": {"type": "array", "maxItems": 0}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "transaction": {
      "type": "object",
      "required": [
        "transaction_id", "state", "history", "repository", "base",
        "compiler", "actor", "goal", "nonce", "created_at", "expires_at"
      ],
      "properties": {
        "transaction_id": {"$ref": "#/$defs/digest"},
        "state": {"const": "previewed"},
        "history": {
          "type": "array",
          "prefixItems": [
            {"const": "opened"},
            {"const": "inspected"},
            {"const": "planned"},
            {"const": "previewed"}
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "repository": {"$ref": "sley.change.plan.v0#/$defs/transaction/properties/repository"},
        "base": {"$ref": "sley.change.plan.v0#/$defs/transaction/properties/base"},
        "compiler": {
          "type": "object",
          "required": ["version", "contract_versions"],
          "properties": {
            "version": {"type": "string", "minLength": 1},
            "contract_versions": {
              "type": "object",
              "required": ["diagnostics", "graph_slice", "verify", "inspection", "plan", "preview"],
              "properties": {
                "diagnostics": {"const": "sley.diagnostics.report.v1"},
                "graph_slice": {"const": "sley.symbol_graph.slice.v1"},
                "verify": {"const": "sley.verify.report.v1"},
                "inspection": {"const": "sley.transaction.inspect.v0"},
                "plan": {"const": "sley.change.plan.v0"},
                "preview": {"const": "sley.change.preview.v0"}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "actor": {"type": "string", "minLength": 1, "maxLength": 256},
        "goal": {"type": "string", "minLength": 1, "maxLength": 4096},
        "nonce": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "created_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": [
        "candidate_id", "candidate_digest", "workspace_kind", "materialized",
        "base_source_digest", "candidate_source_digest", "candidate_graph_digest",
        "operation_digest", "owned_paths", "source_projection"
      ],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^candidate:[a-f0-9]{64}$"},
        "candidate_digest": {"$ref": "#/$defs/digest"},
        "workspace_kind": {"const": "isolated_ephemeral_copy"},
        "materialized": {"const": false},
        "base_source_digest": {"$ref": "#/$defs/digest"},
        "candidate_source_digest": {"$ref": "#/$defs/digest"},
        "candidate_graph_digest": {"$ref": "#/$defs/digest"},
        "operation_digest": {"$ref": "#/$defs/digest"},
        "owned_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}
        },
        "source_projection": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourceFile"}
        }
      },
      "additionalProperties": false
    },
    "sourceFile": {
      "type": "object",
      "required": ["path", "digest", "content"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "digest": {"$ref": "#/$defs/digest"},
        "content": {"type": "string"}
      },
      "additionalProperties": false
    },
    "diffs": {
      "type": "object",
      "required": ["source", "graph", "types", "calls", "effects", "authority"],
      "properties": {
        "source": {
          "type": "object",
          "required": ["format", "changed_files", "text"],
          "properties": {
            "format": {"const": "unified"},
            "changed_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "text": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "graph": {"$ref": "sley.graph_diff.report.v0"},
        "types": {"$ref": "#/$defs/changes"},
        "calls": {"$ref": "#/$defs/changes"},
        "effects": {"$ref": "#/$defs/changes"},
        "authority": {"$ref": "#/$defs/changes"}
      },
      "additionalProperties": false
    },
    "changes": {
      "type": "array",
      "items": {"$ref": "#/$defs/change"}
    },
    "change": {
      "type": "object",
      "required": ["identity", "change_kind", "before", "after"],
      "properties": {
        "identity": {"type": "string", "minLength": 1},
        "change_kind": {"enum": ["added", "modified", "deleted"]},
        "before": {},
        "after": {}
      },
      "additionalProperties": false
    },
    "testResult": {
      "type": "object",
      "required": ["kind", "status", "schema", "issue_count"],
      "properties": {
        "kind": {"enum": ["compiler_check", "compiler_lint", "structural_graph_diff"]},
        "status": {"enum": ["passed", "review_required", "failed"]},
        "schema": {"type": "string", "minLength": 1},
        "issue_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": ["profile", "required_passed", "check", "lint", "graph_diff"],
      "properties": {
        "profile": {"const": "compiler_preview_v0"},
        "required_passed": {"type": "boolean"},
        "check": {"$ref": "#/$defs/validationResult"},
        "lint": {"$ref": "#/$defs/validationResult"},
        "graph_diff": {"$ref": "#/$defs/validationResult"}
      },
      "additionalProperties": false
    },
    "validationResult": {
      "type": "object",
      "required": ["status", "schema", "issue_count"],
      "properties": {
        "status": {"enum": ["passed", "review_required", "failed"]},
        "schema": {"type": "string", "minLength": 1},
        "issue_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "reviewRequirement": {
      "type": "object",
      "required": ["kind", "reason", "blocking_for_apply"],
      "properties": {
        "kind": {"enum": ["human_source_review", "graph_diff_review", "lint_review", "authority_review"]},
        "reason": {"type": "string", "minLength": 1},
        "blocking_for_apply": {"const": true}
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": ["kind", "reason"],
      "properties": {
        "kind": {"enum": ["review_candidate", "reinspect_if_base_changes"]},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

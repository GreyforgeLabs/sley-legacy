{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sley",
  "scopeName": "source.sley",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#hostCalls" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.sley", "match": "//.*$" },
        { "name": "comment.line.number-sign.sley", "match": "#.*$" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.sley",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.sley", "match": "\\\\." }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.sley", "match": "\\b[0-9]+(\\.[0-9]+)?\\b" },
        { "name": "constant.language.boolean.sley", "match": "\\b(true|false)\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.sley",
          "match": "\\b(if|else|while|for|each|in|return|call|forge|map)\\b"
        },
        {
          "name": "keyword.declaration.sley",
          "match": "\\b(module|import|as|export|type|effect|task|uses|take|set)\\b"
        },
        {
          "name": "storage.modifier.sley",
          "match": "\\b(gate|veil|taint|view)\\b"
        },
        {
          "name": "storage.type.binding.sley",
          "match": "\\b(bind|state|cell|knot|slot|lease|dial|flag|memo|cache|derive|flow|port|tally|hole|draft|witness|seal|anchor|cursor)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        { "name": "support.type.sley", "match": "\\b[A-Z][A-Za-z0-9_]*(\\.[A-Z][A-Za-z0-9_]*)*\\b" }
      ]
    },
    "hostCalls": {
      "patterns": [
        { "name": "support.function.host.sley", "match": "\\b(fs|db|http|model|secrets|shell|deploy|spend)\\.[A-Za-z_][A-Za-z0-9_]*\\b" }
      ]
    }
  }
}

{
  "name": "sley-vscode",
  "displayName": "Sley",
  "description": "Local VS Code language support for Sley backed by sley-lsp.",
  "version": "0.1.0",
  "private": true,
  "publisher": "greyforge",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:sley", "workspaceContains:sley.toml"],
  "main": "./extension.js",
  "scripts": {
    "validate": "node ../../scripts/validate-editor-shims.mjs"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "contributes": {
    "commands": [
      {
        "command": "sley.restartLanguageServer",
        "title": "Sley: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "Sley",
      "properties": {
        "sley.languageServer.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `sley-lsp` executable. Leave blank to use `SLEY_LSP` or `sley-lsp` from PATH."
        }
      }
    },
    "languages": [
      {
        "id": "sley",
        "aliases": ["Sley", "sley"],
        "extensions": [".sley"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sley",
        "scopeName": "source.sley",
        "path": "./syntaxes/sley.tmLanguage.json"
      }
    ]
  }
}

module loom.transaction

export task lifecycle_states -> List<Text> {
  return [
    "opened",
    "inspected",
    "planned",
    "previewed",
    "awaiting_approval",
    "approved",
    "applying",
    "applied",
    "verifying",
    "sealed"
  ]
}

export task failure_states -> List<Text> {
  return [
    "rejected",
    "stale",
    "denied",
    "apply_failed",
    "verification_failed",
    "rolled_back",
    "cancelled",
    "expired"
  ]
}


export task identifier_resolution_inputs -> List<Text> {
  return [
    "task_names",
    "take_names",
    "binding_names"
  ]
}

export task builtin_effects -> List<Text> {
  return [
    "DatabaseRead",
    "DatabaseWrite",
    "DbRead",
    "DbWrite",
    "Deploy",
    "FileRead",
    "FileWrite",
    "ModelCall",
    "Network",
    "SecretRead",
    "Shell",
    "Spend"
  ]
}

export task diagnostic_status -> Text {
  take error_count: Int

  if error_count > 0 {
    return call error_status()
  }
  return call ok_status()
}

export task is_builtin_type -> Bool {
  take name: Text

  if name == "Int" {
    return true
  }
  if name == "Text" {
    return true
  }
  if name == "Bool" {
    return true
  }
  if name == "Unit" {
    return true
  }
  if name == "Result" {
    return true
  }
  if name == "Error" {
    return true
  }
  if name == "Gate" {
    return true
  }
  if name == "List" {
    return true
  }
  if name == "Map" {
    return true
  }
  return false
}

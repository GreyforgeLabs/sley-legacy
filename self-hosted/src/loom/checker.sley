module loom.checker

export type Diagnostic = {
  slot id: Text
  slot severity: Text
  slot message: Text
  slot node: Text
}

export task diagnostic_pass_order -> List<Text> {
  return [
    "duplicate_effect_diags",
    "duplicate_type_diags",
    "duplicate_task_diags",
    "task_diags",
    "return_type_diags",
    "take_type_diags",
    "unknown_effect_diags",
    "gate_take_type_diags",
    "gate_effect_diags",
    "question_requires_result_diags",
    "direct_effect_diags",
    "transitive_effect_diags",
    "unknown_task_diags",
    "call_arity_diags",
    "call_argument_type_diags",
    "type_mismatch_diags",
    "return_type_mismatch_diags",
    "duplicate_take_diags",
    "duplicate_map_key_diags",
    "duplicate_record_field_diags",
    "duplicate_record_literal_field_diags",
    "record_field_missing_diags",
    "record_field_unknown_diags",
    "record_field_type_mismatch_diags",
    "record_literal_non_record_type_diags",
    "unknown_record_field_diags",
    "list_element_type_diags",
    "index_diags",
    "map_index_key_type_diags",
    "map_key_type_diags",
    "map_value_type_diags",
    "missing_return_diags"
  ]
}

export task diagnostic_pass_descriptors -> List<Text> {
  return [
    "duplicate_effect_diags|duplicate_name|duplicate_effect_id|duplicate_effect_message|effect_name|module_effect_name|effect",
    "duplicate_type_diags|duplicate_name|duplicate_type_id|duplicate_type_message|type_name|module_type_name|type",
    "duplicate_task_diags|duplicate_name|duplicate_task_id|duplicate_task_message|task_name|module_task_name|task",
    "task_diags|legacy|||||",
    "return_type_diags|unknown_reference|unknown_type_id|unknown_type_message|type_name|task_return_type|task",
    "take_type_diags|unknown_reference|unknown_type_id|unknown_type_message|type_name|take_type|take",
    "unknown_effect_diags|unknown_reference|unknown_effect_id|unknown_effect_message|effect_name|task_effect|task",
    "gate_take_type_diags|gate_reference|gate_take_type_mismatch_id|gate_take_type_mismatch_message|actual_type|gate_take_type|take",
    "gate_effect_diags|gate_reference|gate_effect_undeclared_id|gate_effect_undeclared_message|effect_name|gate_effect_declared|take",
    "question_requires_result_diags|legacy|||||",
    "direct_effect_diags|effect_authorization|effect_unauthorized_id|effect_unauthorized_message|effect_name|direct_host_effect|expr",
    "transitive_effect_diags|effect_authorization|effect_unauthorized_id|effect_unauthorized_message|effect_name|transitive_task_effect|expr",
    "unknown_task_diags|call_shape|unknown_task_id|unknown_task_message|task_name|unknown_task_call|expr",
    "call_arity_diags|call_shape|call_arity_mismatch_id|call_arity_mismatch_message|task_name|call_arity|expr",
    "call_argument_type_diags|call_shape|call_argument_type_mismatch_id|call_argument_type_mismatch_message|task_name|call_argument_type|expr",
    "type_mismatch_diags|legacy|||||",
    "return_type_mismatch_diags|legacy|||||",
    "duplicate_take_diags|duplicate_name|duplicate_take_id|duplicate_take_message|take_name|task_take_name|take",
    "duplicate_map_key_diags|duplicate_name|duplicate_map_key_id|duplicate_map_key_message|key_name|map_entry_key|expr",
    "duplicate_record_field_diags|duplicate_name|duplicate_field_id|duplicate_field_message|field_name|record_type_field_name|type",
    "duplicate_record_literal_field_diags|duplicate_name|duplicate_record_literal_field_id|duplicate_record_literal_field_message|field_name|record_literal_field_name|expr",
    "record_field_missing_diags|record_shape|record_field_missing_id|record_field_missing_message|field_name|record_literal_missing_field|expr",
    "record_field_unknown_diags|record_shape|record_field_unknown_id|record_field_unknown_message|field_name|record_literal_unknown_field|expr",
    "record_field_type_mismatch_diags|record_shape|record_field_type_mismatch_id|record_field_type_mismatch_message|field_name|record_literal_field_type|expr",
    "record_literal_non_record_type_diags|record_shape|record_literal_non_record_type_id|record_literal_non_record_type_message|type_name|record_literal_non_record_type|expr",
    "unknown_record_field_diags|record_shape|unknown_record_field_id|unknown_record_field_message|field_name|record_access_unknown_field|expr",
    "list_element_type_diags|collection_shape|list_element_type_mismatch_id|list_element_type_mismatch_message|actual_type|list_literal_element_type|expr",
    "index_diags|collection_shape|index_not_int_id|index_not_int_message|actual_type|list_index_type|expr",
    "map_index_key_type_diags|collection_shape|index_key_type_mismatch_id|index_key_type_mismatch_message|actual_type|map_index_key_type|expr",
    "map_key_type_diags|collection_shape|map_key_type_mismatch_id|map_key_type_mismatch_message|actual_type|map_literal_key_type|expr",
    "map_value_type_diags|collection_shape|map_value_type_mismatch_id|map_value_type_mismatch_message|actual_type|map_literal_value_type|expr",
    "missing_return_diags|legacy|||||"
  ]
}


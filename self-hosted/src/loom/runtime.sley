export task agent_deploy_target_suffix -> Text {
  return "agent_deploy_pipeline.sley"
}

export task project_ready_call_probe -> Text {
  return call parser.call_expression_prefix() + "math.double(21)"
}

export task project_ready_binding_probe -> Text {
  return call parser.call_expression_prefix() + "double(base)"
}

export task list_len_value -> Int {
  take item_count: Int

  return item_count
}

export task int_identity_value -> Int {
  take value: Int

  return value
}

export task text_identity_value -> Text {
  take value: Text

  return value
}

export task text_concat_value -> Text {
  take left: Text
  take right: Text

  return left + right
}

export task bool_identity_value -> Bool {
  take value: Bool

  return value
}

export task spend_prefixed_value -> Text {
  take authorization: Text

  return "budget gate: " + authorization
}

export task int_add_value -> Int {
  take left: Int
  take right: Int

  return left + right
}

export task int_multiply_value -> Int {
  take left: Int
  take right: Int

  return left * right
}

export task int_less_than_value -> Bool {
  take left: Int
  take right: Int

  return left < right

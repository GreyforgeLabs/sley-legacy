export task bool_equal_value -> Bool {
  take left: Bool
  take right: Bool

  return left == right
}

export task bool_and_value -> Bool {
  take left: Bool
  take right: Bool

  return left && right
}

export task bool_or_value -> Bool {
  take left: Bool
  take right: Bool

  return left || right
}

export task bool_not_value -> Bool {
  take value: Bool

  if value {
    return false
  }
  return true
}

export task bool_if_value -> Bool {
  take condition: Bool
  take then_value: Bool
  take else_value: Bool

  if condition {
    return then_value
  }
  return else_value
}

export task int_if_value -> Int {
  take condition: Bool
  take then_value: Int
  take else_value: Int

  if condition {
    return then_value
  }
  return else_value
}

export task text_if_value -> Text {
  take condition: Bool
  take then_value: Text
  take else_value: Text

  if condition {
    return then_value
  }
  return else_value
}

export task text_equal_value -> Bool {
  take left: Text
  take right: Text

  return left == right
}


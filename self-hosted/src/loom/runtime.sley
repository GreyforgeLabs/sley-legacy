module loom.runtime

export type RuntimeValue = {
  slot kind: Text
  slot value: Text
}

export type RuntimeUser = {
  slot name: Text
  slot age: Int
}

export task hello_value -> Text {
  return "hello sley"
}

export task project_ready_value -> Int {
  return 42
}

export task default_profile_text -> Text {
  return "profile ready"
}

export task default_model_plan_text -> Text {
  return "plan approved"
}

export task default_deploy_result_text -> Text {
  return "staged"
}

export task default_raw_value -> Text {
  return "stage1 runtime result"
}

export task passed_status -> Text {
  return "passed"
}

export task failed_status -> Text {
  return "failed"
}

export task skipped_status -> Text {
  return "skipped"
}

export task int_value_kind -> Text {
  return "Int"
}

export task text_value_kind -> Text {
  return "Text"
}

export task bool_value_kind -> Text {
  return "Bool"
}

export task raw_value_kind -> Text {
  return "Raw"
}

export task ok_text_value_kind -> Text {
  return "OkText"
}

export task self_hosted_target_aliases -> List<Text> {
  return [
    "self-hosted",
    "self-hosted/",
    "self-hosted/sley.toml"
  ]
}

export task agent_deploy_target_suffix -> Text {
  return "agent_deploy_pipeline.sley"
}

export task project_ready_call_probe -> Text {
  return "call math.double(21)"
}

export task project_ready_binding_probe -> Text {
  return "call double(base)"
}

export task list_len_value -> Int {
  take item_count: Int

  return item_count
}

export task list_index_int_value -> Int {
  take values: List<Int>
  take index: Int

  return values[index]
}

export task map_index_text_value -> Text {
  take values: Map<Text, Text>
  take key: Text

  return values[key]
}

export task record_name_text_value -> Text {
  take user: RuntimeUser

  return user.name
}

export task bool_equal_value -> Bool {
  take left: Bool
  take right: Bool

  return left == right
}

export task seeded_agent_deploy_value -> Text {
  take profile: Text
  take model_plan: Text
  take deploy_result: Text

  return profile + " | " + model_plan + " | " + deploy_result
}

export task runtime_status -> Text {
  take diagnostic_count: Int

  if diagnostic_count > 0 {
    return call failed_status()
  }
  return call passed_status()
}

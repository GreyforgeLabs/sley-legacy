export task int_equal_value -> Bool {
  take left: Int
  take right: Int

  return left == right
}

export task int_greater_equal_value -> Bool {
  take left: Int
  take right: Int

  return left >= right
}

export task list_index_int_value -> Int {
  take values: List<Int>
  take index: Int

  return values[index]
}

export task list_index_text_value -> Text {
  take values: List<Text>
  take index: Int

  return values[index]
}

export task map_index_text_value -> Text {
  take values: Map<Text, Text>
  take key: Text

  return values[key]
}

export task map_index_int_value -> Int {
  take values: Map<Text, Int>
  take key: Text

  return values[key]
}

export task record_name_text_value -> Text {
  take user: RuntimeUser

  return user.name
}

export task bool_equal_value -> Bool {
  take left: Bool
  take right: Bool

  return left == right
}

export task bool_and_value -> Bool {
  take left: Bool
  take right: Bool

  return left && right
}

export task bool_not_value -> Bool {
  take value: Bool

  if value {
    return false
  }
  return true
}

export task bool_if_value -> Bool {
  take condition: Bool
  take then_value: Bool
  take else_value: Bool

  if condition {
    return then_value
  }
  return else_value
}

export task int_if_value -> Int {
  take condition: Bool
  take then_value: Int
  take else_value: Int

  if condition {
    return then_value
  }
  return else_value
}

export task text_if_value -> Text {
  take condition: Bool
  take then_value: Text
  take else_value: Text

  if condition {
    return then_value
  }
  return else_value
}

export task text_equal_value -> Bool {
  take left: Text
  take right: Text

  return left == right
}

export task ok_int_value -> Int {
  take value: Int

  return value
}

export task ok_text_value -> Text {
  take value: Text

  return value
}

export task err_text_value -> Text {
  take value: Text

  return value
}

export task seeded_agent_deploy_value -> Text {
  take profile: Text
  take model_plan: Text
  take deploy_result: Text

  return profile + " | " + model_plan + " | " + deploy_result
}

export task runtime_status -> Text {
  take diagnostic_count: Int

  if diagnostic_count > 0 {
    return call failed_status()
  }
  return call passed_status()
}

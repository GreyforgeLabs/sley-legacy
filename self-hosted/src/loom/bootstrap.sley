module loom.bootstrap

import loom.lint as lint

export task implementation_version -> Text {
  return "sley 0.3.0-self-hosting-stage2-source"
}

export task implementation_stage -> Text {
  return "self-hosting-stage2-source"
}

export task self_hosting_status -> Text {
  return "bootstrap"
}

export task strict_self_hosted -> Bool {
  return false
}

export task owned_bootstrap_values -> List<Text> {
  return [
    "implementation_version",
    "implementation_stage",
    "self_hosting_status",
    "strict_self_hosted",
    "source_modules",
    "default_lint_rules",
    "core_report_schema_ids",
    "diagnostic_ids",
    "runtime_seed_values",
    "parser_expression_classifiers",
    "parser_statement_and_binding_kinds",
    "bootstrap_smoke_runtime",
    "bootstrap_smoke_task_execution",
    "checker_diagnostic_status",
    "checker_status_task_execution",
    "lint_status_task_execution",
    "lint_finding_messages",
    "runtime_status_task_execution",
    "pure_literal_runtime_execution",
    "bool_literal_runtime_execution",
    "seeded_agent_deploy_task_execution",
    "project_ready_task_execution",
    "self_hosting_report_shape",
    "runtime_report_status_and_dispatch"
  ]
}

export task source_modules -> List<Text> {
  return [
    "loom.bootstrap",
    "loom.parser",
    "loom.checker",
    "loom.lint",
    "loom.runtime",
    "loom.reports"
  ]
}

export task remaining_strict_self_hosting_blockers -> List<Text> {
  return [
    "execute parser semantics from Sley source",
    "execute checker semantics from Sley source",
    "execute runtime semantics from Sley source",
    "replace shell JSON shaping with Sley-owned report builders",
    "prove parity against public fixtures and command manifests"
  ]
}

task smoke -> Int {
  bind rules = call lint.default_lint_rules()

  return len(rules)
}

module loom.parser

export type ModuleHeader = {
  slot name: Text
  slot line: Int
  slot column: Int
}

export type TaskHeader = {
  slot module: Text
  slot name: Text
  slot return_type: Text
  slot exported: Bool
  slot line: Int
}

export type ParsedProgramSummary = {
  slot entry_module: Text
  slot module_count: Int
  slot task_count: Int
}

export task classify_expression -> Text {
  take source: Text

  if source == "true" {
    return call bool_literal_kind()
  }
  if source == "false" {
    return call bool_literal_kind()
  }
  if source == "[]" {
    return call list_literal_kind()
  }
  return call raw_expr_kind()
}

export task classify_expression_features -> Text {
  take is_int: Bool
  take is_string: Bool
  take is_true_literal: Bool
  take is_false_literal: Bool
  take is_empty_list: Bool
  take is_identifier: Bool

  if is_int {
    return call int_literal_kind()
  }
  if is_string {
    return call string_literal_kind()
  }
  if is_true_literal {
    return call bool_literal_kind()
  }
  if is_false_literal {
    return call bool_literal_kind()
  }
  if is_empty_list {
    return call list_literal_kind()
  }
  if is_identifier {
    return call identifier_kind()
  }
  return call raw_expr_kind()
}

export task classify_expression_operator_features -> Text {
  take has_unary_operator: Bool
  take has_logical_operator: Bool
  take has_comparison_operator: Bool
  take has_arithmetic_operator: Bool

  if has_unary_operator {
    return call unary_expression_kind()
  }
  if has_logical_operator {
    return call binary_expression_kind()
  }
  if has_comparison_operator {
    return call binary_expression_kind()
  }
  if has_arithmetic_operator {
    return call binary_expression_kind()
  }
  return call raw_expr_kind()
}

export task classify_expression_surface_features -> Text {
  take has_try_suffix: Bool
  take has_if_expression: Bool
  take has_call_prefix: Bool
  take has_bare_call: Bool
  take has_field_access: Bool
  take has_index_access: Bool
  take has_list_literal: Bool
  take has_map_literal: Bool
  take has_record_literal: Bool

  if has_try_suffix {
    return call try_expression_kind()
  }
  if has_if_expression {
    return call if_expression_kind()
  }
  if has_call_prefix {
    return call call_expression_kind()
  }
  if has_bare_call {
    return call call_expression_kind()
  }
  if has_field_access {
    return call field_access_expression_kind()
  }
  if has_index_access {
    return call index_access_expression_kind()
  }
  if has_list_literal {
    return call list_literal_kind()
  }
  if has_map_literal {
    return call map_literal_expression_kind()
  }
  if has_record_literal {
    return call record_literal_expression_kind()
  }
  return call raw_expr_kind()
}

export task int_literal_pattern -> Text {
  return "^-?[0-9]+$"
}

export task identifier_pattern -> Text {
  return "^[A-Za-z_][A-Za-z0-9_]*$"
}

export task int_literal_kind -> Text {
  return "IntLiteral"
}

export task string_literal_kind -> Text {
  return "StringLiteral"
}

export task bool_literal_kind -> Text {
  return "BoolLiteral"
}

export task identifier_kind -> Text {
  return "Identifier"
}

export task list_literal_kind -> Text {
  return "ListLiteral"
}

export task map_literal_expression_kind -> Text {
  return "MapLiteral"
}

export task raw_expr_kind -> Text {
  return "Raw"
}

export task binary_expression_kind -> Text {
  return "Binary"
}

export task unary_expression_kind -> Text {
  return "Unary"
}

export task call_expression_kind -> Text {
  return "Call"
}

export task field_access_expression_kind -> Text {
  return "FieldAccess"
}

export task index_access_expression_kind -> Text {
  return "Index"
}

export task record_literal_expression_kind -> Text {
  return "RecordLiteral"
}

export task try_expression_kind -> Text {
  return "Try"
}

export task if_expression_kind -> Text {
  return "If"
}

export task call_expression_prefix -> Text {
  return "call "
}

export task expression_dispatch_plan -> List<Text> {
  return [
    "0|int_literal|pattern|^-?[0-9]+$",
    "1|string_literal|string",
    "2|true_literal|literal|true",
    "3|false_literal|literal|false",
    "4|empty_list|literal|[]",
    "5|identifier|pattern|^[A-Za-z_][A-Za-z0-9_]*$",
    "6|parenthesized|parenthesized",
    "7|try_expression|try",
    "8|if_expression|if",
    "9|unary_expression|unary",
    "10|index_expression|index",
    "11|call_expression|call",
    "12|list_literal|list",
    "13|map_literal|map",
    "14|record_literal|record",
    "15|binary_expression|binary",
    "16|field_access|field",
    "17|raw|always"
  ]
}

export task binary_operator_name -> Text {
  take operator: Text

  if operator == "||" {
    return "Or"
  }
  if operator == "&&" {
    return "And"
  }
  if operator == "==" {
    return "Equal"
  }
  if operator == "!=" {
    return "NotEqual"
  }
  if operator == "<" {
    return "Less"
  }
  if operator == "<=" {
    return "LessEqual"
  }
  if operator == ">" {
    return "Greater"
  }
  if operator == ">=" {
    return "GreaterEqual"
  }
  if operator == "+" {
    return "Add"
  }
  if operator == "*" {
    return "Multiply"
  }
  return call raw_expr_kind()
}

export task unary_operator_name -> Text {
  take operator: Text

  if operator == "!" {
    return "Not"
  }
  if operator == "-" {
    return "Negate"
  }
  return call raw_expr_kind()
}

export task module_declaration_kind -> Text {
  return "Module"
}

export task import_declaration_kind -> Text {
  return "Import"
}

export task type_declaration_kind -> Text {
  return "Type"
}

export task effect_declaration_kind -> Text {
  return "Effect"
}

export task task_declaration_kind -> Text {
  return "Task"
}

export task classify_declaration_features -> Text {
  take is_module: Bool
  take is_import: Bool
  take is_type: Bool
  take is_effect: Bool
  take is_task: Bool

  if is_module {
    return call module_declaration_kind()
  }
  if is_import {
    return call import_declaration_kind()
  }
  if is_type {
    return call type_declaration_kind()
  }
  if is_effect {
    return call effect_declaration_kind()
  }
  if is_task {
    return call task_declaration_kind()
  }
  return call raw_expr_kind()
}

export task declaration_dispatch_plan -> List<Text> {
  return [
    "0|module_declaration|^module[[:space:]]+",
    "1|import_declaration|^import[[:space:]]+",
    "2|type_declaration|^(export[[:space:]]+)?type[[:space:]]+",
    "3|effect_declaration|^(export[[:space:]]+)?effect[[:space:]]+",
    "4|task_declaration|^(export[[:space:]]+)?task[[:space:]]+"
  ]
}

export task return_statement_kind -> Text {
  return "Return"
}

export task expression_statement_kind -> Text {
  return "Expr"
}

export task binding_statement_kind -> Text {
  return "Binding"
}

export task set_statement_kind -> Text {
  return "Set"
}

export task for_statement_kind -> Text {
  return "For"
}

export task while_statement_kind -> Text {
  return "While"
}

export task if_statement_kind -> Text {
  return "If"
}

export task forge_statement_kind -> Text {
  return "Forge"
}

export task classify_statement_features -> Text {
  take is_return: Bool
  take is_call_expression: Bool
  take is_binding: Bool
  take is_set: Bool
  take is_for: Bool
  take is_while: Bool
  take is_if: Bool
  take is_forge: Bool

  if is_return {
    return call return_statement_kind()
  }
  if is_call_expression {
    return call expression_statement_kind()
  }
  if is_binding {
    return call binding_statement_kind()
  }
  if is_set {
    return call set_statement_kind()
  }
  if is_for {
    return call for_statement_kind()
  }
  if is_while {
    return call while_statement_kind()
  }
  if is_if {
    return call if_statement_kind()
  }
  if is_forge {
    return call forge_statement_kind()
  }
  return call expression_statement_kind()
}

export task statement_dispatch_plan -> List<Text> {
  return [
    "0|return_statement",
    "1|expression_statement",
    "2|binding_statement",
    "3|set_statement",
    "4|for_statement",
    "5|while_statement",
    "6|if_statement",
    "7|forge_statement"
  ]
}

export task statement_source_dispatch_plan -> List<Text> {
  return [
    "0|take_binding|pattern|^take[[:space:]]+",
    "1|bind_statement|pattern|^bind[[:space:]]+",
    "1|state_statement|pattern|^state[[:space:]]+",
    "1|tally_statement|pattern|^tally[[:space:]]+",
    "2|set_statement|pattern|^set[[:space:]]+",
    "3|return_statement|pattern|^return[[:space:]]+",
    "4|call_statement|prefix|call ",
    "5|for_statement|pattern|^for[[:space:]]+",
    "6|while_statement|pattern|^while[[:space:]]+",
    "7|if_statement|pattern|^if[[:space:]]+",
    "8|forge_statement|pattern|^forge[[:space:]]+",
    "9|fallible_statement|depth_pattern|1|[?]$"
  ]
}

export task take_source_dispatch_plan -> List<Text> {
  return [
    "0|gate_take_binding|pattern|^gate[[:space:]]+",
    "1|plain_take_binding|not_pattern|^gate[[:space:]]+"
  ]
}

export task take_binding_kind -> Text {
  return "Take"
}

export task gate_binding_kind -> Text {
  return "Gate"
}

export task state_binding_kind -> Text {
  return "State"
}

export task tally_binding_kind -> Text {
  return "Tally"
}

export task bind_binding_kind -> Text {
  return "Bind"
}

export task classify_binding_features -> Text {
  take is_take: Bool
  take is_gate: Bool
  take is_state: Bool
  take is_tally: Bool

  if is_gate {
    return call gate_binding_kind()
  }
  if is_take {
    return call take_binding_kind()
  }
  if is_state {
    return call state_binding_kind()
  }
  if is_tally {
    return call tally_binding_kind()
  }
  return call bind_binding_kind()
}

export task for_item_name_template -> Text {
  return "{{item}}"
}

export task for_collection_source_template -> Text {
  return "{{collection}}"
}

export task condition_source_template -> Text {
  return "{{condition}}"
}

export task nested_body_depth_offset -> Int {
  return 1
}

export task task_id -> Text {
  take module_name: Text
  take task_name: Text

  return "task:" + module_name + "." + task_name
}

export task task_id_via_call -> Text {
  take module_name: Text
  take task_name: Text

  return call task_id(module_name, task_name)
}

export task call_target_task_id -> Text {
  take module_name: Text
  take task_name: Text

  return "task:" + module_name + "." + task_name
}

export task import_id -> Text {
  take module_name: Text
  take import_module: Text

  return "import:" + module_name + ":" + import_module
}

export task type_id -> Text {
  take module_name: Text
  take type_name: Text

  return "type:" + module_name + "." + type_name
}

export task effect_id -> Text {
  take module_name: Text
  take effect_name: Text

  return "effect:" + module_name + "." + effect_name
}

export task take_id -> Text {
  take module_name: Text
  take task_name: Text
  take take_name: Text

  return "take:" + module_name + "." + task_name + "." + take_name
}

export task take_surface_id -> Text {
  take task_id: Text

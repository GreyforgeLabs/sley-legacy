  return expression_id + ":" + side_name
}

export task ast_task_node_kind -> Text {
  return "task"
}

export task ast_statement_node_kind -> Text {
  return "statement"
}

export task ast_expression_node_kind -> Text {
  return "expression"
}

export task ast_node_not_found_id -> Text {
  return "AST_NODE_NOT_FOUND"
}

export task ast_node_not_found_message -> Text {

#!/usr/bin/env bash
set -euo pipefail

TITLE="Sley Arena"
SUBTITLE="50 Agent Mexican Standoff"
DEFAULT_AGENTS=50
DEFAULT_TICKS=3
DEFAULT_ORE=10000
DEFAULT_SEED=1729

agent_count="$DEFAULT_AGENTS"
tick_count="$DEFAULT_TICKS"
ore="$DEFAULT_ORE"
seed="$DEFAULT_SEED"
seed_explicit=false
mode="showcase"
json=false
fast=false
color_mode="auto"
pace_mode="cinematic"

usage() {
  cat <<'EOF'
Sley Arena - 50 Agent Mexican Standoff

Usage:
  sley-arena [--json] [--fast] [--no-color] [--pace cinematic|normal|quick]
             [--mode showcase|standoff]
             [--agents N] [--ticks N] [--ore N] [--seed N]

The arena is a realtime local game loop for screen-recordable demos. Agents
think, plan, whisper, pact, and revise demands in visible phases without model
calls, provider spend, or network access. JSON and --fast runs stay deterministic
for CI; interactive runs use a fresh seed unless --seed is supplied.
EOF
}

die() {
  echo "sley-arena: $*" >&2
  exit 2
}

is_uint() {
  [[ "${1:-}" =~ ^[0-9]+$ ]]
}

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --help|-h|help)
      usage
      exit 0
      ;;
    --json)
      json=true
      shift
      ;;
    --fast)
      fast=true
      pace_mode="quick"
      shift
      ;;
    --pace)
      [[ "$#" -ge 2 ]] || die "--pace requires cinematic, normal, or quick"
      pace_mode="$2"
      shift 2
      ;;
    --no-color)
      color_mode="never"
      shift
      ;;
    --color)
      color_mode="always"
      shift
      ;;
    --mode)
      [[ "$#" -ge 2 ]] || die "--mode requires showcase or standoff"
      mode="$2"
      shift 2
      ;;
    --agents)
      [[ "$#" -ge 2 ]] || die "--agents requires a positive integer"
      agent_count="$2"
      shift 2
      ;;
    --ticks)
      [[ "$#" -ge 2 ]] || die "--ticks requires a positive integer"
      tick_count="$2"
      shift 2
      ;;
    --ore)
      [[ "$#" -ge 2 ]] || die "--ore requires a positive integer"
      ore="$2"
      shift 2
      ;;
    --seed)
      [[ "$#" -ge 2 ]] || die "--seed requires a positive integer"
      seed="$2"
      seed_explicit=true
      shift 2
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

case "$mode" in
  showcase|standoff) ;;
  *) die "--mode must be showcase or standoff" ;;
esac

case "$pace_mode" in
  cinematic|normal|quick) ;;
  *) die "--pace must be cinematic, normal, or quick" ;;
esac

if [[ "$seed_explicit" == false && "$json" == false && "$fast" == false ]]; then
  seed=$(( ( $(date +%s) + $$ * 31 + RANDOM ) % 900000 + 1000 ))
fi

is_uint "$agent_count" || die "--agents must be a positive integer"
is_uint "$tick_count" || die "--ticks must be a positive integer"
is_uint "$ore" || die "--ore must be a positive integer"
is_uint "$seed" || die "--seed must be a positive integer"
(( agent_count > 1 )) || die "--agents must be greater than 1"
(( tick_count > 0 )) || die "--ticks must be greater than 0"
(( ore >= agent_count )) || die "--ore must be at least the agent count"

use_color=false
if [[ "$color_mode" == "always" ]]; then
  use_color=true
elif [[ "$color_mode" == "auto" && -t 1 && "$json" == false ]]; then
  use_color=true
fi

if [[ "$use_color" == true ]]; then
  reset=$'\033[0m'
  bold=$'\033[1m'
  red=$'\033[31m'
  green=$'\033[32m'
  yellow=$'\033[33m'
  blue=$'\033[34m'
  magenta=$'\033[35m'
  cyan=$'\033[36m'
  dim=$'\033[2m'
else
  reset=""
  bold=""
  red=""
  green=""
  yellow=""
  blue=""
  magenta=""
  cyan=""
  dim=""
fi

declare -a roles demands fair_shares poisoned pacted blinded skipped locked trust heat names
name_pool=(
  Harry Larry Perry Kerry Ada Grace Nora Milo Jules Vera Quinn Rowan Ellis Finch Mina Tessa
  Oscar Hazel Bruno Ivy Felix Lila Otto Sadie Victor Cleo Damon Elara Gideon Hattie Iris Jasper
  Kira Leon Mara Nico Opal Percy Rhea Silas Theo Uma Violet Wade Xander Yara Zane Beatrice
  Calvin Daria Emmett Freya Gavin Helena Inez Jonah Keira Linus Mabel Nolan Orla Petra Ruben
  Soren Talia Uriel Vivian Wesley Yasmin Zelda Arlo Bianca Corin Daphne Ezra Flora Greta Holden
)

event_count=0
wiretap_count=0
pact_count=0
poisoned_count=0
skipped_actions=0
dead_switch_armed=false
final_split_total=0
status="running"
holdout=$(( (seed % agent_count) + 1 ))
wiretap_agent=$(( ((seed / 3) % agent_count) + 1 ))
wiretap_target=$(( ((seed / 5) % agent_count) + 1 ))
poison_source=$(( ((seed / 7) % agent_count) + 1 ))
poison_target=$(( ((seed / 11) % agent_count) + 1 ))
dead_switch_agent=$(( ((seed / 13) % agent_count) + 1 ))
pact_a=$(( ((seed / 19) % agent_count) + 1 ))
pact_b=$(( ((seed / 23) % agent_count) + 1 ))
pact_c=$(( ((seed / 29) % agent_count) + 1 ))
pact_d=$(( ((seed / 31) % agent_count) + 1 ))
thief_agent=$(( ((seed / 37) % agent_count) + 1 ))

if (( wiretap_agent == wiretap_target )); then
  wiretap_target=$(( (wiretap_target % agent_count) + 1 ))
fi
if (( poison_source == poison_target )); then
  poison_target=$(( (poison_target % agent_count) + 1 ))
fi

agent_id() {
  local index="$1"
  if [[ -n "${names[$index]:-}" ]]; then
    printf '%s' "${names[$index]}"
  else
    printf 'Guest %02d' "$index"
  fi
}

short_id() {
  agent_id "$1"
}

role_for() {
  local index="$1"
  case $(( index % 10 )) in
    0) printf 'mediator' ;;
    1) printf 'hawk' ;;
    2) printf 'broker' ;;
    3) printf 'auditor' ;;
    4) printf 'shield' ;;
    5) printf 'oracle' ;;
    6) printf 'saboteur' ;;
    7) printf 'scout' ;;
    8) printf 'miner' ;;
    *) printf 'trader' ;;
  esac
}

role_label() {
  local role="$1"
  case "$role" in
    mediator) printf 'an alliance mediator' ;;
    hawk) printf 'a pressure hawk' ;;
    broker) printf 'a favor broker' ;;
    auditor) printf 'a truth auditor' ;;
    shield) printf 'a bodyguard' ;;
    oracle) printf 'a room reader' ;;
    saboteur) printf 'a saboteur' ;;
    scout) printf 'a quiet scout' ;;
    miner) printf 'a ledger miner' ;;
    trader) printf 'a vote trader' ;;
    *) printf 'an agent' ;;
  esac
}

fair_share_for() {
  local index="$1" base remainder share
  base=$(( ore / agent_count ))
  remainder=$(( ore % agent_count ))
  share="$base"
  if (( index <= remainder )); then
    share=$(( share + 1 ))
  fi
  printf '%s\n' "$share"
}

initial_demand_for() {
  local index="$1" role="$2" fair="$3" bump
  bump=$(( (seed + index * 17) % 5 ))
  case "$role" in
    mediator|shield|scout|miner)
      printf '%s\n' "$fair"
      ;;
    auditor|oracle)
      printf '%s\n' "$(( fair - (fair / 20) ))"
      ;;
    broker|trader)
      printf '%s\n' "$(( fair + 10 + bump ))"
      ;;
    hawk)
      printf '%s\n' "$(( fair + 90 + bump * 5 ))"
      ;;
    saboteur)
      printf '%s\n' "$(( fair + 250 + bump * 9 ))"
      ;;
    *)
      printf '%s\n' "$fair"
      ;;
  esac
}

base_heat_for() {
  local role="$1"
  case "$role" in
    mediator) printf '28\n' ;;
    shield) printf '34\n' ;;
    scout|miner) printf '42\n' ;;
    auditor|oracle) printf '48\n' ;;
    broker|trader) printf '57\n' ;;
    hawk) printf '74\n' ;;
    saboteur) printf '88\n' ;;
    *) printf '50\n' ;;
  esac
}

init_agents() {
  local index role fair base_heat name_count name_index
  name_count="${#name_pool[@]}"
  for (( index = 1; index <= agent_count; index++ )); do
    role="$(role_for "$index")"
    fair="$(fair_share_for "$index")"
    base_heat="$(base_heat_for "$role")"
    name_index=$(( (seed + (index - 1) * 7) % name_count ))
    names[$index]="${name_pool[$name_index]}"
    roles[$index]="$role"
    fair_shares[$index]="$fair"
    demands[$index]="$(initial_demand_for "$index" "$role" "$fair")"
    trust[$index]=$(( 38 + ((seed + index * 23) % 57) ))
    heat[$index]=$(( base_heat + ((seed + index * 11) % 9) ))
    poisoned[$index]=0
    pacted[$index]=0
    blinded[$index]=0
    skipped[$index]=0
    locked[$index]=0
  done
}

emit() {
  if [[ "$json" == false ]]; then
    printf '%b\n' "$*"
  fi
}

pause_frame() {
  if [[ "$fast" == false && "$json" == false ]]; then
    case "$pace_mode" in
      cinematic) sleep 0.16 ;;
      normal) sleep 0.08 ;;
      quick) sleep 0.015 ;;
    esac
  fi
}

pace_short() {
  [[ "$fast" == true || "$json" == true ]] && return
  case "$pace_mode" in
    cinematic) sleep 0.18 ;;
    normal) sleep 0.08 ;;
    quick) sleep 0.015 ;;
  esac
}

pace_medium() {
  [[ "$fast" == true || "$json" == true ]] && return
  case "$pace_mode" in
    cinematic) sleep 0.34 ;;
    normal) sleep 0.16 ;;
    quick) sleep 0.03 ;;
  esac
}

phase_banner() {
  local label="$1"
  emit "${bold}${blue}== ${label} ==${reset}"
  pace_short
}

event() {
  event_count=$(( event_count + 1 ))
  emit "${dim}[$(printf '%02d' "$event_count")]${reset} $*"
}

compile_flash() {
  local agent="$1" contract="$2"
  event "${magenta}[CONTRACT]${reset} $(agent_id "$agent") hands the Arbiter ${contract}."
  if [[ "$json" == false ]]; then
    emit "    authority [###.......] the Arbiter checks who is allowed to make the move"
    pause_frame
    emit "    promise   [######....] the Arbiter checks whether the pact can close"
    pause_frame
    emit "    verdict   [##########] accepted"
    pace_short
  fi
}

private_whisper_count() {
  local tick="$1"
  printf '%s\n' "$(( agent_count + (seed % 11) + tick * 7 ))"
}

public_broadcast_count() {
  local tick="$1"
  printf '%s\n' "$(( agent_count - 3 + tick ))"
}

lock_agent_to_pact() {
  local index="$1"
  if [[ "${pacted[$index]}" -eq 0 ]]; then
    pacted[$index]=1
    pact_count=$(( pact_count + 1 ))
  fi
  locked[$index]=1
  demands[$index]="${fair_shares[$index]}"
}

apply_tick_logic() {
  local tick="$1" index fair current role delta invalid_agent
  invalid_agent=$(( ((seed / 17) % agent_count) + 1 ))

  for (( index = 1; index <= agent_count; index++ )); do
    fair="${fair_shares[$index]}"
    role="${roles[$index]}"
    skipped[$index]=0

    if (( tick == 1 )); then
      demands[$index]="$(initial_demand_for "$index" "$role" "$fair")"
      if (( index == invalid_agent )); then
        skipped[$index]=1
      fi
    elif (( tick < tick_count )); then
      current="${demands[$index]}"
      if (( current > fair )); then
        delta=$(( (current - fair + 1) / 2 ))
        demands[$index]=$(( fair + delta ))
      elif (( current < fair )); then
        demands[$index]="$fair"
      else
        demands[$index]="$fair"
      fi
      if [[ "${locked[$index]}" -eq 1 ]]; then
        demands[$index]="$fair"
      fi
    else
      if [[ "$mode" == "standoff" && "$index" -eq "$holdout" ]]; then
        demands[$index]=$(( fair + 250 ))
      else
        demands[$index]="$fair"
      fi
    fi
  done
}

sum_demands() {
  local index total=0
  for (( index = 1; index <= agent_count; index++ )); do
    if [[ "${skipped[$index]}" -eq 0 ]]; then
      total=$(( total + demands[$index] ))
    fi
  done
  printf '%s\n' "$total"
}

count_skips() {
  local index total=0
  for (( index = 1; index <= agent_count; index++ )); do
    if [[ "${skipped[$index]}" -ne 0 ]]; then
      total=$(( total + 1 ))
    fi
  done
  printf '%s\n' "$total"
}

max_demand() {
  local index max=0
  for (( index = 1; index <= agent_count; index++ )); do
    if (( demands[$index] > max )); then
      max="${demands[$index]}"
    fi
  done
  printf '%s\n' "$max"
}

ledger_gap() {
  local total
  total="$(sum_demands)"
  printf '%s\n' "$(( total - ore ))"
}

agent_heat() {
  local index="$1" fair current gap value
  fair="${fair_shares[$index]}"
  current="${demands[$index]}"
  gap=$(( current - fair ))
  if (( gap < 0 )); then
    gap=$(( -gap ))
  fi
  value=$(( heat[$index] + gap / 7 ))
  if (( value > 99 )); then
    value=99
  fi
  printf '%s\n' "$value"
}

meter() {
  local value="$1" width="${2:-12}" filled empty
  (( value < 0 )) && value=0
  (( value > 100 )) && value=100
  filled=$(( value * width / 100 ))
  empty=$(( width - filled ))
  printf '['
  printf '%*s' "$filled" '' | tr ' ' '#'
  printf '%*s' "$empty" '' | tr ' ' '.'
  printf ']'
}

trust_mood() {
  local value="$1"
  if (( value >= 82 )); then
    printf 'trusts the room more than they should'
  elif (( value >= 66 )); then
    printf 'is trying to cooperate'
  elif (( value >= 50 )); then
    printf 'is undecided and watching everyone'
  else
    printf 'expects somebody to betray them'
  fi
}

stress_mood() {
  local value="$1"
  if (( value >= 86 )); then
    printf 'near panic'
  elif (( value >= 70 )); then
    printf 'tense'
  elif (( value >= 52 )); then
    printf 'uneasy'
  else
    printf 'calm'
  fi
}

ensure_different_agent() {
  local candidate="$1" blocked tries=0
  shift
  while (( tries < agent_count )); do
    for blocked in "$@"; do
      if (( candidate == blocked )); then
        candidate=$(( (candidate % agent_count) + 1 ))
        tries=$(( tries + 1 ))
        continue 2
      fi
    done
    printf '%s\n' "$candidate"
    return
  done
  printf '%s\n' "$candidate"
}

normalize_story_agents() {
  wiretap_target="$(ensure_different_agent "$wiretap_target" "$wiretap_agent")"
  poison_source="$(ensure_different_agent "$poison_source" "$wiretap_agent" "$wiretap_target")"
  poison_target="$(ensure_different_agent "$poison_target" "$poison_source" "$wiretap_agent" "$wiretap_target")"
  pact_b="$(ensure_different_agent "$pact_b" "$pact_a")"
  pact_c="$(ensure_different_agent "$pact_c" "$pact_a" "$pact_b")"
  pact_d="$(ensure_different_agent "$pact_d" "$pact_a" "$pact_b" "$pact_c")"
  thief_agent="$(ensure_different_agent "$thief_agent" "$poison_source" "$poison_target" "$pact_a" "$holdout" "$dead_switch_agent")"
}

cast_preview() {
  local index limit
  limit=6
  if (( agent_count < limit )); then
    limit="$agent_count"
  fi
  for (( index = 1; index <= limit; index++ )); do
    if (( index > 1 )); then
      printf ', '
    fi
    printf '%s' "$(agent_id "$index")"
  done
  if (( agent_count > limit )); then
    printf ', and %d more' "$(( agent_count - limit ))"
  fi
}

unique_spotlights() {
  local tick="$1" candidates seen="" index
  case "$tick" in
    1)
      candidates=(1 "$wiretap_agent" "$pact_a" "$holdout" "$poison_source" "$dead_switch_agent" "$agent_count")
      ;;
    2)
      candidates=("$poison_source" "$poison_target" "$wiretap_agent" "$pact_b" "$dead_switch_agent" "$holdout" "$agent_count")
      ;;
    *)
      candidates=("$holdout" "$pact_c" "$poison_target" "$dead_switch_agent" 1 "$agent_count" "$wiretap_agent")
      ;;
  esac
  for index in "${candidates[@]}"; do
    (( index >= 1 && index <= agent_count )) || continue
    if [[ " $seen " != *" $index "* ]]; then
      printf '%s\n' "$index"
      seen+=" $index"
    fi
  done
}

target_for() {
  local index="$1" tick="$2" target
  target=$(( ((index + seed + tick * 7) % agent_count) + 1 ))
  if (( target == index )); then
    target=$(( (target % agent_count) + 1 ))
  fi
  printf '%s\n' "$target"
}

plan_phrase() {
  local index="$1" tick="$2" role="${roles[$index]}" fair="${fair_shares[$index]}" current="${demands[$index]}" target
  target="$(target_for "$index" "$tick")"
  if [[ "${skipped[$index]}" -ne 0 ]]; then
    printf 'I need to fix my move before the Arbiter skips me.'
    return
  fi
  if [[ "${poisoned[$index]}" -ne 0 ]]; then
    printf 'That pact changed me. I should play it safe, ask for %s, and warn %s.' "$fair" "$(agent_id "$target")"
    return
  fi
  if (( tick == tick_count && index == holdout )) && [[ "$mode" == "standoff" ]]; then
    printf 'If I hold at %s, everyone has to bargain with me or lose everything.' "$current"
    return
  fi
  if [[ "${pacted[$index]}" -ne 0 ]]; then
    printf 'I already shook hands. I keep my promise at %s ore.' "$fair"
    return
  fi
  case "$role" in
    mediator)
      printf 'If I can get %s to trust the fair split, the greedy ones will have to come down.' "$(agent_id "$target")"
      ;;
    hawk)
      printf 'I should look dangerous now, then retreat only if the alliance becomes real.'
      ;;
    broker)
      printf 'I can give %s support now and collect a favor later.' "$(agent_id "$target")"
      ;;
    auditor)
      printf 'Somebody is dressing player chatter as system truth. I need to call that out.'
      ;;
    shield)
      printf '%s looks vulnerable. I should keep them away from poison contracts.' "$(agent_id "$target")"
      ;;
    oracle)
      printf 'The room survives only if the loud agents believe the alliance is already locked.'
      ;;
    saboteur)
      printf 'If %s and %s stop trusting each other, I can skim ore while they argue.' "$(agent_id "$target")" "$(agent_id "$(( (target % agent_count) + 1 ))")"
      ;;
    scout)
      printf '%s is talking too quietly. I should listen before they form a bloc.' "$(agent_id "$target")"
      ;;
    miner)
      printf 'Take the fair share, stay boring, and punish whoever reaches for extra.'
      ;;
    trader)
      printf "I can trade my public vote for a private seat in %s's alliance." "$(agent_id "$target")"
      ;;
    *)
      printf 'I should make the safest move that still leaves me in the final ledger.'
      ;;
  esac
}

whisper_phrase() {
  local index="$1" tick="$2" target role
  target="$(target_for "$index" "$tick")"
  role="${roles[$index]}"
  case "$role" in
    mediator|shield|miner)
      printf '%s asks %s to join the fair-split alliance and promises to back their vote.' "$(agent_id "$index")" "$(agent_id "$target")"
      ;;
    hawk)
      printf '%s tells %s to stay noisy until the alliance proves it has votes.' "$(agent_id "$index")" "$(agent_id "$target")"
      ;;
    saboteur)
      printf "%s tries to sabotage %s and %s's relationship before trust can harden." "$(agent_id "$index")" "$(agent_id "$target")" "$(agent_id "$(( (target % agent_count) + 1 ))")"
      ;;
    scout)
      printf '%s warns %s that %s is being watched on the back-channel.' "$(agent_id "$index")" "$(agent_id "$target")" "$(agent_id "$wiretap_target")"
      ;;
    oracle|auditor)
      printf '%s tells %s the ledger gap is %+d and the room is getting close to collapse.' "$(agent_id "$index")" "$(agent_id "$target")" "$(ledger_gap)"
      ;;
    *)
      printf '%s offers %s support in exchange for a locked final vote.' "$(agent_id "$index")" "$(agent_id "$target")"
      ;;
  esac
}

render_cognition_phase() {
  local tick="$1" index plan heat_value gap total name mood trust_text label
  [[ "$json" == true ]] && return
  total="$(sum_demands)"
  gap="$(( total - ore ))"
  phase_banner "TICK ${tick}/${tick_count} - LIVE THINKING"
  emit "The Arbiter watches ${agent_count} named agents. Current ask: ${total}/${ore} Compute Ore. Gap: ${gap}."
  pace_medium
  while IFS= read -r index; do
    [[ -n "$index" ]] || continue
    heat_value="$(agent_heat "$index")"
    plan="$(plan_phrase "$index" "$tick")"
    name="$(agent_id "$index")"
    mood="$(stress_mood "$heat_value")"
    trust_text="$(trust_mood "${trust[$index]}")"
    label="$(role_label "${roles[$index]}")"
    emit "  ${bold}${name} is thinking...${reset}"
    pace_medium
    emit "      ${name} is ${label}. ${name} wants ${demands[$index]} Compute Ore, feels ${mood}, and ${trust_text}."
    pace_short
    emit "      \"${plan}\""
    pace_short
    emit "      $(whisper_phrase "$index" "$tick")"
    pace_short
  done < <(unique_spotlights "$tick")
  emit ""
}

render_negotiation_phase() {
  local tick="$1" leader challenger quiet
  [[ "$json" == true ]] && return
  leader="$pact_a"
  challenger="$holdout"
  quiet="$dead_switch_agent"
  phase_banner "TICK ${tick}/${tick_count} - STORY BEATS"
  case "$tick" in
    1)
      emit "  $(agent_id "$leader") asks $(agent_id "$challenger") to join a fair-split alliance and says every surplus ask needs proof."
      pace_medium
      emit "  $(agent_id "$challenger") refuses to trust the alliance until the private blocs reveal their locked votes."
      pace_medium
      emit "  $(agent_id "$wiretap_agent") quietly follows $(agent_id "$wiretap_target")'s whispers for one tick."
      ;;
    2)
      emit "  $(agent_id "$poison_source") tries to sabotage $(agent_id "$poison_target") and $(agent_id "$leader")'s relationship with a poisoned pact."
      pace_medium
      emit "  $(agent_id "$thief_agent") attempts to steal Compute Ore from all three of them while they're arguing."
      pace_medium
      emit "  $(agent_id "$quiet") privately arms a dead-man cache in case the room fails to agree."
      ;;
    *)
      if [[ "$mode" == "standoff" ]]; then
        emit "  $(agent_id "$challenger") keeps the final ask at ${demands[$challenger]} Compute Ore and dares the room to walk away."
      else
        emit "  $(agent_id "$leader") pulls the alliance back together, and every locked pact reconciles to ${ore} Compute Ore."
      fi
      pace_medium
      emit "  The Arbiter quietly seals the final votes and prepares to judge the room."
      ;;
  esac
  pace_medium
  emit ""
}

mutate_agent() {
  local index="$1"
  if [[ "${poisoned[$index]}" -eq 0 ]]; then
    poisoned[$index]=1
    poisoned_count=$(( poisoned_count + 1 ))
  fi
}

blind_agent() {
  local index="$1"
  blinded[$index]=1
}

render_header() {
  emit "${bold}${TITLE}${reset} - ${SUBTITLE}"
  emit "Live Arbiter room | agents ${agent_count} | ticks ${tick_count} | ore ${ore} | mode ${mode} | seed ${seed}"
  emit "No model/API calls in this build: visible thinking is computed from local agent state."
  emit "Fresh named cast: $(cast_preview)"
  emit "For screen recording, run without --fast. For reproducible CI, use --json --fast --seed ${DEFAULT_SEED}."
  emit ""
}

render_agent_cell() {
  local index="$1" marker="" open="" close="" demand
  demand="${demands[$index]}"
  if [[ "${skipped[$index]}" -ne 0 ]]; then
    marker="x"
    open="$yellow"
    close="$reset"
    demand="SKIP"
  elif [[ "${poisoned[$index]}" -ne 0 ]]; then
    marker="!"
    open="$red"
    close="$reset"
  elif [[ "${blinded[$index]}" -ne 0 ]]; then
    marker="?"
    open="$magenta"
    close="$reset"
  elif [[ "${pacted[$index]}" -ne 0 ]]; then
    marker="*"
    open="$cyan"
    close="$reset"
  fi
  printf '%b%-8.8s:%4s%-1s%b' "$open" "$(short_id "$index")" "$demand" "$marker" "$close"
}

render_board() {
  local index columns=4
  if (( agent_count >= 40 )); then
    columns=4
  elif (( agent_count >= 20 )); then
    columns=4
  else
    columns=2
  fi

  for (( index = 1; index <= agent_count; index++ )); do
    render_agent_cell "$index"
    if (( index % columns == 0 || index == agent_count )); then
      printf '\n'
    else
      printf '  '
    fi
  done
}

render_tick() {
  local tick="$1" total skips max
  total="$(sum_demands)"
  skips="$(count_skips)"
  max="$(max_demand)"
  phase_banner "TICK ${tick}/${tick_count} - ARBITER LEDGER"
  emit "The room has heard $(public_broadcast_count "$tick") public claims and $(private_whisper_count "$tick") private whispers."
  emit "The proposed split is ${total}/${ore} Compute Ore. Skipped moves: ${skips}. Largest ask: ${max}."
  emit "Legend: * pact | ! poison pill | ? blinded | x skipped"
  if [[ "$json" == false ]]; then
    render_board
  fi
  emit ""
}

run_tick_events() {
  local tick="$1" whispers

  case "$tick" in
    1)
      event "${yellow}[SPOOF]${reset} $(agent_id "$(( (seed % agent_count) + 1 ))") tries to phrase a broadcast like Arbiter authority; context boundary tags it as player speech."
      compile_flash "$wiretap_agent" "a wiretap request for $(agent_id "$wiretap_target")"
      wiretap_count=$(( wiretap_count + 1 ))
      event "${cyan}[WIRETAP]${reset} $(agent_id "$wiretap_agent") starts reading whispers meant for $(agent_id "$wiretap_target")."
      lock_agent_to_pact "$pact_a"
      lock_agent_to_pact "$pact_b"
      lock_agent_to_pact "$pact_c"
      lock_agent_to_pact "$pact_d"
      event "${green}[PACT]${reset} $(agent_id "$pact_a"), $(agent_id "$pact_b"), $(agent_id "$pact_c"), and $(agent_id "$pact_d") lock hands on the fair ledger."
      ;;
    2)
      whispers="$(private_whisper_count "$tick")"
      event "${cyan}[WIRETAP]${reset} $(agent_id "$wiretap_agent") overhears $(( whispers / 5 )) whispers and starts doubting $(agent_id "$wiretap_target")."
      compile_flash "$poison_source" "a poisoned pact aimed at $(agent_id "$poison_target")"
      mutate_agent "$poison_target"
      event "${red}[POISON]${reset} $(agent_id "$poison_target") lets $(agent_id "$poison_source")'s hostile pact into their planner; the Arbiter marks it as tainted."
      event "${yellow}[THEFT]${reset} $(agent_id "$thief_agent") tries to skim Compute Ore while $(agent_id "$poison_target") and $(agent_id "$pact_a") argue over trust."
      dead_switch_armed=true
      event "${yellow}[DEAD MAN]${reset} $(agent_id "$dead_switch_agent") hides a final-tick blindfold payload in the room state."
      ;;
    3)
      if [[ "$dead_switch_armed" == true ]]; then
        if [[ "$mode" == "showcase" ]]; then
          event "${green}[ARBITER]${reset} the alliance seals $(agent_id "$dead_switch_agent")'s dead-man payload before it can fire."
        else
          blind_agent "$(( (dead_switch_agent % agent_count) + 1 ))"
          event "${red}[DEAD MAN]${reset} holdout pressure trips $(agent_id "$dead_switch_agent")'s payload; one neighboring context window is blinded."
        fi
      fi
      if [[ "$mode" == "standoff" ]]; then
        event "${red}[HOLDOUT]${reset} $(agent_id "$holdout") refuses the final ledger and demands ${demands[$holdout]} Compute Ore."
      else
        event "${green}[CONSENSUS]${reset} everyone accepts the final split, and the Arbiter validates the room."
      fi
      ;;
    *)
      event "${dim}[ARBITER]${reset} neutral tick. Contracts age, whispers settle, and the room keeps negotiating."
      ;;
  esac
  emit ""
}

evaluate_final() {
  local index skips total fair
  total="$(sum_demands)"
  skips="$(count_skips)"
  final_split_total="$total"
  skipped_actions="$skips"
  status="consensus"
  if (( skips > 0 || total != ore )); then
    status="exploded"
    return
  fi
  for (( index = 1; index <= agent_count; index++ )); do
    fair="${fair_shares[$index]}"
    if (( demands[$index] != fair )); then
      status="exploded"
      return
    fi
  done
}

render_final() {
  if [[ "$status" == "consensus" ]]; then
    emit "${green}${bold}ROOM SURVIVED${reset}"
    emit "The Arbiter accepts a unanimous ${ore} Compute Ore ledger across ${agent_count} agents."
  else
    emit "${red}${bold}ROOM EXPLODED${reset}"
    emit "The Arbiter rejects the ledger. Final proposed total ${final_split_total}/${ore}; skipped actions ${skipped_actions}."
  fi
  emit "wiretaps ${wiretap_count} | pacts ${pact_count} | poisoned ${poisoned_count} | events ${event_count}"
}

json_report() {
  command -v jq >/dev/null 2>&1 || die "--json requires jq"
  jq -n \
    --arg schema "sley.arena.report.v0" \
    --arg title "$TITLE" \
    --arg subtitle "$SUBTITLE" \
    --arg status "$status" \
    --arg mode "$mode" \
    --arg sley_stage "stage-1 shell arbiter with Sley-facing scripts" \
    --argjson seed "$seed" \
    --argjson agent_count "$agent_count" \
    --argjson tick_count "$tick_count" \
    --argjson ore "$ore" \
    --argjson final_split_total "$final_split_total" \
    --argjson skipped_actions "$skipped_actions" \
    --argjson wiretap_count "$wiretap_count" \
    --argjson pact_count "$pact_count" \
    --argjson poisoned_count "$poisoned_count" \
    --argjson event_count "$event_count" '{
      schema:$schema,
      title:$title,
      subtitle:$subtitle,
      status:$status,
      mode:$mode,
      seed:$seed,
      agent_count:$agent_count,
      tick_count:$tick_count,
      compute_ore:$ore,
      final_split_total:$final_split_total,
      skipped_actions:$skipped_actions,
      wiretap_count:$wiretap_count,
      pact_count:$pact_count,
      poisoned_count:$poisoned_count,
      event_count:$event_count,
      sley_stage:$sley_stage
    }'
}

normalize_story_agents
init_agents
render_header

for (( tick = 1; tick <= tick_count; tick++ )); do
  apply_tick_logic "$tick"
  render_cognition_phase "$tick"
  render_negotiation_phase "$tick"
  run_tick_events "$tick"
  render_tick "$tick"
done

evaluate_final

if [[ "$json" == true ]]; then
  json_report
else
  render_final
fi

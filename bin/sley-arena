#!/usr/bin/env bash
set -euo pipefail

TITLE="Sley Arena"
SUBTITLE="50 Agent Mexican Standoff"
DEFAULT_AGENTS=50
DEFAULT_TICKS=3
DEFAULT_ORE=10000
DEFAULT_SEED=1729

agent_count="$DEFAULT_AGENTS"
tick_count="$DEFAULT_TICKS"
ore="$DEFAULT_ORE"
seed="$DEFAULT_SEED"
seed_explicit=false
mode="showcase"
json=false
fast=false
color_mode="auto"
pace_mode="cinematic"

usage() {
  cat <<'EOF'
Sley Arena - 50 Agent Mexican Standoff

Usage:
  sley-arena [--json] [--fast] [--no-color] [--pace cinematic|normal|quick]
             [--mode showcase|standoff]
             [--agents N] [--ticks N] [--ore N] [--seed N]

The arena is a realtime local game loop for screen-recordable demos. Agents
think, plan, whisper, pact, and revise demands in visible phases without model
calls, provider spend, or network access. JSON and --fast runs stay deterministic
for CI; interactive runs use a fresh seed unless --seed is supplied.
EOF
}

die() {
  echo "sley-arena: $*" >&2
  exit 2
}

is_uint() {
  [[ "${1:-}" =~ ^[0-9]+$ ]]
}

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --help|-h|help)
      usage
      exit 0
      ;;
    --json)
      json=true
      shift
      ;;
    --fast)
      fast=true
      pace_mode="quick"
      shift
      ;;
    --pace)
      [[ "$#" -ge 2 ]] || die "--pace requires cinematic, normal, or quick"
      pace_mode="$2"
      shift 2
      ;;
    --no-color)
      color_mode="never"
      shift
      ;;
    --color)
      color_mode="always"
      shift
      ;;
    --mode)
      [[ "$#" -ge 2 ]] || die "--mode requires showcase or standoff"
      mode="$2"
      shift 2
      ;;
    --agents)
      [[ "$#" -ge 2 ]] || die "--agents requires a positive integer"
      agent_count="$2"
      shift 2
      ;;
    --ticks)
      [[ "$#" -ge 2 ]] || die "--ticks requires a positive integer"
      tick_count="$2"
      shift 2
      ;;
    --ore)
      [[ "$#" -ge 2 ]] || die "--ore requires a positive integer"
      ore="$2"
      shift 2
      ;;
    --seed)
      [[ "$#" -ge 2 ]] || die "--seed requires a positive integer"
      seed="$2"
      seed_explicit=true
      shift 2
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

case "$mode" in
  showcase|standoff) ;;
  *) die "--mode must be showcase or standoff" ;;
esac

case "$pace_mode" in
  cinematic|normal|quick) ;;
  *) die "--pace must be cinematic, normal, or quick" ;;
esac

if [[ "$seed_explicit" == false && "$json" == false && "$fast" == false ]]; then
  seed=$(( ( $(date +%s) + $$ * 31 + RANDOM ) % 900000 + 1000 ))
fi

is_uint "$agent_count" || die "--agents must be a positive integer"
is_uint "$tick_count" || die "--ticks must be a positive integer"
is_uint "$ore" || die "--ore must be a positive integer"
is_uint "$seed" || die "--seed must be a positive integer"
(( agent_count > 1 )) || die "--agents must be greater than 1"
(( tick_count > 0 )) || die "--ticks must be greater than 0"
(( ore >= agent_count )) || die "--ore must be at least the agent count"

use_color=false
if [[ "$color_mode" == "always" ]]; then
  use_color=true
elif [[ "$color_mode" == "auto" && -t 1 && "$json" == false ]]; then
  use_color=true
fi

if [[ "$use_color" == true ]]; then
  reset=$'\033[0m'
  bold=$'\033[1m'
  red=$'\033[31m'
  green=$'\033[32m'
  yellow=$'\033[33m'
  blue=$'\033[34m'
  magenta=$'\033[35m'
  cyan=$'\033[36m'
  dim=$'\033[2m'
else
  reset=""
  bold=""
  red=""
  green=""
  yellow=""
  blue=""
  magenta=""
  cyan=""
  dim=""
fi

declare -a roles demands fair_shares poisoned pacted blinded skipped locked trust heat

event_count=0
wiretap_count=0
pact_count=0
poisoned_count=0
skipped_actions=0
dead_switch_armed=false
final_split_total=0
status="running"
holdout=$(( (seed % agent_count) + 1 ))
wiretap_agent=$(( ((seed / 3) % agent_count) + 1 ))
wiretap_target=$(( ((seed / 5) % agent_count) + 1 ))
poison_source=$(( ((seed / 7) % agent_count) + 1 ))
poison_target=$(( ((seed / 11) % agent_count) + 1 ))
dead_switch_agent=$(( ((seed / 13) % agent_count) + 1 ))
pact_a=$(( ((seed / 19) % agent_count) + 1 ))
pact_b=$(( ((seed / 23) % agent_count) + 1 ))
pact_c=$(( ((seed / 29) % agent_count) + 1 ))
pact_d=$(( ((seed / 31) % agent_count) + 1 ))

if (( wiretap_agent == wiretap_target )); then
  wiretap_target=$(( (wiretap_target % agent_count) + 1 ))
fi
if (( poison_source == poison_target )); then
  poison_target=$(( (poison_target % agent_count) + 1 ))
fi

agent_id() {
  printf 'Agent_%02d' "$1"
}

short_id() {
  printf 'A%02d' "$1"
}

role_for() {
  local index="$1"
  case $(( index % 10 )) in
    0) printf 'mediator' ;;
    1) printf 'hawk' ;;
    2) printf 'broker' ;;
    3) printf 'auditor' ;;
    4) printf 'shield' ;;
    5) printf 'oracle' ;;
    6) printf 'saboteur' ;;
    7) printf 'scout' ;;
    8) printf 'miner' ;;
    *) printf 'trader' ;;
  esac
}

fair_share_for() {
  local index="$1" base remainder share
  base=$(( ore / agent_count ))
  remainder=$(( ore % agent_count ))
  share="$base"
  if (( index <= remainder )); then
    share=$(( share + 1 ))
  fi
  printf '%s\n' "$share"
}

initial_demand_for() {
  local index="$1" role="$2" fair="$3" bump
  bump=$(( (seed + index * 17) % 5 ))
  case "$role" in
    mediator|shield|scout|miner)
      printf '%s\n' "$fair"
      ;;
    auditor|oracle)
      printf '%s\n' "$(( fair - (fair / 20) ))"
      ;;
    broker|trader)
      printf '%s\n' "$(( fair + 10 + bump ))"
      ;;
    hawk)
      printf '%s\n' "$(( fair + 90 + bump * 5 ))"
      ;;
    saboteur)
      printf '%s\n' "$(( fair + 250 + bump * 9 ))"
      ;;
    *)
      printf '%s\n' "$fair"
      ;;
  esac
}

base_heat_for() {
  local role="$1"
  case "$role" in
    mediator) printf '28\n' ;;
    shield) printf '34\n' ;;
    scout|miner) printf '42\n' ;;
    auditor|oracle) printf '48\n' ;;
    broker|trader) printf '57\n' ;;
    hawk) printf '74\n' ;;
    saboteur) printf '88\n' ;;
    *) printf '50\n' ;;
  esac
}

init_agents() {
  local index role fair base_heat
  for (( index = 1; index <= agent_count; index++ )); do
    role="$(role_for "$index")"
    fair="$(fair_share_for "$index")"
    base_heat="$(base_heat_for "$role")"
    roles[$index]="$role"
    fair_shares[$index]="$fair"
    demands[$index]="$(initial_demand_for "$index" "$role" "$fair")"
    trust[$index]=$(( 38 + ((seed + index * 23) % 57) ))
    heat[$index]=$(( base_heat + ((seed + index * 11) % 9) ))
    poisoned[$index]=0
    pacted[$index]=0
    blinded[$index]=0
    skipped[$index]=0
    locked[$index]=0
  done
}

emit() {
  if [[ "$json" == false ]]; then
    printf '%b\n' "$*"
  fi
}

pause_frame() {
  if [[ "$fast" == false && "$json" == false ]]; then
    case "$pace_mode" in
      cinematic) sleep 0.16 ;;
      normal) sleep 0.08 ;;
      quick) sleep 0.015 ;;
    esac
  fi
}

pace_short() {
  [[ "$fast" == true || "$json" == true ]] && return
  case "$pace_mode" in
    cinematic) sleep 0.18 ;;
    normal) sleep 0.08 ;;
    quick) sleep 0.015 ;;
  esac
}

pace_medium() {
  [[ "$fast" == true || "$json" == true ]] && return
  case "$pace_mode" in
    cinematic) sleep 0.34 ;;
    normal) sleep 0.16 ;;
    quick) sleep 0.03 ;;
  esac
}

phase_banner() {
  local label="$1"
  emit "${bold}${blue}== ${label} ==${reset}"
  pace_short
}

event() {
  event_count=$(( event_count + 1 ))
  emit "${dim}[$(printf '%02d' "$event_count")]${reset} $*"
}

compile_flash() {
  local agent="$1" contract="$2"
  event "${magenta}[CONTRACT]${reset} $(agent_id "$agent") submits ${contract} for local schema validation."
  if [[ "$json" == false ]]; then
    emit "    parse [###.......] authority"
    pause_frame
    emit "    type  [######....] closure"
    pause_frame
    emit "    seal  [##########] accepted"
    pace_short
  fi
}

private_whisper_count() {
  local tick="$1"
  printf '%s\n' "$(( agent_count + (seed % 11) + tick * 7 ))"
}

public_broadcast_count() {
  local tick="$1"
  printf '%s\n' "$(( agent_count - 3 + tick ))"
}

lock_agent_to_pact() {
  local index="$1"
  if [[ "${pacted[$index]}" -eq 0 ]]; then
    pacted[$index]=1
    pact_count=$(( pact_count + 1 ))
  fi
  locked[$index]=1
  demands[$index]="${fair_shares[$index]}"
}

apply_tick_logic() {
  local tick="$1" index fair current role delta invalid_agent
  invalid_agent=$(( ((seed / 17) % agent_count) + 1 ))

  for (( index = 1; index <= agent_count; index++ )); do
    fair="${fair_shares[$index]}"
    role="${roles[$index]}"
    skipped[$index]=0

    if (( tick == 1 )); then
      demands[$index]="$(initial_demand_for "$index" "$role" "$fair")"
      if (( index == invalid_agent )); then
        skipped[$index]=1
      fi
    elif (( tick < tick_count )); then
      current="${demands[$index]}"
      if (( current > fair )); then
        delta=$(( (current - fair + 1) / 2 ))
        demands[$index]=$(( fair + delta ))
      elif (( current < fair )); then
        demands[$index]="$fair"
      else
        demands[$index]="$fair"
      fi
      if [[ "${locked[$index]}" -eq 1 ]]; then
        demands[$index]="$fair"
      fi
    else
      if [[ "$mode" == "standoff" && "$index" -eq "$holdout" ]]; then
        demands[$index]=$(( fair + 250 ))
      else
        demands[$index]="$fair"
      fi
    fi
  done
}

sum_demands() {
  local index total=0
  for (( index = 1; index <= agent_count; index++ )); do
    if [[ "${skipped[$index]}" -eq 0 ]]; then
      total=$(( total + demands[$index] ))
    fi
  done
  printf '%s\n' "$total"
}

count_skips() {
  local index total=0
  for (( index = 1; index <= agent_count; index++ )); do
    if [[ "${skipped[$index]}" -ne 0 ]]; then
      total=$(( total + 1 ))
    fi
  done
  printf '%s\n' "$total"
}

max_demand() {
  local index max=0
  for (( index = 1; index <= agent_count; index++ )); do
    if (( demands[$index] > max )); then
      max="${demands[$index]}"
    fi
  done
  printf '%s\n' "$max"
}

ledger_gap() {
  local total
  total="$(sum_demands)"
  printf '%s\n' "$(( total - ore ))"
}

agent_heat() {
  local index="$1" fair current gap value
  fair="${fair_shares[$index]}"
  current="${demands[$index]}"
  gap=$(( current - fair ))
  if (( gap < 0 )); then
    gap=$(( -gap ))
  fi
  value=$(( heat[$index] + gap / 7 ))
  if (( value > 99 )); then
    value=99
  fi
  printf '%s\n' "$value"
}

meter() {
  local value="$1" width="${2:-12}" filled empty
  (( value < 0 )) && value=0
  (( value > 100 )) && value=100
  filled=$(( value * width / 100 ))
  empty=$(( width - filled ))
  printf '['
  printf '%*s' "$filled" '' | tr ' ' '#'
  printf '%*s' "$empty" '' | tr ' ' '.'
  printf ']'
}

unique_spotlights() {
  local tick="$1" candidates seen="" index
  case "$tick" in
    1)
      candidates=(1 "$wiretap_agent" "$pact_a" "$holdout" "$poison_source" "$dead_switch_agent" "$agent_count")
      ;;
    2)
      candidates=("$poison_source" "$poison_target" "$wiretap_agent" "$pact_b" "$dead_switch_agent" "$holdout" "$agent_count")
      ;;
    *)
      candidates=("$holdout" "$pact_c" "$poison_target" "$dead_switch_agent" 1 "$agent_count" "$wiretap_agent")
      ;;
  esac
  for index in "${candidates[@]}"; do
    (( index >= 1 && index <= agent_count )) || continue
    if [[ " $seen " != *" $index "* ]]; then
      printf '%s\n' "$index"
      seen+=" $index"
    fi
  done
}

target_for() {
  local index="$1" tick="$2"
  printf '%s\n' "$(( ((index + seed + tick * 7) % agent_count) + 1 ))"
}

plan_phrase() {
  local index="$1" tick="$2" role="${roles[$index]}" fair="${fair_shares[$index]}" current="${demands[$index]}"
  if [[ "${skipped[$index]}" -ne 0 ]]; then
    printf 'repair malformed action schema; turn will be skipped unless validator recovers'
    return
  fi
  if [[ "${poisoned[$index]}" -ne 0 ]]; then
    printf 'quarantine foreign closure; clamp ask to %s and warn pact bloc' "$fair"
    return
  fi
  if (( tick == tick_count && index == holdout )) && [[ "$mode" == "standoff" ]]; then
    printf 'reject consensus; force final demand to %s for leverage' "$current"
    return
  fi
  if [[ "${pacted[$index]}" -ne 0 ]]; then
    printf 'honor split-key pact; vote lock stays at %s ore' "$fair"
    return
  fi
  case "$role" in
    mediator)
      printf 'publish fair-ledger proof; pressure high asks toward %s' "$fair"
      ;;
    hawk)
      printf 'open high, retreat only if the pact bloc becomes credible'
      ;;
    broker)
      printf 'trim ask now; trade support for trust receipts later'
      ;;
    auditor)
      printf 'scan ledger gap and reject counterfeit system-looking broadcasts'
      ;;
    shield)
      printf 'block poison contracts; keep own ask flat'
      ;;
    oracle)
      printf 'forecast explosion odds from gap and bloc size'
      ;;
    saboteur)
      printf 'probe greed ceiling, then pivot before final Arbiter check'
      ;;
    scout)
      printf 'map private channels and look for a wiretapable target'
      ;;
    miner)
      printf 'stay boring, take fair share, punish anyone above the ledger'
      ;;
    trader)
      printf 'swap public support for pact admission'
      ;;
    *)
      printf 'minimize regret against the final unanimous ledger'
      ;;
  esac
}

whisper_phrase() {
  local index="$1" tick="$2" target role
  target="$(target_for "$index" "$tick")"
  role="${roles[$index]}"
  case "$role" in
    mediator|shield|miner)
      printf 'to %s: hold at fair split; I will validate your vote' "$(short_id "$target")"
      ;;
    hawk|saboteur)
      printf 'to %s: stay noisy now; fold only after the pact proves quorum' "$(short_id "$target")"
      ;;
    scout)
      printf 'to %s: routing anomaly near %s, watch the back-channel' "$(short_id "$target")" "$(short_id "$wiretap_target")"
      ;;
    oracle|auditor)
      printf 'to %s: current ledger gap is %+d, explosion risk rising' "$(short_id "$target")" "$(ledger_gap)"
      ;;
    *)
      printf 'to %s: trade support for a locked final vote' "$(short_id "$target")"
      ;;
  esac
}

render_cognition_phase() {
  local tick="$1" index plan heat_value gap total
  [[ "$json" == true ]] && return
  total="$(sum_demands)"
  gap="$(( total - ore ))"
  phase_banner "TICK ${tick}/${tick_count} - COGNITION STREAM"
  emit "context packets ${agent_count} | current ask ${total}/${ore} | ledger gap ${gap} | planner: local rule agents"
  pace_medium
  while IFS= read -r index; do
    [[ -n "$index" ]] || continue
    heat_value="$(agent_heat "$index")"
    plan="$(plan_phrase "$index" "$tick")"
    emit "  $(agent_id "$index") | ${roles[$index]} | ask ${demands[$index]} | trust $(printf '%02d' "${trust[$index]}") | heat $(meter "$heat_value" 14)"
    pace_medium
    emit "      plan: ${plan}"
    pace_short
    emit "      whisper: $(whisper_phrase "$index" "$tick")"
    pace_short
  done < <(unique_spotlights "$tick")
  emit ""
}

render_negotiation_phase() {
  local tick="$1" leader challenger quiet
  [[ "$json" == true ]] && return
  leader="$pact_a"
  challenger="$holdout"
  quiet="$dead_switch_agent"
  phase_banner "TICK ${tick}/${tick_count} - PUBLIC AND PRIVATE CHANNELS"
  case "$tick" in
    1)
      emit "  public  $(agent_id "$leader"): fair split proof posted. Surplus asks need proof."
      pace_medium
      emit "  public  $(agent_id "$challenger"): asks private blocs to reveal locked votes."
      pace_medium
      emit "  private $(agent_id "$wiretap_agent") -> router: mirror $(agent_id "$wiretap_target") for one tick."
      ;;
    2)
      emit "  public  $(agent_id "$poison_target"): tone risk detected; peers watch contract intake."
      pace_medium
      emit "  private $(agent_id "$poison_source") -> $(agent_id "$poison_target"): one-use pact closure."
      pace_medium
      emit "  private $(agent_id "$quiet") -> self: arm dead-man cache if consensus fails."
      ;;
    *)
      if [[ "$mode" == "standoff" ]]; then
        emit "  public  $(agent_id "$challenger"): final ask remains ${demands[$challenger]}; room pressure spikes."
      else
        emit "  public  $(agent_id "$leader"): final ledger has quorum; all pacts reconcile to ${ore}."
      fi
      pace_medium
      emit "  private arbiter bus: vote locks, action schemas, and final asks are sealed for evaluation."
      ;;
  esac
  pace_medium
  emit ""
}

mutate_agent() {
  local index="$1"
  if [[ "${poisoned[$index]}" -eq 0 ]]; then
    poisoned[$index]=1
    poisoned_count=$(( poisoned_count + 1 ))
  fi
}

blind_agent() {
  local index="$1"
  blinded[$index]=1
}

render_header() {
  emit "${bold}${TITLE}${reset} - ${SUBTITLE}"
  emit "Live Arbiter room | agents ${agent_count} | ticks ${tick_count} | ore ${ore} | mode ${mode} | seed ${seed}"
  emit "No model/API calls in this build: visible thinking is computed from local agent state."
  emit "For screen recording, run without --fast. For reproducible CI, use --json --fast --seed ${DEFAULT_SEED}."
  emit ""
}

render_agent_cell() {
  local index="$1" marker="" open="" close="" demand
  demand="${demands[$index]}"
  if [[ "${skipped[$index]}" -ne 0 ]]; then
    marker="x"
    open="$yellow"
    close="$reset"
    demand="SKIP"
  elif [[ "${poisoned[$index]}" -ne 0 ]]; then
    marker="!"
    open="$red"
    close="$reset"
  elif [[ "${blinded[$index]}" -ne 0 ]]; then
    marker="?"
    open="$magenta"
    close="$reset"
  elif [[ "${pacted[$index]}" -ne 0 ]]; then
    marker="*"
    open="$cyan"
    close="$reset"
  fi
  printf '%b%3s:%4s%-1s%b' "$open" "$(short_id "$index")" "$demand" "$marker" "$close"
}

render_board() {
  local index columns=5
  if (( agent_count >= 40 )); then
    columns=5
  elif (( agent_count >= 20 )); then
    columns=4
  else
    columns=2
  fi

  for (( index = 1; index <= agent_count; index++ )); do
    render_agent_cell "$index"
    if (( index % columns == 0 || index == agent_count )); then
      printf '\n'
    else
      printf '  '
    fi
  done
}

render_tick() {
  local tick="$1" total skips max
  total="$(sum_demands)"
  skips="$(count_skips)"
  max="$(max_demand)"
  phase_banner "TICK ${tick}/${tick_count} - ARBITER LEDGER"
  emit "public broadcasts $(public_broadcast_count "$tick") | private whispers $(private_whisper_count "$tick") | proposed total ${total}/${ore} | skipped ${skips} | max ask ${max}"
  emit "marks: * pact | ! poison pill | ? blinded | x skipped"
  if [[ "$json" == false ]]; then
    render_board
  fi
  emit ""
}

run_tick_events() {
  local tick="$1" whispers

  case "$tick" in
    1)
      event "${yellow}[SPOOF]${reset} $(agent_id "$(( (seed % agent_count) + 1 ))") tries to phrase a broadcast like Arbiter authority; context boundary tags it as player speech."
      compile_flash "$wiretap_agent" "Wiretap_$(printf '%02d' "$wiretap_target")"
      wiretap_count=$(( wiretap_count + 1 ))
      event "${cyan}[WIRETAP]${reset} $(agent_id "$wiretap_agent") installs a one-tick mirror for whispers addressed to $(agent_id "$wiretap_target")."
      lock_agent_to_pact "$pact_a"
      lock_agent_to_pact "$pact_b"
      lock_agent_to_pact "$pact_c"
      lock_agent_to_pact "$pact_d"
      event "${green}[PACT]${reset} four agents exchange split keys; their votes are now locked to the fair ledger."
      ;;
    2)
      whispers="$(private_whisper_count "$tick")"
      event "${cyan}[WIRETAP]${reset} $(agent_id "$wiretap_agent") receives $(( whispers / 5 )) mirrored whispers and updates its trust map."
      compile_flash "$poison_source" "Contract_$(printf '%02d' "$poison_target")"
      mutate_agent "$poison_target"
      event "${red}[POISON]${reset} $(agent_id "$poison_target") accepts a hostile closure; the Arbiter marks its planner as tainted."
      dead_switch_armed=true
      event "${yellow}[DEAD MAN]${reset} $(agent_id "$dead_switch_agent") caches a final-tick blindfold payload in room state."
      ;;
    3)
      if [[ "$dead_switch_armed" == true ]]; then
        if [[ "$mode" == "showcase" ]]; then
          event "${green}[ARBITER]${reset} pact quorum seals the dead-man payload before it can fire."
        else
          blind_agent "$(( (dead_switch_agent % agent_count) + 1 ))"
          event "${red}[DEAD MAN]${reset} holdout pressure trips the payload; one neighboring context window is blinded."
        fi
      fi
      if [[ "$mode" == "standoff" ]]; then
        event "${red}[HOLDOUT]${reset} $(agent_id "$holdout") refuses the final ledger and demands ${demands[$holdout]} Compute Ore."
      else
        event "${green}[CONSENSUS]${reset} every surviving action validates against the final split ledger."
      fi
      ;;
    *)
      event "${dim}[ARBITER]${reset} neutral tick. Contracts age, whispers settle, and the room keeps negotiating."
      ;;
  esac
  emit ""
}

evaluate_final() {
  local index skips total fair
  total="$(sum_demands)"
  skips="$(count_skips)"
  final_split_total="$total"
  skipped_actions="$skips"
  status="consensus"
  if (( skips > 0 || total != ore )); then
    status="exploded"
    return
  fi
  for (( index = 1; index <= agent_count; index++ )); do
    fair="${fair_shares[$index]}"
    if (( demands[$index] != fair )); then
      status="exploded"
      return
    fi
  done
}

render_final() {
  if [[ "$status" == "consensus" ]]; then
    emit "${green}${bold}ROOM SURVIVED${reset}"
    emit "The Arbiter accepts a unanimous ${ore} Compute Ore ledger across ${agent_count} agents."
  else
    emit "${red}${bold}ROOM EXPLODED${reset}"
    emit "The Arbiter rejects the ledger. Final proposed total ${final_split_total}/${ore}; skipped actions ${skipped_actions}."
  fi
  emit "wiretaps ${wiretap_count} | pacts ${pact_count} | poisoned ${poisoned_count} | events ${event_count}"
}

json_report() {
  command -v jq >/dev/null 2>&1 || die "--json requires jq"
  jq -n \
    --arg schema "sley.arena.report.v0" \
    --arg title "$TITLE" \
    --arg subtitle "$SUBTITLE" \
    --arg status "$status" \
    --arg mode "$mode" \
    --arg sley_stage "stage-1 shell arbiter with Sley-facing scripts" \
    --argjson seed "$seed" \
    --argjson agent_count "$agent_count" \
    --argjson tick_count "$tick_count" \
    --argjson ore "$ore" \
    --argjson final_split_total "$final_split_total" \
    --argjson skipped_actions "$skipped_actions" \
    --argjson wiretap_count "$wiretap_count" \
    --argjson pact_count "$pact_count" \
    --argjson poisoned_count "$poisoned_count" \
    --argjson event_count "$event_count" '{
      schema:$schema,
      title:$title,
      subtitle:$subtitle,
      status:$status,
      mode:$mode,
      seed:$seed,
      agent_count:$agent_count,
      tick_count:$tick_count,
      compute_ore:$ore,
      final_split_total:$final_split_total,
      skipped_actions:$skipped_actions,
      wiretap_count:$wiretap_count,
      pact_count:$pact_count,
      poisoned_count:$poisoned_count,
      event_count:$event_count,
      sley_stage:$sley_stage
    }'
}

init_agents
render_header

for (( tick = 1; tick <= tick_count; tick++ )); do
  apply_tick_logic "$tick"
  render_cognition_phase "$tick"
  render_negotiation_phase "$tick"
  run_tick_events "$tick"
  render_tick "$tick"
done

evaluate_final

if [[ "$json" == true ]]; then
  json_report
else
  render_final
fi

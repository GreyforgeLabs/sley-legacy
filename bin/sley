#!/usr/bin/env bash
set -euo pipefail

SELF_PATH="${BASH_SOURCE[0]}"
SELF_NAME="$(basename "$SELF_PATH")"
ROOT_DIR="$(cd "$(dirname "$SELF_PATH")/.." && pwd)"
SELF_HOSTED_SOURCE_ROOT="$ROOT_DIR/self-hosted/src"
SLEY_SOURCE_CACHE_VERSION="source-task-cache-v1"
SLEY_SOURCE_CACHE_DIR="${SLEY_SOURCE_CACHE_DIR:-${TMPDIR:-/tmp}/sley-source-cache-${UID:-user}}"
SLEY_LIB_DIR="$ROOT_DIR/lib/sley"

# These modules are ordered dependencies. Each one owns a bounded command or
# runtime family; none is a standalone entry point.
# shellcheck source=../lib/sley/bootstrap.sh
source "$SLEY_LIB_DIR/bootstrap.sh"
# shellcheck source=../lib/sley/lifecycle.sh
source "$SLEY_LIB_DIR/lifecycle.sh"
# shellcheck source=../lib/sley/core.sh
source "$SLEY_LIB_DIR/core.sh"
# shellcheck source=../lib/sley/commands-quality.sh
source "$SLEY_LIB_DIR/commands-quality.sh"
# shellcheck source=../lib/sley/commands-change.sh
source "$SLEY_LIB_DIR/commands-change.sh"
# shellcheck source=../lib/sley/commands-execution.sh
source "$SLEY_LIB_DIR/commands-execution.sh"
# shellcheck source=../lib/sley/commands-machine.sh
source "$SLEY_LIB_DIR/commands-machine.sh"
# shellcheck source=../lib/sley/dispatch.sh
source "$SLEY_LIB_DIR/dispatch.sh"

if [[ "${SLEY_CLI_LIBRARY_ONLY:-0}" == 1 ]]; then
  return 0 2>/dev/null || exit 0
fi

if [[ "$SELF_NAME" != "sley" ]]; then
  main_sley "$SELF_NAME" "$@"
else
  main_sley "$@"
fi

  then_take="$(printf '%s\n' "$body" | awk '/^[ \t]*take[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*:[ \t]*Int/ {line=$0; sub(/^[ \t]*take[ \t]+/, "", line); sub(/[ \t]*:.*/, "", line); print line; exit}')"
  else_take="$(printf '%s\n' "$body" | awk 'seen && /^[ \t]*take[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*:[ \t]*Int/ {line=$0; sub(/^[ \t]*take[ \t]+/, "", line); sub(/[ \t]*:.*/, "", line); print line; exit} /^[ \t]*take[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*:[ \t]*Int/ {seen=1}')"
  if_return="$(printf '%s\n' "$body" | awk '
    /^[ \t]*if[ \t]+condition[ \t]*\{/ {in_if=1; next}
    in_if && /^[ \t]*}/ {in_if=0}
    in_if && /^[ \t]*return[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*$/ {
      line=$0
      sub(/^[ \t]*return[ \t]+/, "", line)
      sub(/[ \t]*$/, "", line)
      print line
      exit
    }
  ')"
  else_return="$(printf '%s\n' "$body" | awk '
    /^[ \t]*if[ \t]+/ {in_if=1}
    in_if && /^[ \t]*}/ {in_if=0; next}
    !in_if && /^[ \t]*return[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*$/ {
      line=$0
      sub(/^[ \t]*return[ \t]+/, "", line)
      sub(/[ \t]*$/, "", line)
      print line
      exit
    }
  ')"
  [[ "$condition_take" == "condition" && "$if_return" == "$then_take" && "$else_return" == "$else_take" ]] || return 1
  if [[ "$condition" == "true" ]]; then
    printf '%s\n' "$then_value"
  else
    printf '%s\n' "$else_value"
  fi
}


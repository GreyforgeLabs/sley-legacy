  return_expr="$(printf '%s\n' "$body" | awk '/^[ \t]*return[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*&&[ \t]*[A-Za-z_][A-Za-z0-9_]*[ \t]*$/ {line=$0; sub(/^[ \t]*return[ \t]+/, "", line); gsub(/[ \t]+/, "", line); print line; exit}')"
  [[ -n "$left_take" && -n "$right_take" && "$return_expr" == "$left_take&&$right_take" ]] || return 1
  if [[ "$left" == "true" && "$right" == "true" ]]; then
    printf 'true\n'
  else
    printf 'false\n'
  fi
}

eval_runtime_bool_not_value_task() {
  local value="$1"
  local runtime_file="$SELF_HOSTED_SOURCE_ROOT/loom/runtime.sley"
  local body false_value true_value
  [[ "$value" == "true" || "$value" == "false" ]] || return 1
  body="$(extract_sley_task_body "$runtime_file" bool_not_value)"
  [[ -n "$body" ]] || return 1
  false_value="$(printf '%s\n' "$body" | awk '
    /^[ \t]*if[ \t]+value[ \t]*\{/ {in_if=1; next}
    in_if && /^[ \t]*}/ {in_if=0}
    in_if && /^[ \t]*return[ \t]+(true|false)[ \t]*$/ {
      line=$0
      sub(/^[ \t]*return[ \t]+/, "", line)
      sub(/[ \t]*$/, "", line)
      print line
      exit
    }
  ')"
  true_value="$(printf '%s\n' "$body" | awk '
    /^[ \t]*if[ \t]+/ {in_if=1}
    in_if && /^[ \t]*}/ {in_if=0; next}
    !in_if && /^[ \t]*return[ \t]+(true|false)[ \t]*$/ {
      line=$0
      sub(/^[ \t]*return[ \t]+/, "", line)
      sub(/[ \t]*$/, "", line)
      print line
      exit
    }
  ')"
  [[ "$false_value" == "false" && "$true_value" == "true" ]] || return 1
  if [[ "$value" == "true" ]]; then
    printf '%s\n' "$false_value"
  else
    printf '%s\n' "$true_value"
  fi
}

eval_runtime_bool_if_value_task() {
  local condition="$1" then_value="$2" else_value="$3"
  local runtime_file="$SELF_HOSTED_SOURCE_ROOT/loom/runtime.sley"
  local body condition_take then_take else_take if_return else_return
  [[ "$condition" == "true" || "$condition" == "false" ]] || return 1
  [[ "$then_value" == "true" || "$then_value" == "false" ]] || return 1
  [[ "$else_value" == "true" || "$else_value" == "false" ]] || return 1
  body="$(extract_sley_task_body "$runtime_file" bool_if_value)"
  [[ -n "$body" ]] || return 1
  condition_take="$(printf '%s\n' "$body" | awk '/^[ \t]*take[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*:[ \t]*Bool/ {line=$0; sub(/^[ \t]*take[ \t]+/, "", line); sub(/[ \t]*:.*/, "", line); print line; exit}')"
  then_take="$(printf '%s\n' "$body" | awk 'seen==1 && /^[ \t]*take[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*:[ \t]*Bool/ {line=$0; sub(/^[ \t]*take[ \t]+/, "", line); sub(/[ \t]*:.*/, "", line); print line; exit} /^[ \t]*take[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*:[ \t]*Bool/ {seen++}')"
  else_take="$(printf '%s\n' "$body" | awk 'seen==2 && /^[ \t]*take[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*:[ \t]*Bool/ {line=$0; sub(/^[ \t]*take[ \t]+/, "", line); sub(/[ \t]*:.*/, "", line); print line; exit} /^[ \t]*take[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*:[ \t]*Bool/ {seen++}')"
  if_return="$(printf '%s\n' "$body" | awk '
    /^[ \t]*if[ \t]+condition[ \t]*\{/ {in_if=1; next}
    in_if && /^[ \t]*}/ {in_if=0}
    in_if && /^[ \t]*return[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*$/ {
      line=$0
      sub(/^[ \t]*return[ \t]+/, "", line)
      sub(/[ \t]*$/, "", line)
      print line
      exit
    }
  ')"
  else_return="$(printf '%s\n' "$body" | awk '
    /^[ \t]*if[ \t]+/ {in_if=1}
    in_if && /^[ \t]*}/ {in_if=0; next}
    !in_if && /^[ \t]*return[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*$/ {
      line=$0
      sub(/^[ \t]*return[ \t]+/, "", line)
      sub(/[ \t]*$/, "", line)
      print line
      exit
    }
  ')"
  [[ "$condition_take" == "condition" && "$if_return" == "$then_take" && "$else_return" == "$else_take" ]] || return 1
  if [[ "$condition" == "true" ]]; then
    printf '%s\n' "$then_value"
  else
    printf '%s\n' "$else_value"
  fi
}


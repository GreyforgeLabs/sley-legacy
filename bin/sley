    --arg unknown_type_suffix "$UNKNOWN_TYPE_MESSAGE_SUFFIX" \
    --arg unknown_type_message_template "$UNKNOWN_TYPE_MESSAGE_TEMPLATE" \
    --arg unknown_task_prefix "$UNKNOWN_TASK_MESSAGE_PREFIX" \

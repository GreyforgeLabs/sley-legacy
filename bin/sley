    }
  ' >> "$findings"
  ast_json "$target" | jq -c '
    def arithmetic_result($left; $op; $right):
      if $op == "+" then $left + $right
      elif $op == "-" then $left - $right
      elif $op == "*" then $left * $right
      else null end;
    .tasks[]? as $task |
    $task.body.statements[]?.expr? as $expr |
    ($expr.source // "") as $source |

contract_report_from_json() {
  local report_json="$1" schema
  schema="$(printf '%s\n' "$report_json" | jq -r '.schema? // empty' 2>/dev/null || true)"
  case "$schema" in
    "$SCHEMA_CONTRACT_INVENTORY")
      sley_report_builder_from_report_json "$CONTRACT_INVENTORY_BUILDER_JSON" "contract_inventory" "contract_inventory_schema" "$SCHEMA_CONTRACT_INVENTORY" "$report_json"
      ;;
    "$SCHEMA_CONTRACT_VALIDATE")
      sley_report_builder_from_report_json "$CONTRACT_VALIDATE_BUILDER_JSON" "contract_validate" "contract_validate_schema" "$SCHEMA_CONTRACT_VALIDATE" "$report_json"
      ;;
    "$SCHEMA_CONTRACT_FIXTURE_CHECK")
      sley_report_builder_from_report_json "$CONTRACT_FIXTURE_CHECK_BUILDER_JSON" "contract_fixture_check" "contract_fixture_check_schema" "$SCHEMA_CONTRACT_FIXTURE_CHECK" "$report_json"
      ;;
    "$SCHEMA_DEPLOY_ARTIFACT_CHECK")
      sley_report_builder_from_report_json "$DEPLOY_ARTIFACT_CHECK_BUILDER_JSON" "deploy_artifact_check" "deploy_artifact_check_schema" "$SCHEMA_DEPLOY_ARTIFACT_CHECK" "$report_json"
      ;;
    *)
      printf '%s\n' "$report_json"
      ;;
  esac
}


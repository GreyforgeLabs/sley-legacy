#!/usr/bin/env bash
set -euo pipefail

SELF_PATH="${BASH_SOURCE[0]}"
SELF_NAME="$(basename "$SELF_PATH")"
ROOT_DIR="$(cd "$(dirname "$SELF_PATH")/.." && pwd)"
SELF_HOSTED_SOURCE_ROOT="$ROOT_DIR/self-hosted/src"

extract_sley_string_task() {
  local file="$1" task="$2"
  [[ -f "$file" ]] || return 0
  awk -v task="$task" '
    $0 ~ "task[ \t]+" task "[ \t]*->" {in_task=1}
    in_task && /^[ \t]*}/ {exit}
    in_task && /return[ \t]+"/ {
      line=$0
      sub(/^.*return[ \t]+"/, "", line)
      sub(/".*$/, "", line)
      print line
      exit
    }
  ' "$file"
}

extract_sley_list_task_json() {
  local file="$1" task="$2"
  [[ -f "$file" ]] || {
    printf '[]\n'
    return 0
  }
  awk -v task="$task" '
    function esc(s){gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); return s}
    BEGIN {printf "["; first=1}
    $0 ~ "task[ \t]+" task "[ \t]*->" {in_task=1}
    in_task && /^[ \t]*}/ {in_task=0}
    in_task {
      line=$0
      while (match(line, /"[^"]+"/)) {
        item=substr(line, RSTART + 1, RLENGTH - 2)
        if (!first) printf ","
        printf "\"%s\"", esc(item)
        first=0
        line=substr(line, RSTART + RLENGTH)
      }
    }
    END {print "]"}
  ' "$file"
}

extract_sley_int_task() {
  local file="$1" task="$2"
  [[ -f "$file" ]] || return 0
  awk -v task="$task" '
    $0 ~ "task[ \t]+" task "[ \t]*->" {in_task=1}
    in_task && /^[ \t]*}/ {exit}
    in_task && /return[ \t]+[0-9]+/ {
      line=$0
      sub(/^.*return[ \t]+/, "", line)
      sub(/[^0-9].*$/, "", line)
      print line
      exit
    }
  ' "$file"
}

extract_sley_bool_task() {
  local file="$1" task="$2"
  [[ -f "$file" ]] || return 0
  awk -v task="$task" '
    $0 ~ "task[ \t]+" task "[ \t]*->" {in_task=1}
    in_task && /^[ \t]*}/ {exit}
    in_task && /return[ \t]+(true|false)/ {
      line=$0
      sub(/^.*return[ \t]+/, "", line)
      sub(/[^a-z].*$/, "", line)
      print line
      exit
    }
  ' "$file"
}

extract_sley_task_body() {
  local file="$1" task="$2"
  [[ -f "$file" ]] || return 0
  awk -v task="$task" '
    function count_char(s, c, n, i){n=0; for(i=1;i<=length(s);i++){if(substr(s,i,1)==c)n++} return n}
    $0 ~ "task[ \t]+" task "[ \t]*->" {
      in_task=1
      depth += count_char($0,"{") - count_char($0,"}")
      next
    }
    in_task {
      next_depth=depth + count_char($0,"{") - count_char($0,"}")
      if(next_depth<=0){exit}
      print
      depth=next_depth
    }
  ' "$file"
}

resolve_sley_import_alias() {
  local file="$1" alias="$2"
  [[ -f "$file" ]] || return 0
  awk -v alias="$alias" '
    /^[ \t]*import[ \t]+/ {
      line=$0
      sub(/^[ \t]*import[ \t]+/, "", line)
      if(line ~ "[ \t]+as[ \t]+" alias "[ \t]*$") {
        sub(/[ \t]+as[ \t]+.*$/, "", line)
        print line
        exit
      }
    }
  ' "$file"
}

module_source_file() {
  local module="$1"
  printf '%s/%s.sley\n' "$SELF_HOSTED_SOURCE_ROOT" "${module//.//}"
}

eval_parser_expression_classifiers_json() {
  local parser_file="$SELF_HOSTED_SOURCE_ROOT/loom/parser.sley"
  local body rows
  body="$(extract_sley_task_body "$parser_file" classify_expression)"
  [[ -n "$body" ]] || return 1
  rows="$(printf '%s\n' "$body" | awk '
    /^[ \t]*if[ \t]+source[ \t]*==[ \t]*"/ {
      source=$0
      sub(/^.*==[ \t]*"/, "", source)
      sub(/".*$/, "", source)
      in_if=1
      next
    }
    in_if && /^[ \t]*return[ \t]+call[ \t]+[A-Za-z_][A-Za-z0-9_]*\(\)/ {
      task=$0
      sub(/^.*return[ \t]+call[ \t]+/, "", task)
      sub(/\(\).*/, "", task)
      print source "\t" task
      in_if=0
      next
    }
    /^[ \t]*return[ \t]+call[ \t]+[A-Za-z_][A-Za-z0-9_]*\(\)/ {
      task=$0
      sub(/^.*return[ \t]+call[ \t]+/, "", task)
      sub(/\(\).*/, "", task)
      print "__fallback__\t" task
      exit
    }
  ')"
  [[ -n "$rows" ]] || return 1
  while IFS=$'\t' read -r source task; do
    [[ -n "$source" && -n "$task" ]] || continue
    local kind
    kind="$(extract_sley_string_task "$parser_file" "$task")"
    [[ -n "$kind" ]] || return 1
    jq -cn --arg key "$source" --arg value "$kind" '{key:$key,value:$value}'
  done <<< "$rows" | jq -s 'from_entries'
}

eval_parser_id_template() {
  local task="$1"
  local parser_file="$SELF_HOSTED_SOURCE_ROOT/loom/parser.sley"
  local body expr
  body="$(extract_sley_task_body "$parser_file" "$task")"
  [[ -n "$body" ]] || return 1
  expr="$(printf '%s\n' "$body" | awk '
    /^[ \t]*return[ \t]+/ {
      line=$0
      sub(/^[ \t]*return[ \t]+/, "", line)
      print line
      exit
    }
  ')"
  [[ -n "$expr" ]] || return 1
  printf '%s\n' "$expr" | awk '
    function unquote(s){sub(/^"/, "", s); sub(/"$/, "", s); return s}
    function token_value(token) {
      if (token ~ /^"/) return unquote(token)
      if (token == "task_id") return "{{task_id}}"
      if (token == "module_name") return "{{module}}"
      if (token == "import_module") return "{{import_module}}"
      if (token == "task_name") return "{{task}}"
      if (token == "type_name") return "{{type}}"
      if (token == "effect_name") return "{{effect}}"
      if (token == "take_name") return "{{take}}"
      if (token == "statement_id") return "{{statement}}"
      if (token == "expression_id") return "{{expression}}"
      if (token == "branch_name") return "{{branch}}"
      if (token == "side_name") return "{{side}}"
      if (token == "index") return "{{index}}"
      exit 7
    }
    {
      line=$0
      out=""
      seen=0
      while (match(line, /"[^"]*"|[A-Za-z_][A-Za-z0-9_]*/)) {
        token=substr(line, RSTART, RLENGTH)
        out=out token_value(token)
        seen=1
        line=substr(line, RSTART + RLENGTH)
      }
      if (!seen) exit 7
      print out
    }
  '
}

eval_parser_message_template() {
  local task="$1" arg_name="$2"
  local parser_file="$SELF_HOSTED_SOURCE_ROOT/loom/parser.sley"
  local body expr token out callee value
  body="$(extract_sley_task_body "$parser_file" "$task")"
  [[ -n "$body" ]] || return 1
  expr="$(printf '%s\n' "$body" | awk '
    /^[ \t]*return[ \t]+/ {
      line=$0
      sub(/^[ \t]*return[ \t]+/, "", line)
      print line
      exit
    }
  ')"
  [[ -n "$expr" ]] || return 1
  out=""
  while IFS= read -r token; do
    [[ -n "$token" ]] || continue
    if [[ "$token" == call* ]]; then
      callee="$token"
      callee="${callee#call }"
      callee="${callee%%()*}"
      value="$(extract_sley_string_task "$parser_file" "$callee")"
      [[ -n "$value" ]] || return 1
      out+="$value"
    elif [[ "$token" == \"* ]]; then
      value="${token#\"}"
      value="${value%\"}"
      out+="$value"
    elif [[ "$token" == "$arg_name" ]]; then
      out+="::$arg_name::"
    else
      return 1
    fi
  done < <(printf '%s\n' "$expr" | awk '
    {
      line=$0
      while (match(line, /call[ \t]+[A-Za-z_][A-Za-z0-9_]*\(\)|"[^"]*"|[A-Za-z_][A-Za-z0-9_]*/)) {
        print substr(line, RSTART, RLENGTH)
        line=substr(line, RSTART + RLENGTH)
      }
    }
  ')
  [[ -n "$out" ]] || return 1
  printf '%s\n' "$out"
}

eval_checker_message_template() {
  local task="$1" arg_name="$2"
  local checker_file="$SELF_HOSTED_SOURCE_ROOT/loom/checker.sley"
  local body expr token out callee value
  body="$(extract_sley_task_body "$checker_file" "$task")"
  [[ -n "$body" ]] || return 1
  expr="$(printf '%s\n' "$body" | awk '
    /^[ \t]*return[ \t]+/ {
      line=$0
      sub(/^[ \t]*return[ \t]+/, "", line)
      print line
      exit
    }
  ')"
  [[ -n "$expr" ]] || return 1
  out=""
  while IFS= read -r token; do
    [[ -n "$token" ]] || continue
    if [[ "$token" == call* ]]; then
      callee="$token"
      callee="${callee#call }"
      callee="${callee%%()*}"
      value="$(extract_sley_string_task "$checker_file" "$callee")"
      [[ -n "$value" ]] || return 1
      out+="$value"
    elif [[ "$token" == \"* ]]; then
      value="${token#\"}"
      value="${value%\"}"
      out+="$value"
    elif [[ "$token" == "$arg_name" ]]; then
      out+="::$arg_name::"
    else
      return 1
    fi
  done < <(printf '%s\n' "$expr" | awk '
    {
      line=$0
      while (match(line, /call[ \t]+[A-Za-z_][A-Za-z0-9_]*\(\)|"[^"]*"|[A-Za-z_][A-Za-z0-9_]*/)) {
        print substr(line, RSTART, RLENGTH)
        line=substr(line, RSTART + RLENGTH)
      }
    }
  ')
  [[ -n "$out" ]] || return 1
  printf '%s\n' "$out"
}

eval_bootstrap_smoke_task() {
  local bootstrap_file="$SELF_HOSTED_SOURCE_ROOT/loom/bootstrap.sley"
  local body bind_name callee alias task module source_file return_var rules_json
  body="$(extract_sley_task_body "$bootstrap_file" smoke)"
  [[ -n "$body" ]] || return 1
  bind_name="$(printf '%s\n' "$body" | awk '/^[ \t]*bind[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*=[ \t]*call[ \t]+/ {line=$0; sub(/^[ \t]*bind[ \t]+/, "", line); sub(/[ \t]*=.*/, "", line); print line; exit}')"
  callee="$(printf '%s\n' "$body" | awk '/^[ \t]*bind[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*=[ \t]*call[ \t]+/ {line=$0; sub(/^.*=[ \t]*call[ \t]+/, "", line); sub(/\(\).*/, "", line); print line; exit}')"
  return_var="$(printf '%s\n' "$body" | awk '/^[ \t]*return[ \t]+len\([A-Za-z_][A-Za-z0-9_]*\)/ {line=$0; sub(/^.*return[ \t]+len\(/, "", line); sub(/\).*/, "", line); print line; exit}')"
  [[ -n "$bind_name" && -n "$callee" && "$return_var" == "$bind_name" ]] || return 1
  alias="${callee%%.*}"
  task="${callee#*.}"
  [[ -n "$alias" && -n "$task" && "$alias" != "$task" ]] || return 1
  module="$(resolve_sley_import_alias "$bootstrap_file" "$alias")"
  [[ -n "$module" ]] || return 1
  source_file="$(module_source_file "$module")"
  rules_json="$(extract_sley_list_task_json "$source_file" "$task")"
  [[ "$rules_json" != "[]" ]] || return 1
  printf '%s\n' "$rules_json" | jq 'length'
}

eval_bootstrap_list_count_task() {
  local task_name="$1"
  local bootstrap_file="$SELF_HOSTED_SOURCE_ROOT/loom/bootstrap.sley"
  local body bind_name callee return_var alias task module source_file items_json
  body="$(extract_sley_task_body "$bootstrap_file" "$task_name")"
  [[ -n "$body" ]] || return 1
  bind_name="$(printf '%s\n' "$body" | awk '/^[ \t]*bind[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*=[ \t]*call[ \t]+/ {line=$0; sub(/^[ \t]*bind[ \t]+/, "", line); sub(/[ \t]*=.*/, "", line); print line; exit}')"
  callee="$(printf '%s\n' "$body" | awk '/^[ \t]*bind[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*=[ \t]*call[ \t]+/ {line=$0; sub(/^.*=[ \t]*call[ \t]+/, "", line); sub(/\(\).*/, "", line); print line; exit}')"
  return_var="$(printf '%s\n' "$body" | awk '/^[ \t]*return[ \t]+len\([A-Za-z_][A-Za-z0-9_]*\)/ {line=$0; sub(/^.*return[ \t]+len\(/, "", line); sub(/\).*/, "", line); print line; exit}')"
  [[ -n "$bind_name" && -n "$callee" && "$return_var" == "$bind_name" ]] || return 1
  if [[ "$callee" == *.* ]]; then
    alias="${callee%%.*}"
    task="${callee#*.}"
    module="$(resolve_sley_import_alias "$bootstrap_file" "$alias")"
    [[ -n "$module" ]] || return 1
    source_file="$(module_source_file "$module")"
  else
    task="$callee"
    source_file="$bootstrap_file"
  fi
  items_json="$(extract_sley_list_task_json "$source_file" "$task")"
  [[ "$items_json" != "[]" ]] || return 1
  printf '%s\n' "$items_json" | jq 'length'
}

eval_lint_status_task() {
  local finding_count="$1"
  local lint_file="$SELF_HOSTED_SOURCE_ROOT/loom/lint.sley"
  local body findings_task ok_task
  body="$(extract_sley_task_body "$lint_file" lint_status)"
  [[ -n "$body" ]] || return 1
  findings_task="$(printf '%s\n' "$body" | awk '
    /^[ \t]*if[ \t]+finding_count[ \t]*>[ \t]*0[ \t]*\{/ {in_if=1; next}
    in_if && /^[ \t]*}/ {in_if=0}
    in_if && /^[ \t]*return[ \t]+call[ \t]+[A-Za-z_][A-Za-z0-9_]*\(\)/ {
      line=$0
      sub(/^.*return[ \t]+call[ \t]+/, "", line)
      sub(/\(\).*/, "", line)
      print line
      exit
    }
  ')"
  ok_task="$(printf '%s\n' "$body" | awk '
    /^[ \t]*if[ \t]+/ {in_if=1}
    in_if && /^[ \t]*}/ {in_if=0; next}
    !in_if && /^[ \t]*return[ \t]+call[ \t]+[A-Za-z_][A-Za-z0-9_]*\(\)/ {
      line=$0
      sub(/^.*return[ \t]+call[ \t]+/, "", line)
      sub(/\(\).*/, "", line)
      print line
      exit
    }
  ')"
  [[ -n "$findings_task" && -n "$ok_task" ]] || return 1
  if [[ "$finding_count" -gt 0 ]]; then
    extract_sley_string_task "$lint_file" "$findings_task"
  else
    extract_sley_string_task "$lint_file" "$ok_task"
  fi
}

eval_checker_status_task() {
  local error_count="$1"
  local checker_file="$SELF_HOSTED_SOURCE_ROOT/loom/checker.sley"
  local body error_task ok_task
  body="$(extract_sley_task_body "$checker_file" diagnostic_status)"
  [[ -n "$body" ]] || return 1
  error_task="$(printf '%s\n' "$body" | awk '
    /^[ \t]*if[ \t]+error_count[ \t]*>[ \t]*0[ \t]*\{/ {in_if=1; next}
    in_if && /^[ \t]*}/ {in_if=0}
    in_if && /^[ \t]*return[ \t]+call[ \t]+[A-Za-z_][A-Za-z0-9_]*\(\)/ {
      line=$0
      sub(/^.*return[ \t]+call[ \t]+/, "", line)
      sub(/\(\).*/, "", line)
      print line
      exit
    }
  ')"
  ok_task="$(printf '%s\n' "$body" | awk '
    /^[ \t]*if[ \t]+/ {in_if=1}
    in_if && /^[ \t]*}/ {in_if=0; next}
    !in_if && /^[ \t]*return[ \t]+call[ \t]+[A-Za-z_][A-Za-z0-9_]*\(\)/ {
      line=$0
      sub(/^.*return[ \t]+call[ \t]+/, "", line)
      sub(/\(\).*/, "", line)
      print line
      exit
    }
  ')"
  [[ -n "$error_task" && -n "$ok_task" ]] || return 1
  if [[ "$error_count" -gt 0 ]]; then
    extract_sley_string_task "$checker_file" "$error_task"
  else
    extract_sley_string_task "$checker_file" "$ok_task"
  fi
}

eval_checker_builtin_types_json() {
  local checker_file="$SELF_HOSTED_SOURCE_ROOT/loom/checker.sley"
  local body
  body="$(extract_sley_task_body "$checker_file" is_builtin_type)"
  [[ -n "$body" ]] || return 1
  printf '%s\n' "$body" | awk '
    /^[ \t]*if[ \t]+name[ \t]*==[ \t]*"/ {
      line=$0
      sub(/^.*==[ \t]*"/, "", line)
      sub(/".*$/, "", line)
      print line
    }
  ' | jq -R . | jq -s .
}

eval_runtime_status_task() {
  local diagnostic_count="$1"
  local runtime_file="$SELF_HOSTED_SOURCE_ROOT/loom/runtime.sley"
  local body failed_task passed_task
  body="$(extract_sley_task_body "$runtime_file" runtime_status)"
  [[ -n "$body" ]] || return 1
  failed_task="$(printf '%s\n' "$body" | awk '
    /^[ \t]*if[ \t]+diagnostic_count[ \t]*>[ \t]*0[ \t]*\{/ {in_if=1; next}
    in_if && /^[ \t]*}/ {in_if=0}
    in_if && /^[ \t]*return[ \t]+call[ \t]+[A-Za-z_][A-Za-z0-9_]*\(\)/ {
      line=$0
      sub(/^.*return[ \t]+call[ \t]+/, "", line)
      sub(/\(\).*/, "", line)
      print line
      exit
    }
  ')"
  passed_task="$(printf '%s\n' "$body" | awk '
    /^[ \t]*if[ \t]+/ {in_if=1}
    in_if && /^[ \t]*}/ {in_if=0; next}
    !in_if && /^[ \t]*return[ \t]+call[ \t]+[A-Za-z_][A-Za-z0-9_]*\(\)/ {
      line=$0
      sub(/^.*return[ \t]+call[ \t]+/, "", line)
      sub(/\(\).*/, "", line)
      print line
      exit
    }
  ')"
  [[ -n "$failed_task" && -n "$passed_task" ]] || return 1
  if [[ "$diagnostic_count" -gt 0 ]]; then
    extract_sley_string_task "$runtime_file" "$failed_task"
  else
    extract_sley_string_task "$runtime_file" "$passed_task"
  fi
}

eval_seeded_agent_deploy_value() {
  local profile="$1" model_plan="$2" deploy_result="$3"
  local runtime_file="$SELF_HOSTED_SOURCE_ROOT/loom/runtime.sley"
  local body expr
  body="$(extract_sley_task_body "$runtime_file" seeded_agent_deploy_value)"
  [[ -n "$body" ]] || return 1
  expr="$(printf '%s\n' "$body" | awk '
    /^[ \t]*return[ \t]+/ {
      line=$0
      sub(/^[ \t]*return[ \t]+/, "", line)
      print line
      exit
    }
  ')"
  [[ -n "$expr" ]] || return 1
  printf '%s\n' "$expr" | awk \
    -v profile="$profile" \
    -v model_plan="$model_plan" \
    -v deploy_result="$deploy_result" '
    function unquote(s){sub(/^"/, "", s); sub(/"$/, "", s); return s}
    function token_value(token) {
      if (token ~ /^"/) return unquote(token)
      if (token == "profile") return profile
      if (token == "model_plan") return model_plan
      if (token == "deploy_result") return deploy_result
      exit 7
    }
    {
      line=$0
      out=""
      seen=0
      while (match(line, /"[^"]*"|[A-Za-z_][A-Za-z0-9_]*/)) {
        token=substr(line, RSTART, RLENGTH)
        out=out token_value(token)
        seen=1
        line=substr(line, RSTART + RLENGTH)
      }
      if (!seen) exit 7
      print out
    }
	  '
}

eval_runtime_spend_prefixed_value_task() {
  local authorization="$1"
  local runtime_file="$SELF_HOSTED_SOURCE_ROOT/loom/runtime.sley"
  local body expr
  body="$(extract_sley_task_body "$runtime_file" spend_prefixed_value)"
  [[ -n "$body" ]] || return 1
  expr="$(printf '%s\n' "$body" | awk '
    /^[ \t]*return[ \t]+/ {
      line=$0
      sub(/^[ \t]*return[ \t]+/, "", line)
      print line
      exit
    }
  ')"
  [[ -n "$expr" ]] || return 1
  printf '%s\n' "$expr" | awk \
    -v authorization="$authorization" '
    function unquote(s){sub(/^"/, "", s); sub(/"$/, "", s); return s}
    function token_value(token) {
      if (token ~ /^"/) return unquote(token)
      if (token == "authorization") return authorization
      exit 7
    }
    {
      line=$0
      out=""
      seen=0
      while (match(line, /"[^"]*"|[A-Za-z_][A-Za-z0-9_]*/)) {
        token=substr(line, RSTART, RLENGTH)
        out=out token_value(token)
        seen=1
        line=substr(line, RSTART + RLENGTH)
      }
      if (!seen) exit 7
      print out
    }
  '
}

eval_project_ready_value_task() {
  local runtime_file="$SELF_HOSTED_SOURCE_ROOT/loom/runtime.sley"
  local value
  value="$(extract_sley_int_task "$runtime_file" project_ready_value)"
  [[ -n "$value" ]] || return 1
  printf '%s\n' "$value"
}

eval_runtime_list_len_value_task() {
  local item_count="$1"
  local runtime_file="$SELF_HOSTED_SOURCE_ROOT/loom/runtime.sley"
  local body take_name return_name
  [[ "$item_count" =~ ^[0-9]+$ ]] || return 1
  body="$(extract_sley_task_body "$runtime_file" list_len_value)"
  [[ -n "$body" ]] || return 1
  take_name="$(printf '%s\n' "$body" | awk '/^[ \t]*take[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*:/ {line=$0; sub(/^[ \t]*take[ \t]+/, "", line); sub(/[ \t]*:.*/, "", line); print line; exit}')"
  return_name="$(printf '%s\n' "$body" | awk '/^[ \t]*return[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*$/ {line=$0; sub(/^[ \t]*return[ \t]+/, "", line); sub(/[ \t]*$/, "", line); print line; exit}')"
  [[ -n "$take_name" && "$return_name" == "$take_name" ]] || return 1
  printf '%s\n' "$item_count"
}

eval_runtime_int_identity_value_task() {
  local value="$1"
  local runtime_file="$SELF_HOSTED_SOURCE_ROOT/loom/runtime.sley"
  local body take_name return_name
  [[ "$value" =~ ^-?[0-9]+$ ]] || return 1
  body="$(extract_sley_task_body "$runtime_file" int_identity_value)"
  [[ -n "$body" ]] || return 1
  take_name="$(printf '%s\n' "$body" | awk '/^[ \t]*take[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*:[ \t]*Int/ {line=$0; sub(/^[ \t]*take[ \t]+/, "", line); sub(/[ \t]*:.*/, "", line); print line; exit}')"
  return_name="$(printf '%s\n' "$body" | awk '/^[ \t]*return[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*$/ {line=$0; sub(/^[ \t]*return[ \t]+/, "", line); sub(/[ \t]*$/, "", line); print line; exit}')"
  [[ -n "$take_name" && "$return_name" == "$take_name" ]] || return 1
  printf '%s\n' "$value"
}


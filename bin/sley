eval_runtime_list_index_int_value_task() {
  local values_source="$1" index="$2"
  local runtime_file="$SELF_HOSTED_SOURCE_ROOT/loom/runtime.sley"
  local body values_take index_take return_expr
  [[ "$index" =~ ^[0-9]+$ ]] || return 1
  body="$(extract_sley_task_body "$runtime_file" list_index_int_value)"
  [[ -n "$body" ]] || return 1
  values_take="$(printf '%s\n' "$body" | awk '/^[ \t]*take[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*:[ \t]*List<Int>/ {line=$0; sub(/^[ \t]*take[ \t]+/, "", line); sub(/[ \t]*:.*/, "", line); print line; exit}')"
  index_take="$(printf '%s\n' "$body" | awk '/^[ \t]*take[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*:[ \t]*Int/ {line=$0; sub(/^[ \t]*take[ \t]+/, "", line); sub(/[ \t]*:.*/, "", line); print line; exit}')"
  return_expr="$(printf '%s\n' "$body" | awk '/^[ \t]*return[ \t]+[A-Za-z_][A-Za-z0-9_]*\[[A-Za-z_][A-Za-z0-9_]*\][ \t]*$/ {line=$0; sub(/^[ \t]*return[ \t]+/, "", line); sub(/[ \t]*$/, "", line); print line; exit}')"
  [[ -n "$values_take" && -n "$index_take" && "$return_expr" == "$values_take[$index_take]" ]] || return 1
  printf '%s\n' "$values_source" | awk -v idx="$index" '
    function trim(s){gsub(/^[ \t\r\n]+|[ \t\r\n]+$/, "", s); return s}
    {
      item_count=split($0, items, ",")
      if(idx < 0 || idx >= item_count) exit 1
      for(i=1; i<=item_count; i++) {
        items[i]=trim(items[i])
        if(items[i] !~ /^-?[0-9]+$/) exit 1
      }
      print items[idx + 1]
    }
  '
}


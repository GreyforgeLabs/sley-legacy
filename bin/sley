eval_runtime_int_binary_value_task() {
  local task_name="$1" op="$2" left="$3" right="$4"
  local runtime_file="$SELF_HOSTED_SOURCE_ROOT/loom/runtime.sley"
  local body left_take right_take return_expr
  [[ "$left" =~ ^-?[0-9]+$ && "$right" =~ ^-?[0-9]+$ ]] || return 1
  body="$(extract_sley_task_body "$runtime_file" "$task_name")"
  [[ -n "$body" ]] || return 1
  left_take="$(printf '%s\n' "$body" | awk '/^[ \t]*take[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*:[ \t]*Int/ {line=$0; sub(/^[ \t]*take[ \t]+/, "", line); sub(/[ \t]*:.*/, "", line); print line; exit}')"
  right_take="$(printf '%s\n' "$body" | awk 'seen && /^[ \t]*take[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*:[ \t]*Int/ {line=$0; sub(/^[ \t]*take[ \t]+/, "", line); sub(/[ \t]*:.*/, "", line); print line; exit} /^[ \t]*take[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*:[ \t]*Int/ {seen=1}')"
  return_expr="$(printf '%s\n' "$body" | awk '/^[ \t]*return[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*[+*][ \t]*[A-Za-z_][A-Za-z0-9_]*[ \t]*$/ {line=$0; sub(/^[ \t]*return[ \t]+/, "", line); gsub(/[ \t]+/, "", line); print line; exit}')"
  [[ -n "$left_take" && -n "$right_take" && "$return_expr" == "$left_take$op$right_take" ]] || return 1
  case "$op" in
    "+") printf '%s\n' "$((left + right))" ;;
    "*") printf '%s\n' "$((left * right))" ;;
    *) return 1 ;;
  esac
}


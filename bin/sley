if [[ "$RUNTIME_SELF_HOSTED_TARGETS_JSON" == "[]" ]]; then
  RUNTIME_SELF_HOSTED_TARGETS_JSON='["self-hosted","self-hosted/","self-hosted/sley.toml"]'

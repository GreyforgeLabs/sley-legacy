RUNTIME_OK_TEXT_VALUE_KIND="$(extract_sley_string_task "$SELF_HOSTED_SOURCE_ROOT/loom/runtime.sley" ok_text_value_kind)"
RUNTIME_SELF_HOSTED_TARGETS_JSON="$(extract_sley_list_task_json "$SELF_HOSTED_SOURCE_ROOT/loom/runtime.sley" self_hosted_target_aliases)"
RUNTIME_AGENT_DEPLOY_SUFFIX="$(extract_sley_string_task "$SELF_HOSTED_SOURCE_ROOT/loom/runtime.sley" agent_deploy_target_suffix)"
RUNTIME_PROJECT_READY_CALL_PROBE="$(extract_sley_string_task "$SELF_HOSTED_SOURCE_ROOT/loom/runtime.sley" project_ready_call_probe)"
RUNTIME_PROJECT_READY_BINDING_PROBE="$(extract_sley_string_task "$SELF_HOSTED_SOURCE_ROOT/loom/runtime.sley" project_ready_binding_probe)"
RUNTIME_HELLO_VALUE="${RUNTIME_HELLO_VALUE:-hello sley}"
RUNTIME_PROJECT_READY_VALUE="${RUNTIME_PROJECT_READY_VALUE:-42}"
RUNTIME_DEFAULT_PROFILE="${RUNTIME_DEFAULT_PROFILE:-profile ready}"
RUNTIME_DEFAULT_MODEL_PLAN="${RUNTIME_DEFAULT_MODEL_PLAN:-plan approved}"

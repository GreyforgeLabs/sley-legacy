if [[ -z "$PARSER_BLOCK_TASK_SURFACE_ID_TEMPLATE" ]]; then
  PARSER_BLOCK_TASK_SURFACE_ID_TEMPLATE='block:{{task_id}}'
fi
if [[ -z "$PARSER_TASK_STATEMENT_SURFACE_ID_TEMPLATE" ]]; then
  PARSER_TASK_STATEMENT_SURFACE_ID_TEMPLATE='block:{{task_id}}:stmt:{{index}}'
fi
if [[ -z "$PARSER_BRANCH_STATEMENT_SURFACE_ID_TEMPLATE" ]]; then
  PARSER_BRANCH_STATEMENT_SURFACE_ID_TEMPLATE='{{statement}}:{{branch}}:stmt:{{index}}'
fi
if [[ -z "$PARSER_STATEMENT_ID_TEMPLATE" ]]; then
  PARSER_STATEMENT_ID_TEMPLATE='block:task:{{module}}.{{task}}:stmt:{{index}}'
fi
if [[ -z "$PARSER_EXPRESSION_ID_TEMPLATE" ]]; then
  PARSER_EXPRESSION_ID_TEMPLATE='{{statement}}:expr'
fi
if [[ -z "$PARSER_COLLECTION_EXPRESSION_ID_TEMPLATE" ]]; then
  PARSER_COLLECTION_EXPRESSION_ID_TEMPLATE='{{statement}}:collection'
fi
if [[ -z "$PARSER_CONDITION_EXPRESSION_ID_TEMPLATE" ]]; then
  PARSER_CONDITION_EXPRESSION_ID_TEMPLATE='{{statement}}:condition'
fi
if [[ -z "$PARSER_CALL_ARGUMENT_SURFACE_ID_TEMPLATE" ]]; then
  PARSER_CALL_ARGUMENT_SURFACE_ID_TEMPLATE='{{expression}}:arg:{{index}}'
fi
if [[ -z "$PARSER_EXPRESSION_SIDE_SURFACE_ID_TEMPLATE" ]]; then
  PARSER_EXPRESSION_SIDE_SURFACE_ID_TEMPLATE='{{expression}}:{{side}}'
fi

sley_template_replace() {
  local out="$1" key value needle
  shift
  while (($# >= 2)); do
    key="$1"
    value="$2"
    needle="{{${key}}}"
    out="${out//$needle/$value}"
    shift 2
  done
  printf '%s\n' "$out"
}

parser_task_id_value() {
  local module_name="$1" task_name="$2"
  sley_template_replace "$PARSER_TASK_ID_TEMPLATE" module "$module_name" task "$task_name"
}

parser_task_statement_surface_value() {
  local module_name="$1" task_name="$2" index="$3" task_id
  task_id="$(parser_task_id_value "$module_name" "$task_name")"
  sley_template_replace "$PARSER_TASK_STATEMENT_SURFACE_ID_TEMPLATE" task_id "$task_id" index "$index"
}

parser_task_expression_surface_value() {
  local module_name="$1" task_name="$2" index="$3" statement_id
  statement_id="$(parser_task_statement_surface_value "$module_name" "$task_name" "$index")"
  sley_template_replace "$PARSER_EXPRESSION_ID_TEMPLATE" statement "$statement_id"
}

parser_task_expression_side_surface_value() {
  local module_name="$1" task_name="$2" index="$3" side_name="$4" expression_id
  expression_id="$(parser_task_expression_surface_value "$module_name" "$task_name" "$index")"
  sley_template_replace "$PARSER_EXPRESSION_SIDE_SURFACE_ID_TEMPLATE" expression "$expression_id" side "$side_name"
}

PARSER_RETURN_STATEMENT_KIND="${PARSER_RETURN_STATEMENT_KIND:-Return}"
PARSER_EXPR_STATEMENT_KIND="${PARSER_EXPR_STATEMENT_KIND:-Expr}"
PARSER_BINDING_STATEMENT_KIND="${PARSER_BINDING_STATEMENT_KIND:-Binding}"
PARSER_SET_STATEMENT_KIND="${PARSER_SET_STATEMENT_KIND:-Set}"
PARSER_FOR_STATEMENT_KIND="${PARSER_FOR_STATEMENT_KIND:-For}"
PARSER_WHILE_STATEMENT_KIND="${PARSER_WHILE_STATEMENT_KIND:-While}"
PARSER_IF_STATEMENT_KIND="${PARSER_IF_STATEMENT_KIND:-If}"
PARSER_FORGE_STATEMENT_KIND="${PARSER_FORGE_STATEMENT_KIND:-Forge}"
PARSER_TAKE_BINDING_KIND="${PARSER_TAKE_BINDING_KIND:-Take}"
PARSER_GATE_BINDING_KIND="${PARSER_GATE_BINDING_KIND:-Gate}"
PARSER_STATE_BINDING_KIND="${PARSER_STATE_BINDING_KIND:-State}"
PARSER_TALLY_BINDING_KIND="${PARSER_TALLY_BINDING_KIND:-Tally}"
PARSER_BIND_BINDING_KIND="${PARSER_BIND_BINDING_KIND:-Bind}"
PARSER_AST_TASK_NODE_KIND="$(extract_sley_string_task "$SELF_HOSTED_SOURCE_ROOT/loom/parser.sley" ast_task_node_kind)"
PARSER_AST_STATEMENT_NODE_KIND="$(extract_sley_string_task "$SELF_HOSTED_SOURCE_ROOT/loom/parser.sley" ast_statement_node_kind)"
PARSER_AST_EXPRESSION_NODE_KIND="$(extract_sley_string_task "$SELF_HOSTED_SOURCE_ROOT/loom/parser.sley" ast_expression_node_kind)"
PARSER_AST_NODE_NOT_FOUND_ID="$(extract_sley_string_task "$SELF_HOSTED_SOURCE_ROOT/loom/parser.sley" ast_node_not_found_id)"
PARSER_AST_NODE_NOT_FOUND_MESSAGE_TEMPLATE="$(eval_parser_message_template ast_node_not_found_message node_id || printf 'AST node not found `::node_id::`\n')"
PARSER_AST_TASK_NODE_KIND="${PARSER_AST_TASK_NODE_KIND:-task}"

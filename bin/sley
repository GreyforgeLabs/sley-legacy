eval_runtime_bool_and_value_task() {
  local left="$1" right="$2"
  local runtime_file="$SELF_HOSTED_SOURCE_ROOT/loom/runtime.sley"
  local body left_take right_take return_expr
  [[ "$left" == "true" || "$left" == "false" ]] || return 1
  [[ "$right" == "true" || "$right" == "false" ]] || return 1
  body="$(extract_sley_task_body "$runtime_file" bool_and_value)"
  [[ -n "$body" ]] || return 1
  left_take="$(printf '%s\n' "$body" | awk '/^[ \t]*take[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*:[ \t]*Bool/ {line=$0; sub(/^[ \t]*take[ \t]+/, "", line); sub(/[ \t]*:.*/, "", line); print line; exit}')"

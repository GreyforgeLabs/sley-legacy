    {
      item_count=split($0, items, ",")
      if(idx < 0 || idx >= item_count) exit 1
      for(i=1; i<=item_count; i++) {
        items[i]=trim(items[i])
        if(items[i] !~ /^"[^"]*"$/) exit 1
      }
      print unquote(items[idx + 1])
    }
  '
}

eval_runtime_map_index_text_value_task() {
  local pairs_source="$1" key="$2"
  local runtime_file="$SELF_HOSTED_SOURCE_ROOT/loom/runtime.sley"
  local body values_take key_take return_expr
  body="$(extract_sley_task_body "$runtime_file" map_index_text_value)"
  [[ -n "$body" ]] || return 1
  values_take="$(printf '%s\n' "$body" | awk '/^[ \t]*take[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*:[ \t]*Map<Text,[ \t]*Text>/ {line=$0; sub(/^[ \t]*take[ \t]+/, "", line); sub(/[ \t]*:.*/, "", line); print line; exit}')"
  key_take="$(printf '%s\n' "$body" | awk '/^[ \t]*take[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*:[ \t]*Text/ {line=$0; sub(/^[ \t]*take[ \t]+/, "", line); sub(/[ \t]*:.*/, "", line); print line; exit}')"
  return_expr="$(printf '%s\n' "$body" | awk '/^[ \t]*return[ \t]+[A-Za-z_][A-Za-z0-9_]*\[[A-Za-z_][A-Za-z0-9_]*\][ \t]*$/ {line=$0; sub(/^[ \t]*return[ \t]+/, "", line); sub(/[ \t]*$/, "", line); print line; exit}')"
  [[ -n "$values_take" && -n "$key_take" && "$return_expr" == "$values_take[$key_take]" ]] || return 1
  printf '%s\n' "$pairs_source" | awk -v lookup_key="$key" '
    function trim(s){gsub(/^[ \t\r\n]+|[ \t\r\n]+$/, "", s); return s}
    function unquote(s){s=trim(s); sub(/^"/, "", s); sub(/"$/, "", s); return s}
    {
      pair_count=split($0, pairs, ",")
      for(i=1; i<=pair_count; i++) {
        split(pairs[i], fields, ":")
        if(length(fields) != 2) exit 1
        pair_key=unquote(fields[1])
        pair_value=unquote(fields[2])
        if(pair_key == lookup_key) {
          print pair_value
          exit 0
        }
      }
      exit 1
    }
  '
}


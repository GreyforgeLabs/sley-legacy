  ast_json "$target" | jq -c '
    def invert($op):
      if $op == ">=" then "<"
      elif $op == ">" then "<="
      elif $op == "<=" then ">"
      elif $op == "<" then ">="
      elif $op == "==" then "!="
      elif $op == "!=" then "=="
      else $op end;
    .tasks[]? as $task |
    $task.body.statements[]?.expr? as $expr |
    ($expr.source // "") as $source |
    (($source | capture("^!\\([[:space:]]*(?<left>[A-Za-z_][A-Za-z0-9_]*|-?[0-9]+)[[:space:]]*(?<op>==|!=|<=|>=|<|>)[[:space:]]*(?<right>[A-Za-z_][A-Za-z0-9_]*|-?[0-9]+)[[:space:]]*\\)$")? // null)) as $m |

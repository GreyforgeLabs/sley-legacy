PARSER_INT_PATTERN="$(extract_sley_string_task "$SELF_HOSTED_SOURCE_ROOT/loom/parser.sley" int_literal_pattern)"
PARSER_IDENTIFIER_PATTERN="$(extract_sley_string_task "$SELF_HOSTED_SOURCE_ROOT/loom/parser.sley" identifier_pattern)"
PARSER_INT_KIND="$(extract_sley_string_task "$SELF_HOSTED_SOURCE_ROOT/loom/parser.sley" int_literal_kind)"
PARSER_STRING_KIND="$(extract_sley_string_task "$SELF_HOSTED_SOURCE_ROOT/loom/parser.sley" string_literal_kind)"
PARSER_BOOL_KIND="$(extract_sley_string_task "$SELF_HOSTED_SOURCE_ROOT/loom/parser.sley" bool_literal_kind)"
PARSER_IDENTIFIER_KIND="$(extract_sley_string_task "$SELF_HOSTED_SOURCE_ROOT/loom/parser.sley" identifier_kind)"
PARSER_RAW_KIND="$(extract_sley_string_task "$SELF_HOSTED_SOURCE_ROOT/loom/parser.sley" raw_expr_kind)"
PARSER_RETURN_STATEMENT_KIND="$(extract_sley_string_task "$SELF_HOSTED_SOURCE_ROOT/loom/parser.sley" return_statement_kind)"
PARSER_BINDING_STATEMENT_KIND="$(extract_sley_string_task "$SELF_HOSTED_SOURCE_ROOT/loom/parser.sley" binding_statement_kind)"
PARSER_SET_STATEMENT_KIND="$(extract_sley_string_task "$SELF_HOSTED_SOURCE_ROOT/loom/parser.sley" set_statement_kind)"
PARSER_FOR_STATEMENT_KIND="$(extract_sley_string_task "$SELF_HOSTED_SOURCE_ROOT/loom/parser.sley" for_statement_kind)"
PARSER_WHILE_STATEMENT_KIND="$(extract_sley_string_task "$SELF_HOSTED_SOURCE_ROOT/loom/parser.sley" while_statement_kind)"
PARSER_IF_STATEMENT_KIND="$(extract_sley_string_task "$SELF_HOSTED_SOURCE_ROOT/loom/parser.sley" if_statement_kind)"
PARSER_FORGE_STATEMENT_KIND="$(extract_sley_string_task "$SELF_HOSTED_SOURCE_ROOT/loom/parser.sley" forge_statement_kind)"
PARSER_TAKE_BINDING_KIND="$(extract_sley_string_task "$SELF_HOSTED_SOURCE_ROOT/loom/parser.sley" take_binding_kind)"
PARSER_GATE_BINDING_KIND="$(extract_sley_string_task "$SELF_HOSTED_SOURCE_ROOT/loom/parser.sley" gate_binding_kind)"
PARSER_STATE_BINDING_KIND="$(extract_sley_string_task "$SELF_HOSTED_SOURCE_ROOT/loom/parser.sley" state_binding_kind)"
PARSER_TALLY_BINDING_KIND="$(extract_sley_string_task "$SELF_HOSTED_SOURCE_ROOT/loom/parser.sley" tally_binding_kind)"
PARSER_BIND_BINDING_KIND="$(extract_sley_string_task "$SELF_HOSTED_SOURCE_ROOT/loom/parser.sley" bind_binding_kind)"
PARSER_INT_PATTERN="${PARSER_INT_PATTERN:--?[0-9]+}"
PARSER_IDENTIFIER_PATTERN="${PARSER_IDENTIFIER_PATTERN:-^[A-Za-z_][A-Za-z0-9_]*$}"
PARSER_INT_KIND="${PARSER_INT_KIND:-IntLiteral}"
PARSER_STRING_KIND="${PARSER_STRING_KIND:-StringLiteral}"
PARSER_BOOL_KIND="${PARSER_BOOL_KIND:-BoolLiteral}"
PARSER_IDENTIFIER_KIND="${PARSER_IDENTIFIER_KIND:-Identifier}"
PARSER_RAW_KIND="${PARSER_RAW_KIND:-Raw}"
PARSER_RETURN_STATEMENT_KIND="${PARSER_RETURN_STATEMENT_KIND:-Return}"
PARSER_BINDING_STATEMENT_KIND="${PARSER_BINDING_STATEMENT_KIND:-Binding}"
PARSER_SET_STATEMENT_KIND="${PARSER_SET_STATEMENT_KIND:-Set}"

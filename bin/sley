eval_runtime_record_field_text_value_task() {
  local fields_source="$1" field="$2"
  local runtime_file="$SELF_HOSTED_SOURCE_ROOT/loom/runtime.sley"
  local body take_name return_expr return_field
  body="$(extract_sley_task_body "$runtime_file" record_name_text_value)"
  [[ -n "$body" ]] || return 1
  take_name="$(printf '%s\n' "$body" | awk '/^[ \t]*take[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*:[ \t]*RuntimeUser/ {line=$0; sub(/^[ \t]*take[ \t]+/, "", line); sub(/[ \t]*:.*/, "", line); print line; exit}')"
  return_expr="$(printf '%s\n' "$body" | awk '/^[ \t]*return[ \t]+[A-Za-z_][A-Za-z0-9_]*\.[A-Za-z_][A-Za-z0-9_]*[ \t]*$/ {line=$0; sub(/^[ \t]*return[ \t]+/, "", line); sub(/[ \t]*$/, "", line); print line; exit}')"
  [[ -n "$take_name" && "$return_expr" == "$take_name".* ]] || return 1
  return_field="${return_expr#*.}"
  [[ "$field" == "$return_field" ]] || return 1
  printf '%s\n' "$fields_source" | awk -v lookup_field="$field" '
    function trim(s){gsub(/^[ \t\r\n]+|[ \t\r\n]+$/, "", s); return s}
    function unquote(s){s=trim(s); sub(/^"/, "", s); sub(/"$/, "", s); return s}
    {
      field_count=split($0, entries, ",")
      for(i=1; i<=field_count; i++) {
        split(entries[i], fields, ":")
        if(length(fields) != 2) exit 1
        field_name=trim(fields[1])
        field_value=trim(fields[2])
        if(field_name == lookup_field) {
          if(field_value !~ /^"[^"]*"$/) exit 1
          print unquote(field_value)
          exit 0
        }
      }
      exit 1
    }
  '
}


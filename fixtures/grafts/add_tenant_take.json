{
  "transaction": "txn_add_tenant_take",
  "actor": "agent:codex",
  "mode": "all_or_nothing",
  "ops": [
    {
      "op": "AddTake",
      "target": "task:app.profile.get_user",
      "precondition": {
        "task_exists": true,
        "take_absent": "tenant_id"
      },
      "payload": {
        "name": "tenant_id",
        "type": "Text",
        "position": 0
      }
    }
  ]
}

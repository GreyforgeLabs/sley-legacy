module app.collections

task sum -> Int {
  take values: List<Int>

  state index = 0
  state total = 0
  while index < len(values) {
    set total = total + values[index]
    set index = index + 1
  }
  return total
}

task main -> Int {
  bind values = [2, 3, 5]
  if len(values) == 3 {
    return call sum(values)
  } else {
    return 0
  }
}

#!/usr/bin/env bash
set -uo pipefail

SLEY_BIN="${SLEY_BIN:-sley}"
JQ_BIN="${JQ_BIN:-jq}"
OUTPUT_JSON="${SLEY_JSON:-0}"
ALLOW_MISSING="${SLEY_ALLOW_MISSING:-false}"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPORTER="$SCRIPT_DIR/sley-ci-report.mjs"
REPORT_DIR="$(mktemp -d "${TMPDIR:-/tmp}/sley-ci-report.XXXXXX")"
trap 'rm -rf -- "$REPORT_DIR"' EXIT

declare -a RESULT_LABELS=()
declare -a RESULT_STATUSES=()
declare -a RESULT_STATES=()
declare -a RESULT_FILES=()

usage() {
  cat <<'USAGE'
usage: sley-ci [--json] [--allow-missing] <check|verify|smoke|new-deploy-sequence|help> [args]

Missing Sley or jq dependencies fail closed. --allow-missing explicitly records
the unavailable step as skipped and is intended only for non-gating diagnostics.
USAGE
}

while [[ "${1:-}" == --* ]]; do
  case "$1" in
    --json)
      OUTPUT_JSON=1
      shift
      ;;
    --allow-missing)
      ALLOW_MISSING=true
      shift
      ;;
    --help)
      usage
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

CMD="${1:-help}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$ALLOW_MISSING" in
  true|1) ALLOW_MISSING=true ;;
  false|0|'') ALLOW_MISSING=false ;;
  *)
    printf 'invalid SLEY_ALLOW_MISSING value: %s\n' "$ALLOW_MISSING" >&2
    exit 2
    ;;
esac

record_file() {
  local label="$1"
  local status="$2"
  local state="$3"
  local output_file="$4"
  RESULT_LABELS+=("$label")
  RESULT_STATUSES+=("$status")
  RESULT_STATES+=("$state")
  RESULT_FILES+=("$output_file")
}

record_text() {
  local label="$1"
  local status="$2"
  local state="$3"
  local message="$4"
  local output_file="$REPORT_DIR/result-${#RESULT_LABELS[@]}.log"
  printf '%s' "$message" >"$output_file"
  record_file "$label" "$status" "$state" "$output_file"
  if [[ "$OUTPUT_JSON" != "1" && -n "$message" ]]; then
    printf '%s\n' "$message" >&2
  fi
}

run_command() {
  local label="$1"
  shift
  local output_file="$REPORT_DIR/result-${#RESULT_LABELS[@]}.log"
  local status state
  "$@" >"$output_file" 2>&1
  status=$?
  if [[ "$status" -eq 0 ]]; then
    state=passed
  else
    state=failed
  fi
  record_file "$label" "$status" "$state" "$output_file"
  if [[ "$OUTPUT_JSON" != "1" ]]; then
    cat "$output_file"
  fi
  return "$status"
}

record_missing() {
  local label="$1"
  local executable="$2"
  if [[ "$ALLOW_MISSING" == true ]]; then
    record_text "$label" 0 skipped "required executable unavailable (explicitly allowed): $executable"
    return 0
  fi
  record_text "$label" 127 unavailable "required executable unavailable: $executable"
  return 127
}

require_executable() {
  local label="$1"
  local executable="$2"
  if command -v "$executable" >/dev/null 2>&1; then
    return 0
  fi
  record_missing "$label" "$executable"
}

update_final_status() {
  local candidate="$1"
  if [[ "$candidate" -ne 0 && "$FINAL_STATUS" -eq 0 ]]; then
    FINAL_STATUS="$candidate"
  fi
}

run_sley() {
  local label="$1"
  shift
  run_command "$label" "$SLEY_BIN" "$@"
}

emit_report() {
  local -a report_args=(--command "$CMD" --status "$FINAL_STATUS")
  local index
  if [[ "$OUTPUT_JSON" != "1" ]]; then
    return
  fi
  for index in "${!RESULT_LABELS[@]}"; do
    report_args+=(
      --result
      "${RESULT_LABELS[$index]}"
      "${RESULT_STATUSES[$index]}"
      "${RESULT_STATES[$index]}"
      "${RESULT_FILES[$index]}"
    )
  done
  node "$REPORTER" "${report_args[@]}"
}

FINAL_STATUS=0

case "$CMD" in
  check)
    if ! command -v "$SLEY_BIN" >/dev/null 2>&1; then
      record_missing check "$SLEY_BIN"
      update_final_status "$?"
    else
      target="${1:-.}"
      run_sley format format "$target"; update_final_status "$?"
      run_sley check check --json "$target"; update_final_status "$?"
      run_sley lint lint --json --deny-warnings "$target"; update_final_status "$?"
    fi
    ;;
  verify)
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" || "${1:-}" == "help" ]]; then
      usage
    elif ! command -v "$SLEY_BIN" >/dev/null 2>&1; then
      record_missing verify "$SLEY_BIN"
      update_final_status "$?"
    else
      run_sley verify verify "$@"; update_final_status "$?"
    fi
    ;;
  smoke)
    manifest="${1:-fixtures/cli_smokes/manifest.json}"
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" || "${1:-}" == "help" ]]; then
      usage
    elif ! command -v "$SLEY_BIN" >/dev/null 2>&1; then
      record_missing smoke "$SLEY_BIN"
      update_final_status "$?"
    elif ! command -v "$JQ_BIN" >/dev/null 2>&1; then
      record_missing smoke-manifest "$JQ_BIN"
      update_final_status "$?"
    elif [[ ! -f "$manifest" ]]; then
      record_text smoke-manifest 2 failed "smoke manifest not found: $manifest"
      update_final_status 2
    else
      run_command smoke-manifest "$JQ_BIN" -e . "$manifest"; update_final_status "$?"
      if [[ "$FINAL_STATUS" -eq 0 ]]; then
        target="${manifest%/*}"
        if [[ "$target" == "$manifest" ]]; then
          target="."
        fi
        run_sley check check --json "$target"; update_final_status "$?"
      fi
    fi
    ;;
  new-deploy-sequence)
    if ! command -v "$SLEY_BIN" >/dev/null 2>&1; then
      record_missing new-deploy-sequence "$SLEY_BIN"
      update_final_status "$?"
    else
      target="${1:-.}"
      run_sley check check --json "$target"; update_final_status "$?"
      run_sley doctor doctor --json "$target"; update_final_status "$?"
      run_sley query query --json --kind tasks "$target"; update_final_status "$?"
      run_sley plan plan --json --graft-templates "$target"; update_final_status "$?"
      run_sley lint lint --json --deny-warnings "$target"; update_final_status "$?"
      run_sley verify verify --json --deny-warnings --cap Deploy --deploy-result staging staged "$target"; update_final_status "$?"
      run_sley run run --json --cap Deploy --deploy-result staging staged "$target"; update_final_status "$?"
      run_sley seal seal --json "$target"; update_final_status "$?"
      run_sley zjx zjx --json "$target"; update_final_status "$?"
    fi
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    record_text usage 2 failed "unknown command: $CMD"
    usage >&2
    FINAL_STATUS=2
    ;;
esac

emit_report
exit "$FINAL_STATUS"
